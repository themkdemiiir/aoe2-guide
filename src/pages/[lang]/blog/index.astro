---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import FilterBar from "@/components/ui/FilterBar.astro";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug } from "@/lib/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;

const CATS = ["fundamentals", "strategy", "counters", "meta", "resources"] as const;
const articles = (await getLocalizedEntries("articles", lang))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const present = CATS.filter((c) => articles.some((a) => a.data.category === c));
const facets = [
  {
    name: "category",
    label: t(lang, "blog.category"),
    options: present.map((c) => ({ value: c, label: t(lang, `blog.cat.${c}`) })),
  },
];
---
<BaseLayout title={t(lang, "blog.title")} description={t(lang, "meta.blog")} canonicalPath="/blog">
  <section class="mx-auto max-w-5xl px-4 py-12" data-filter-root>
    <h1 class="font-display text-4xl text-ink">{t(lang, "blog.title")}</h1>
    <p class="mt-3 max-w-prose text-stone-700">{t(lang, "blog.intro")}</p>
    {articles.length === 0 ? (
      <p class="mt-6 text-stone-700">No articles yet — coming soon.</p>
    ) : (
      <>
        <div class="mt-8">
          <FilterBar
            searchPlaceholder={`${t(lang, "filter.search")}…`}
            facets={facets}
            total={articles.length}
            resultsLabel={t(lang, "filter.results")}
            allLabel={t(lang, "filter.all")}
            resetLabel={t(lang, "filter.reset")}
          />
        </div>
        <ul class="grid auto-rows-fr gap-4 sm:grid-cols-2">
          {articles.map((a) => (
            <li
              class="h-full"
              data-filter-item
              data-search={`${a.data.title} ${a.data.description}`.toLowerCase()}
              data-category={a.data.category}
            >
              <a href={localizedPath(`/blog/${canonicalSlug(a.id)}`, lang)}
                 class="flex h-full flex-col rounded border border-stone-700/40 bg-parchment p-5 transition hover:border-gold-500">
                <Badge variant="outline">{t(lang, `blog.cat.${a.data.category}`)}</Badge>
                <h2 class="mt-3 font-display text-xl text-ink">{a.data.title}</h2>
                <p class="mt-2 text-sm text-stone-700">{a.data.description}</p>
                <span class="mt-auto pt-4 text-sm font-medium text-gold-500">{t(lang, "blog.readMore")} →</span>
              </a>
            </li>
          ))}
        </ul>
        <p data-filter-empty hidden class="mt-8 text-center text-stone-700">{t(lang, "filter.noResults")}</p>
      </>
    )}
  </section>
  <script>import "@/scripts/list-filter.ts";</script>
</BaseLayout>
