---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";

export async function getStaticPaths() {
  const units: CollectionEntry<"units">[] = await getCollection("units");
  return locales.flatMap((lang) => units.map((u) => ({ params: { lang, unit: u.id } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.unit as string;
const entry = (await getCollection("units") as CollectionEntry<"units">[]).find((u) => u.id === slug);
if (!entry) return Astro.redirect("/404");

const stats = (await getEntry("unit-stats", slug))?.data;

const lineRoot = entry.data.line as string | undefined;

interface TierInfo {
  slug: string;
  name: string;
  stats: Record<string, unknown> | undefined;
  isCurrent: boolean;
}

let chainTiers: TierInfo[] = [];

if (lineRoot) {
  const lineDef = (await getEntry("unit-lines", lineRoot))?.data.members ?? [];
  const allUnits: CollectionEntry<"units">[] = await getCollection("units");
  const bySlug = new Map(allUnits.map((u) => [u.id, u]));
  for (const tierSlug of lineDef) {
    const tierEntry = bySlug.get(tierSlug);
    if (!tierEntry) continue;
    const tierStats = (await getEntry("unit-stats", tierSlug))?.data;
    chainTiers.push({
      slug: tierSlug,
      name: tierEntry.data.name[lang],
      stats: tierStats,
      isCurrent: tierSlug === slug,
    });
  }
}
---
<BaseLayout
  title={entry.data.name[lang]}
  description={(entry.data.description?.[lang] ?? `${entry.data.name[lang]} — ${entry.data.role[lang]}`).slice(0, 155)}
  canonicalPath={`/units/${slug}`}
>
  <article class="mx-auto max-w-prose px-4 py-12">
    <header class="flex items-center gap-4">
      <Icon slug={slug} kind="unit" size={96} />
      <div>
        <h1 class="font-display text-4xl text-ink">{entry.data.name[lang]}</h1>
        <p class="text-sm text-stone-700">{entry.data.role[lang]}</p>
      </div>
    </header>

    {chainTiers.length > 1 && (
      <section class="mt-8">
        <h2 class="font-display text-xl text-ink mb-3">{t(lang, "units.upgradeChain")}</h2>
        <div class="flex flex-col gap-2">
          {chainTiers.map((tier, i) => (
            <a
              href={`/${lang}/units/${tier.slug}/`}
              class={[
                "flex items-center gap-3 rounded border p-3 transition-colors",
                tier.isCurrent
                  ? "border-gold-500 bg-gold-500/10 cursor-default"
                  : "border-stone-700/40 bg-parchment hover:border-gold-500",
              ].join(" ")}
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stone-700/20 text-xs font-bold text-stone-700">
                {i + 1}
              </span>
              <Icon slug={tier.slug} kind="unit" size={32} />
              <div class="min-w-0 flex-1">
                <div class={`font-display text-base leading-tight ${tier.isCurrent ? "text-gold-500" : "text-ink"}`}>
                  {tier.name}
                  {tier.isCurrent && <span class="ml-2 text-xs font-normal text-gold-500">({t(lang, "ui.current")})</span>}
                </div>
              </div>
              {tier.stats && (
                <div class="hidden shrink-0 gap-4 text-xs text-stone-700 sm:flex">
                  <span title="HP">❤ {(tier.stats as {hp: number}).hp}</span>
                  <span title="Attack">⚔ {(tier.stats as {attack: number}).attack}</span>
                  {(tier.stats as {range: number}).range > 0 && <span title="Range">⬡ {(tier.stats as {range: number}).range}</span>}
                  <span title="Food" class="text-res-food">{((tier.stats as {cost: {food: number}}).cost?.food ?? 0)}f</span>
                  <span title="Wood" class="text-res-wood">{((tier.stats as {cost: {wood: number}}).cost?.wood ?? 0)}w</span>
                  <span title="Gold" class="text-res-gold">{((tier.stats as {cost: {gold: number}}).cost?.gold ?? 0)}g</span>
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    {stats && (
      <table class="mt-6 w-full text-sm">
        <tbody>
          <tr><th class="text-left text-stone-700">HP</th><td class="text-ink">{stats.hp}</td></tr>
          <tr><th class="text-left text-stone-700">Attack</th><td class="text-ink">{stats.attack}</td></tr>
          <tr><th class="text-left text-stone-700">Range</th><td class="text-ink">{stats.range}</td></tr>
          <tr><th class="text-left text-stone-700">Train time</th><td class="text-ink">{stats.trainTime}s</td></tr>
          <tr>
            <th class="text-left text-stone-700">Cost</th>
            <td class="text-ink">
              <span class="text-res-food">{stats.cost.food}f</span>
              <span class="ml-2 text-res-wood">{stats.cost.wood}w</span>
              <span class="ml-2 text-res-gold">{stats.cost.gold}g</span>
              <span class="ml-2 text-res-stone">{stats.cost.stone}s</span>
            </td>
          </tr>
        </tbody>
      </table>
    )}

    {!stats && (
      <p class="mt-6 rounded border border-stone-700/20 bg-parchment/60 px-4 py-3 text-sm italic text-stone-700">
        {t(lang, "ui.statsPending")}
      </p>
    )}

    {entry.data.description?.[lang] && (
      <section class="prose prose-stone mt-10 max-w-none">
        <p>{entry.data.description[lang]}</p>
      </section>
    )}
  </article>
</BaseLayout>
