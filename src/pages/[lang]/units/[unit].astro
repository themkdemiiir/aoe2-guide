---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import { displayName } from "@/lib/display";
import countersData from "@data/counters.json";
import gameFacts from "@data/game-facts.json";

export async function getStaticPaths() {
  const units: CollectionEntry<"units">[] = await getCollection("units");
  return locales.flatMap((lang) => units.map((u) => ({ params: { lang, unit: u.id } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.unit as string;
const entry = (await getCollection("units") as CollectionEntry<"units">[]).find((u) => u.id === slug);
if (!entry) return Astro.redirect("/404");

const stats = (await getEntry("unit-stats", slug))?.data;

const lineRoot = entry.data.line as string | undefined;

interface TierInfo {
  slug: string;
  name: string;
  stats: Record<string, unknown> | undefined;
  isCurrent: boolean;
}

let chainTiers: TierInfo[] = [];

if (lineRoot) {
  const lineDef = (await getEntry("unit-lines", lineRoot))?.data.members ?? [];
  const allUnits: CollectionEntry<"units">[] = await getCollection("units");
  const bySlug = new Map(allUnits.map((u) => [u.id, u]));
  for (const tierSlug of lineDef) {
    const tierEntry = bySlug.get(tierSlug);
    if (!tierEntry) continue;
    const tierStats = (await getEntry("unit-stats", tierSlug))?.data;
    chainTiers.push({
      slug: tierSlug,
      name: tierEntry.data.name[lang],
      stats: tierStats,
      isCurrent: tierSlug === slug,
    });
  }
}

// --- Counters block: 16 units carry Strong/Weak-vs relations in counters.json. ---
type Loc = string | { en: string; tr: string };
type CounterInfo = { strongVs: string[]; weakVs: string[]; note?: Loc };
const loc = (v: Loc | undefined): string | null =>
  v == null ? null : typeof v === "string" ? v : (v[lang] ?? v.en);
const unitCounters = (countersData.units as Record<string, CounterInfo>)[slug] ?? null;

// Counter chips link to unit pages when one exists (counters.json also names
// units without a page, e.g. eagle-scout); unique units link back to their civ.
const unitPageIds = new Set((await getCollection("units")).map((u) => u.id));
const unitHref = (s: string): string | null => (unitPageIds.has(s) ? `/${lang}/units/${s}/` : null);
const civEntry = entry.data.civ ? await getEntry("civilizations", entry.data.civ) : null;

// Sourced game facts (48 units): availability age, training building, attack
// bonuses. Building names are EN proper nouns on both locales — same policy as
// unit names; no TR building-name source exists to translate from.
type Fact = { age: "dark" | "feudal" | "castle" | "imperial"; building: string; attackBonus: string | null };
const facts = (gameFacts.units as Record<string, Fact>)[slug] ?? null;

// --- Stat-vs-class chart: compare against the average of the unit's ROLE peers,
// but only when the role is a real class — ≥3 units and not the "unique unit"
// catch-all (averaging 41 wildly-different unique units would be meaningless). ---
type StatShape = {
  hp: number;
  attack: number;
  cost: { food: number; wood: number; gold: number; stone: number };
};
const roleEn = entry.data.role.en;
let classChart: { role: string; n: number; hp: [number, number]; attack: [number, number]; gold: [number, number] } | null = null;
if (stats && roleEn !== "unique unit") {
  const peers = (await getCollection("units")).filter((u) => u.data.role.en === roleEn);
  if (peers.length >= 3) {
    const peerStats: StatShape[] = [];
    for (const u of peers) {
      const s = (await getEntry("unit-stats", u.id))?.data as StatShape | undefined;
      if (s) peerStats.push(s);
    }
    const avg = (f: (s: StatShape) => number) => Math.round(peerStats.reduce((n, s) => n + f(s), 0) / peerStats.length);
    const s = stats as unknown as StatShape;
    classChart = {
      role: entry.data.role[lang],
      n: peerStats.length,
      hp: [s.hp, avg((x) => x.hp)],
      attack: [s.attack, avg((x) => x.attack)],
      gold: [s.cost.gold, avg((x) => x.cost.gold)],
    };
  }
}
// Meta description: lead with the unit name for the SERP snippet, then as many
// whole sentences of the sourced in-game text as fit the ~160-char budget.
const helpBody = entry.data.description?.[lang];
const metaLead = t(lang, "units.metaIntro").replace("{name}", entry.data.name[lang]);
let metaDescription = `${entry.data.name[lang]} — ${entry.data.role[lang]}`;
if (helpBody) {
  metaDescription = metaLead;
  // Sentence boundary = period + space, except after the "vs." abbreviation.
  for (const sentence of helpBody.split(/(?<=\.)(?<!\bvs\.)\s+/)) {
    if (`${metaDescription} ${sentence}`.length > 160) break;
    metaDescription += ` ${sentence}`;
  }
  if (metaDescription === metaLead) metaDescription = `${metaLead} ${helpBody}`.slice(0, 157);
}
---
<BaseLayout
  title={`${entry.data.name[lang]} — ${t(lang, "units.seoTitle")}`}
  breadcrumbName={entry.data.name[lang]}
  description={metaDescription}
  canonicalPath={`/units/${slug}`}
>
  <article class="mx-auto max-w-prose px-4 py-12">
    <header class="flex items-center gap-4">
      <Icon slug={slug} kind="unit" size={96} />
      <div>
        <h1 class="font-display text-4xl text-ink">{entry.data.name[lang]}</h1>
        <p class="text-sm text-stone-700">{entry.data.role[lang]}</p>
        {civEntry && (
          <p class="mt-0.5 text-sm">
            <a href={`/${lang}/civs/${entry.data.civ}/`} class="text-gold-700 transition-colors hover:text-gold-500">
              {t(lang, "units.uniqueOf").replace("{civ}", civEntry.data.name[lang])}
            </a>
          </p>
        )}
      </div>
    </header>

    {helpBody && <p class="mt-6 text-stone-700">{helpBody}</p>}

    {chainTiers.length > 1 && (
      <section class="mt-8">
        <h2 class="font-display text-xl text-ink mb-3">{t(lang, "units.upgradeChain")}</h2>
        <div class="flex flex-col gap-2">
          {chainTiers.map((tier, i) => (
            <a
              href={`/${lang}/units/${tier.slug}/`}
              class={[
                "flex items-center gap-3 rounded border p-3 transition-colors",
                tier.isCurrent
                  ? "border-gold-500 bg-gold-500/10 cursor-default"
                  : "border-stone-700/40 bg-parchment hover:border-gold-500",
              ].join(" ")}
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stone-700/20 text-xs font-bold text-stone-700">
                {i + 1}
              </span>
              <Icon slug={tier.slug} kind="unit" size={32} />
              <div class="min-w-0 flex-1">
                <div class={`font-display text-base leading-tight ${tier.isCurrent ? "text-gold-700" : "text-ink"}`}>
                  {tier.name}
                  {tier.isCurrent && <span class="ml-2 text-xs font-normal text-gold-700">({t(lang, "ui.current")})</span>}
                </div>
              </div>
              {tier.stats && (
                <div class="hidden shrink-0 gap-4 text-xs text-stone-700 sm:flex">
                  <span title="HP">❤ {(tier.stats as {hp: number}).hp}</span>
                  <span title="Attack">⚔ {(tier.stats as {attack: number}).attack}</span>
                  {(tier.stats as {range: number}).range > 0 && <span title="Range">⬡ {(tier.stats as {range: number}).range}</span>}
                  {((tier.stats as {cost: {food: number}}).cost?.food ?? 0) > 0 && <span title="Food" class="text-res-food">{(tier.stats as {cost: {food: number}}).cost.food}f</span>}
                  {((tier.stats as {cost: {wood: number}}).cost?.wood ?? 0) > 0 && <span title="Wood" class="text-res-wood">{(tier.stats as {cost: {wood: number}}).cost.wood}w</span>}
                  {((tier.stats as {cost: {gold: number}}).cost?.gold ?? 0) > 0 && <span title="Gold" class="text-res-gold">{(tier.stats as {cost: {gold: number}}).cost.gold}g</span>}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    {stats && (
      <>
      <h2 class="mt-8 mb-2 font-display text-xl text-ink">{t(lang, "units.stats")}</h2>
      <table class="w-full text-sm">
        <tbody>
          <tr><th class="text-left text-stone-700">{t(lang, "units.hp")}</th><td class="text-right font-mono tabular-nums text-ink">{stats.hp}</td></tr>
          <tr><th class="text-left text-stone-700">{t(lang, "units.attack")}</th><td class="text-right font-mono tabular-nums text-ink">{stats.attack}</td></tr>
          <tr><th class="text-left text-stone-700">{t(lang, "units.range")}</th><td class="text-right font-mono tabular-nums text-ink">{stats.range}</td></tr>
          {(stats.armorMelee !== undefined || stats.armorPiercing !== undefined) && (
            <tr><th class="text-left text-stone-700">{t(lang, "units.armor")}</th><td class="text-right font-mono tabular-nums text-ink">{stats.armorMelee ?? 0}/{stats.armorPiercing ?? 0}</td></tr>
          )}
          <tr><th class="text-left text-stone-700">{t(lang, "units.trainTime")}</th><td class="text-right font-mono tabular-nums text-ink">{stats.trainTime}s</td></tr>
          {facts && (
            <tr><th class="text-left text-stone-700">{t(lang, "builds.ageLabel")}</th><td class="text-right text-ink">{t(lang, `age.${facts.age}`)}</td></tr>
          )}
          {facts && (
            <tr><th class="text-left text-stone-700">{t(lang, "units.trainedAt")}</th><td class="text-right text-ink">{facts.building}</td></tr>
          )}
          {facts?.attackBonus && (
            <tr><th class="text-left text-stone-700">{t(lang, "units.attackBonus")}</th><td class="text-right font-mono tabular-nums text-ink">{facts.attackBonus.split(";").join(", ")}</td></tr>
          )}
          <tr>
            <th class="text-left text-stone-700">{t(lang, "units.cost")}</th>
            <td class="text-right font-mono tabular-nums text-ink">
              <span class="inline-flex justify-end gap-2">
                {stats.cost.food > 0 && <span class="text-res-food">{stats.cost.food}f</span>}
                {stats.cost.wood > 0 && <span class="text-res-wood">{stats.cost.wood}w</span>}
                {stats.cost.gold > 0 && <span class="text-res-gold">{stats.cost.gold}g</span>}
                {stats.cost.stone > 0 && <span class="text-res-stone">{stats.cost.stone}s</span>}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
      </>
    )}

    {entry.data.upgrades?.[lang] && (
      <section class="mt-8">
        <h2 class="mb-2 font-display text-xl text-ink">{t(lang, "units.upgrades")}</h2>
        <p class="text-sm text-stone-700">{entry.data.upgrades[lang]}</p>
      </section>
    )}

    {classChart && (
      <section class="mt-8">
        <h2 class="mb-1 font-display text-xl text-ink">{t(lang, "units.statVsClass")}</h2>
        <p class="mb-3 font-mono text-[11px] uppercase tracking-wide text-stone-700/70">{classChart.role} · {classChart.n}</p>
        <div class="space-y-3">
          {([["units.hp", classChart.hp], ["units.attack", classChart.attack], ["res.gold", classChart.gold]] as const).map(([label, pair]) => {
            const [mine, avg] = pair;
            const max = Math.max(mine, avg, 1);
            return (
              <div class="flex items-center gap-3 text-sm">
                <span class="w-16 flex-none text-stone-700">{t(lang, label)}</span>
                <div class="min-w-0 flex-1 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-stone-700/10"><span class="absolute inset-y-0 left-0 rounded-full bg-gold-500" style={`width:${(mine / max) * 100}%`}></span></span>
                    <span class="w-9 flex-none text-right font-mono tabular-nums text-ink">{mine}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-stone-700/10"><span class="absolute inset-y-0 left-0 rounded-full bg-stone-700/40" style={`width:${(avg / max) * 100}%`}></span></span>
                    <span class="w-9 flex-none text-right font-mono tabular-nums text-stone-700/70">{avg}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        <p class="mt-2.5 flex gap-4 font-mono text-[10px] uppercase tracking-wide text-stone-700/70">
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-gold-500"></span>{t(lang, "units.thisUnit")}</span>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-stone-700/40"></span>{t(lang, "units.classAvg")}</span>
        </p>
      </section>
    )}

    {unitCounters && (
      <section class="mt-8">
        <h2 class="mb-3 font-display text-xl text-ink">{t(lang, "units.counters")}</h2>
        <div class="space-y-3">
          {unitCounters.strongVs.length > 0 && (
            <div>
              <span class="text-xs font-bold uppercase tracking-wide text-forest">{t(lang, "counters.strongVs")}</span>
              <div class="mt-1.5 flex flex-wrap gap-2">
                {unitCounters.strongVs.map((u) => {
                  const ChipEl = unitHref(u) ? "a" : "span";
                  return (
                    <ChipEl href={unitHref(u) ?? undefined} class={`inline-flex items-center gap-1.5 rounded border border-forest/30 bg-forest/10 px-2 py-1 text-sm text-ink${unitHref(u) ? " transition-colors hover:border-forest/60 hover:text-gold-700" : ""}`}>
                      <Icon slug={u} kind="unit" size={20} framed={false} /> {displayName(u)}
                    </ChipEl>
                  );
                })}
              </div>
            </div>
          )}
          {unitCounters.weakVs.length > 0 && (
            <div>
              <span class="text-xs font-bold uppercase tracking-wide text-royal">{t(lang, "counters.weakVs")}</span>
              <div class="mt-1.5 flex flex-wrap gap-2">
                {unitCounters.weakVs.map((u) => {
                  const ChipEl = unitHref(u) ? "a" : "span";
                  return (
                    <ChipEl href={unitHref(u) ?? undefined} class={`inline-flex items-center gap-1.5 rounded border border-royal/30 bg-royal/10 px-2 py-1 text-sm text-ink${unitHref(u) ? " transition-colors hover:border-royal/60 hover:text-gold-700" : ""}`}>
                      <Icon slug={u} kind="unit" size={20} framed={false} /> {displayName(u)}
                    </ChipEl>
                  );
                })}
              </div>
            </div>
          )}
          {loc(unitCounters.note) && <p class="text-sm text-stone-700">{loc(unitCounters.note)}</p>}
        </div>
      </section>
    )}

    {!stats && (
      <p class="mt-6 rounded border border-stone-700/20 bg-parchment/60 px-4 py-3 text-sm italic text-stone-700">
        {t(lang, "ui.statsPending")}
      </p>
    )}

  </article>
</BaseLayout>
