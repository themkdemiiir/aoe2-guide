---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import FilterBar from "@/components/ui/FilterBar.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const allUnits: CollectionEntry<"units">[] = await getCollection("units");

// Build a slug -> entry map for quick lookup
const bySlug = new Map(allUnits.map((u) => [u.id, u]));

// Build one "line card" per line.  A line is included only when at least
// one of its members exists in the content directory.
interface LineCard {
  lineRoot: string;
  baseTierSlug: string; // slug of the first existing tier — the link target
  baseTierName: string; // display name of that tier
  role: string;
  memberSlugs: string[]; // all existing tier slugs in order
}

const lineCards: LineCard[] = [];
const allLines = await getCollection("unit-lines");

for (const line of allLines) {
  const existingMembers = line.data.members.filter((m) => bySlug.has(m));
  if (existingMembers.length === 0) continue;

  const baseTierSlug = existingMembers[0];
  const baseEntry = bySlug.get(baseTierSlug)!;

  lineCards.push({
    lineRoot: line.data.slug,
    baseTierSlug,
    baseTierName: baseEntry.data.name[lang],
    role: baseEntry.data.role[lang],
    memberSlugs: existingMembers,
  });
}

// Sort: single-member lines at the end, multi-member by base name
lineCards.sort((a, b) => {
  const aMulti = a.memberSlugs.length > 1 ? 0 : 1;
  const bMulti = b.memberSlugs.length > 1 ? 0 : 1;
  if (aMulti !== bMulti) return aMulti - bMulti;
  return a.baseTierName.localeCompare(b.baseTierName);
});

function lineDisplayName(card: LineCard): string {
  if (card.memberSlugs.length === 1) return card.baseTierName;
  return `${card.baseTierName} ${t(lang, "units.lineSuffix")}`;
}

// Role facet — slugify so multi-word roles (e.g. "heavy cavalry") match cleanly.
const roleSlug = (role: string) => role.toLowerCase().replace(/\s+/g, "-");
const roleMap = new Map<string, string>();
for (const c of lineCards) if (!roleMap.has(roleSlug(c.role))) roleMap.set(roleSlug(c.role), c.role);
const facets = [
  {
    name: "role",
    label: t(lang, "filter.role"),
    options: [...roleMap]
      .map(([value, label]) => ({ value, label }))
      .sort((a, b) => a.label.localeCompare(b.label)),
  },
];

// Abbreviated tier names for the chain pills (max 4 shown). Bilingual so TR
// pages don't show English abbreviations.
const abbreviations: Record<string, { en: string; tr: string }> = {
  militia: { en: "Militia", tr: "Milis" },
  "man-at-arms": { en: "MAA", tr: "MAA" },
  "long-swordsman": { en: "Long Sword", tr: "Uzun Kılıç" },
  "two-handed-swordsman": { en: "2H Sword", tr: "2E Kılıç" },
  champion: { en: "Champ", tr: "Şampiyon" },
  spearman: { en: "Spear", tr: "Mızrakçı" },
  pikeman: { en: "Pike", tr: "Pikeci" },
  halberdier: { en: "Halbs", tr: "Baltalı" },
  "eagle-scout": { en: "Scout", tr: "K. İzci" },
  "eagle-warrior": { en: "EW", tr: "K. Savaşçı" },
  "elite-eagle-warrior": { en: "Elite EW", tr: "Elit K.S." },
  archer: { en: "Archer", tr: "Okçu" },
  crossbowman: { en: "Xbow", tr: "Yaylı" },
  arbalester: { en: "Arb", tr: "Arbalet" },
  skirmisher: { en: "Skirmisher", tr: "Avcı" },
  "elite-skirmisher": { en: "Elite Skirm", tr: "Elit Avcı" },
  "scout-cavalry": { en: "Scout", tr: "Keşif" },
  "light-cavalry": { en: "LC", tr: "Hafif Süv." },
  hussar: { en: "Hussar", tr: "Hüsar" },
  knight: { en: "Knight", tr: "Şövalye" },
  cavalier: { en: "Cavalier", tr: "Kavalye" },
  paladin: { en: "Paladin", tr: "Paladin" },
  "camel-rider": { en: "Camel", tr: "Deve" },
  "heavy-camel-rider": { en: "HCamel", tr: "Ağır Deve" },
  "cavalry-archer": { en: "CA", tr: "Atlı Okçu" },
  "heavy-cavalry-archer": { en: "HCA", tr: "Ağır AO" },
  "battering-ram": { en: "Ram", tr: "Koçbaşı" },
  "capped-ram": { en: "Capped", tr: "Kapaklı Koç" },
  "siege-ram": { en: "Siege", tr: "Kuşatma Koçu" },
  mangonel: { en: "Mango", tr: "Mancınık" },
  onager: { en: "Onager", tr: "Onager" },
  "siege-onager": { en: "SO", tr: "Kuşatma On." },
  scorpion: { en: "Scorpion", tr: "Akrep" },
  "heavy-scorpion": { en: "HSCorpion", tr: "Ağır Akrep" },
  galley: { en: "Galley", tr: "Kadırga" },
  "war-galley": { en: "War G", tr: "Savaş K." },
  galleon: { en: "Galleon", tr: "Kalyon" },
  "fire-ship": { en: "Fire", tr: "Ateş G." },
  "fast-fire-ship": { en: "Fast Fire", tr: "Hızlı Ateş" },
  "demolition-ship": { en: "Demo", tr: "Yıkım G." },
  "heavy-demolition-ship": { en: "H Demo", tr: "Ağır Yıkım" },
  "cannon-galleon": { en: "Cannon G", tr: "Toplu K." },
  "elite-cannon-galleon": { en: "Elite", tr: "Elit" },
};

function tierAbbr(slug: string): string {
  const abbr = abbreviations[slug];
  if (abbr) return abbr[lang];
  // Fall back to the localized unit name, not the English slug.
  return bySlug.get(slug)?.data.name[lang] ?? slug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---
<BaseLayout title={t(lang, "title.units")} description={t(lang, "meta.units")} canonicalPath="/units">
  <section class="mx-auto max-w-7xl px-4 py-12" data-filter-root>
    <h1 class="mb-6 font-display text-4xl text-ink">{t(lang, "nav.units")}</h1>
    {lineCards.length === 0 ? (
      <p class="mt-6 text-stone-700">{t(lang, "ui.emptyComingSoon")}</p>
    ) : (
      <>
        <FilterBar
          searchPlaceholder={`${t(lang, "filter.search")}…`}
          facets={facets}
          total={lineCards.length}
          resultsLabel={t(lang, "filter.results")}
          allLabel={t(lang, "filter.all")}
          resetLabel={t(lang, "filter.reset")}
        />
        <ul class="grid auto-rows-fr gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {lineCards.map((card) => (
            <li
              class="h-full"
              data-filter-item
              data-search={`${lineDisplayName(card)} ${card.role} ${card.memberSlugs.join(" ")}`.toLowerCase()}
              data-role={roleSlug(card.role)}
            >
              <a href={localizedPath(`/units/${card.baseTierSlug}`, lang)}
                 class="flex h-full flex-col gap-2 rounded border border-stone-700/40 bg-parchment p-3 hover:border-gold-500">
                <div class="flex items-center gap-3">
                  <Icon slug={card.baseTierSlug} kind="unit" size={40} />
                  <div class="min-w-0 flex-1">
                    <div class="font-display text-lg text-ink leading-tight">{lineDisplayName(card)}</div>
                    <div class="text-xs capitalize text-stone-700">{card.role}</div>
                  </div>
                </div>
                {card.memberSlugs.length > 1 && (
                  <div class="flex flex-wrap gap-1 pt-0.5">
                    {card.memberSlugs.slice(0, 4).map((s) => (
                      <span class="inline-flex items-center gap-1 rounded bg-stone-700/10 px-1.5 py-0.5 text-xs text-stone-700">
                        <Icon slug={s} kind="unit" size={14} framed={false} />
                        {tierAbbr(s)}
                      </span>
                    ))}
                    {card.memberSlugs.length > 4 && (
                      <span class="rounded bg-stone-700/10 px-1.5 py-0.5 text-xs text-stone-700">
                        +{card.memberSlugs.length - 4}
                      </span>
                    )}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
        <p data-filter-empty hidden class="mt-8 text-center text-stone-700">{t(lang, "filter.noResults")}</p>
      </>
    )}
  </section>
  <script>import "@/scripts/list-filter.ts";</script>
</BaseLayout>
