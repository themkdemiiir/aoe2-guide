---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { render } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug, getLocalizedEntry } from "@/lib/content";

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; matchup: string } }> = [];
  for (const lang of locales) {
    const matchups = await getLocalizedEntries("matchups", lang);
    for (const m of matchups) paths.push({ params: { lang, matchup: canonicalSlug(m.id) } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.matchup as string;
const found = await getLocalizedEntry("matchups", slug, lang);
if (!found) return Astro.redirect("/404");
const { entry, fallback } = found;
const { Content } = await render(entry);
---
<BaseLayout title={`${entry.data.civA} vs ${entry.data.civB}`} canonicalPath={`/matchups/${slug}`}>
  <article class="mx-auto max-w-prose px-4 py-12">
    {fallback && (
      <div class="mb-6 rounded border border-royal/40 bg-royal/10 px-3 py-2 text-sm text-royal">
        {t(lang, "ui.translation.missing")}
      </div>
    )}
    <header class="flex items-center gap-4">
      <Icon slug={entry.data.civA} kind="civ" size={56} />
      <span class="font-display text-2xl text-stone-700">vs</span>
      <Icon slug={entry.data.civB} kind="civ" size={56} />
      <span class="ml-4 rounded border border-stone-700/30 px-2 py-0.5 text-sm text-stone-700">{entry.data.difficulty}</span>
    </header>
    <section class="prose prose-stone mt-8 max-w-none"><Content /></section>
  </article>
</BaseLayout>
