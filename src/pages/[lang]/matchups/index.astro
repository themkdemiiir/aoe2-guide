---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getCollection } from "astro:content";
import iconMap from "@data/icon-map.json";
import byEloData from "@data/civ-matchups-by-elo.json";
import byMapData from "@data/civ-matchups-by-map.json";
import mapMetaData from "@data/map-meta.json";
import civMeta from "@data/civ-meta.json";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import { displayName } from "@/lib/display";
import { TIER_COLORS } from "@/lib/tiers";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;

// Sort civs alphabetically by slug for the dropdowns.
// Bonuses / team bonus / unique-tech text come from the LOCALIZED `civilizations`
// collection so TR pages show Turkish sentences (not English). civ-data only
// supplies the language-agnostic bits: region, specialty and unique-unit slugs.
const civDataBySlug = new Map((await getCollection("civ-data")).map((e) => [e.data.slug, e.data]));
const civs = (await getCollection("civilizations"))
  .map((entry) => {
    const d = entry.data;
    const meta = civDataBySlug.get(entry.id);
    return {
      slug: entry.id,
      region: meta?.region ?? "",
      specialty: meta?.specialty ?? "",
      uniqueUnits: meta?.uniqueUnits ?? [],
      civBonuses: d.bonuses[lang],
      teamBonus: d.teamBonus[lang],
      uniqueTechs: {
        castle: { name: d.uniqueTechs.castle.name[lang], effect: d.uniqueTechs.castle.effect[lang] },
        imperial: { name: d.uniqueTechs.imperial.name[lang], effect: d.uniqueTechs.imperial.effect[lang] },
      },
    };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));

const civIcons = (iconMap as any).civs ?? {};
const unitIcons = (iconMap as any).units ?? {};

// Localized UI labels — passed to client JS via define:vars.
const labels = {
  civBonuses:  t(lang, "matchups.civBonuses"),
  teamBonus:   t(lang, "matchups.teamBonus"),
  uniqueUnits: t(lang, "matchups.uniqueUnits"),
  uniqueTechs: t(lang, "matchups.uniqueTechs"),
  meta:        t(lang, "matchups.meta"),
  winRate:     t(lang, "matchups.winRate"),
  playRate:    t(lang, "matchups.playRate"),
  tier:        t(lang, "matchups.tier"),
  noMeta:      t(lang, "matchups.noMeta"),
  castleAge:   t(lang, "matchups.castleAge"),
  imperialAge: t(lang, "matchups.imperialAge"),
};

// Display names precomputed server-side (canonical prettifier in
// src/lib/display.ts) so the is:inline script below needs no local copy.
// Covers every slug the client renders: civs + their unique units.
const displayNames = Object.fromEntries(
  [...civs.map((c) => c.slug), ...civs.flatMap((c) => c.uniqueUnits ?? [])].map((s) => [s, displayName(s)]),
);

// Head-to-head by elo bucket: h2hElo[a][b] = { bucketIdx: [winRate, games] } where
// bucketIdx indexes ELO_BUCKETS (["all", "<1000", …]). Lets the comparator filter
// the verdict by elo. Real per-civ meta also goes to the client.
type MM = { opp: string; games: number; winRate: number };
const ELO_BUCKETS = (byEloData.eloBuckets as string[]) ?? ["all"];
const eloIdx = Object.fromEntries(ELO_BUCKETS.map((b, i) => [b, i]));
const byEloCivs = byEloData.civs as unknown as Record<string, Record<string, Record<string, [number, number]>>>;
const h2hElo: Record<string, Record<string, Record<number, number | [number, number]>>> = {};
for (const [civ, opps] of Object.entries(byEloCivs)) {
  h2hElo[civ] = {};
  for (const [opp, slice] of Object.entries(opps)) {
    // "all" keeps [winRate, games] for the headline; elo buckets keep just the
    // win rate to keep the inline payload small.
    const enc: Record<number, number | [number, number]> = {};
    for (const [b, v] of Object.entries(slice)) {
      const i = eloIdx[b];
      enc[i] = i === 0 ? [Math.round(v[0] * 10) / 10, v[1]] : Math.round(v[0] * 10) / 10;
    }
    h2hElo[civ][opp] = enc;
  }
}
type Ladder = { tier: string; winRate: number; playRate: number } | null;
const civMetaLite: Record<string, { tier: string | null; winRate: number | null; playRate: number | null; teamTier: string | null; teamWinRate: number | null }> = {};
for (const [slug, m] of Object.entries(civMeta.civs as Record<string, { "1v1": Ladder; team: Ladder }>)) {
  civMetaLite[slug] = {
    tier: m["1v1"]?.tier ?? null,
    winRate: m["1v1"]?.winRate ?? null,
    playRate: m["1v1"]?.playRate ?? null,
    teamTier: m.team?.tier ?? null,
    teamWinRate: m.team?.winRate ?? null,
  };
}

// Per-pair-per-map: a's win rate vs b on each of the most-played maps. Encoded
// with map indices (into mapNames) to keep the inline payload compact.
const COMMON_MAPS = Object.entries(mapMetaData.maps as Record<string, { games: { "1v1": number } }>)
  .map(([k, v]) => [k, v.games["1v1"] ?? 0] as [string, number])
  .sort((a, b) => b[1] - a[1])
  .slice(0, 15)
  .map(([k]) => k);
const mapIdx = Object.fromEntries(COMMON_MAPS.map((m, i) => [m, i]));
const mapNames = COMMON_MAPS.map((m) => displayName(m));
const pm: Record<string, Record<string, Record<number, number>>> = {};
for (const [a, maps] of Object.entries(byMapData.civs as Record<string, Record<string, MM[]>>)) {
  for (const [map, arr] of Object.entries(maps)) {
    const idx = mapIdx[map];
    if (idx === undefined) continue;
    for (const m of arr) ((pm[a] ??= {})[m.opp] ??= {})[idx] = Math.round(m.winRate);
  }
}

const h2hLabels = {
  favored: lang === "tr" ? "favori" : "favored",
  even: lang === "tr" ? "başa baş" : "even",
  games: lang === "tr" ? "maç" : "games",
  noData: lang === "tr" ? "Bu eşleşme için yeterli veri yok." : "Not enough data for this matchup.",
  team: lang === "tr" ? "Takım" : "Team",
  byMap: lang === "tr" ? "Haritaya göre (en iyi → en kötü)" : "By map (best → worst)",
  unknownCiv: lang === "tr" ? "Bilinmeyen uygarlık: " : "Unknown civ: ",
};

// --- Server-rendered default pair (britons vs franks) so the comparator and
// head-to-head banner are non-blank without JS. The inline script re-renders the
// identical markup on load and layers selection interactivity on top. These are
// TS ports of the panel()/h2hBanner() helpers below — kept in sync with them. ---
const escSSR = (s: unknown) =>
  String(s).replace(/[&<>"']/g, (ch) => {
    const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
    return map[ch] ?? ch;
  });
const byslugSSR: Record<string, (typeof civs)[number]> = Object.fromEntries(civs.map((c) => [c.slug, c]));
const displayNameSSR = (slug: string) => displayNames[slug] ?? slug;
const fmtSSR = (n: number | null | undefined, suffix: string) => (typeof n === "number" ? n.toFixed(1) + suffix : "—");
const tierColorMap = TIER_COLORS as Record<string, string>;
const tierBadgeSSR = (tier: string | null) =>
  !tier
    ? '<span class="text-stone-700">—</span>'
    : '<span class="inline-flex h-6 w-6 items-center justify-center rounded font-display text-sm font-bold text-parchment" style="background:'
        + (tierColorMap[tier] || tierColorMap.D) + '">' + escSSR(tier) + '</span>';

const panelSSR = (slug: string): string => {
  const c = byslugSSR[slug];
  if (!c) return '<div class="rounded border border-royal/40 p-4 text-royal">' + h2hLabels.unknownCiv + escSSR(slug) + '</div>';
  const icon = civIcons[slug];
  const meta = civMetaLite[slug];
  const bonusesHtml = (c.civBonuses || []).map((b) => '<li>' + escSSR(b) + '</li>').join('');
  const uniqueUnitsHtml = (c.uniqueUnits || []).map((uslug) => {
    const uIcon = unitIcons[uslug];
    return '<li class="flex items-center gap-2">'
      + (uIcon ? '<img src="' + escSSR(uIcon) + '" alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6"/>' : '')
      + '<span>' + escSSR(displayNameSSR(uslug)) + '</span></li>';
  }).join('');
  const techsHtml = c.uniqueTechs
    ? '<li><strong>' + escSSR(c.uniqueTechs.castle?.name || '—') + '</strong> (' + labels.castleAge + ') — '
        + escSSR(c.uniqueTechs.castle?.effect || '—') + '</li>'
      + '<li><strong>' + escSSR(c.uniqueTechs.imperial?.name || '—') + '</strong> (' + labels.imperialAge + ') — '
        + escSSR(c.uniqueTechs.imperial?.effect || '—') + '</li>'
    : '<li>—</li>';
  const metaRow = (key: string, tier: string | null, wr: number | null) =>
    '<div class="flex items-center gap-3 text-sm">'
    + '<span class="w-10 font-mono text-[11px] uppercase tracking-wide text-stone-700">' + key + '</span>'
    + tierBadgeSSR(tier)
    + '<span class="font-mono text-ink">' + fmtSSR(wr, '%') + '</span></div>';
  const metaHtml = meta && meta.tier
    ? '<div class="mt-3 space-y-1">' + metaRow("1v1", meta.tier, meta.winRate) + metaRow(h2hLabels.team, meta.teamTier, meta.teamWinRate) + '</div>'
    : '<p class="mt-3 text-sm italic text-stone-700">' + labels.noMeta + '</p>';
  return ''
    + '<article class="rounded border border-stone-700/40 bg-parchment p-3">'
    + '  <header class="flex items-center gap-3">'
    + (icon ? '    <img src="' + escSSR(icon) + '" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-12 w-12 rounded border border-stone-700/40"/>' : '')
    + '    <div>'
    + '      <h2 class="font-display text-xl text-ink">' + escSSR(displayNameSSR(slug)) + '</h2>'
    + '      <p class="text-sm text-stone-700">' + escSSR(c.region || '') + ' · ' + escSSR(c.specialty || '') + '</p>'
    + '    </div>'
    + '  </header>'
    + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.meta + '</h3>' + metaHtml + '</section>'
    + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.civBonuses + '</h3><ul class="mt-1 list-inside list-disc space-y-1 text-sm text-ink">' + bonusesHtml + '</ul></section>'
    + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.teamBonus + '</h3><p class="mt-1 text-sm text-ink">' + escSSR(c.teamBonus || '—') + '</p></section>'
    + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueUnits + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + uniqueUnitsHtml + '</ul></section>'
    + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueTechs + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + techsHtml + '</ul></section>'
    + '</article>';
};

const crownSSR = (kind: string) => {
  const color = kind === "gold" ? "#d9a93a" : "#b9bcc4";
  return '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="display:block">'
    + '<path fill="' + color + '" d="M5 17 3 7l5.5 4L12 5l3.5 6L21 7l-2 10z"/>'
    + '<rect x="5" y="18" width="14" height="2" fill="' + color + '"/></svg>';
};
const civHeadSSR = (icon: string | undefined, kind: string, size: number) =>
  '<div class="flex flex-col items-center gap-1">' + crownSSR(kind)
  + (icon ? '<img src="' + escSSR(icon) + '" alt="" width="' + size + '" height="' + size + '" class="rounded border border-stone-700/30"/>' : '')
  + '</div>';
const perMapHtmlSSR = (a: string, b: string) => {
  const data = (pm[a] && pm[a][b]) || null;
  if (!data) return '';
  const entries = Object.keys(data)
    .map((i) => [mapNames[Number(i)], data[Number(i)]] as [string, number])
    .sort((x, y) => y[1] - x[1]);
  if (!entries.length) return '';
  return '<div class="mt-4 border-t border-stone-700/15 pt-3">'
    + '<h3 class="mb-2 font-mono text-[10px] uppercase tracking-wide text-stone-700">' + h2hLabels.byMap + '</h3>'
    + '<div class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">'
    + entries.map((e) =>
        '<div class="flex items-center justify-between gap-2 text-sm">'
        + '<span class="truncate text-ink">' + escSSR(e[0]) + '</span>'
        + '<span class="font-mono font-medium" style="color:' + (e[1] >= 50 ? 'var(--color-fav)' : 'var(--color-wr-bad)') + '">' + e[1] + '%</span>'
        + '</div>',
      ).join('')
    + '</div></div>';
};
const h2hBannerSSR = (a: string, b: string, eIdx: number): string => {
  if (a === b) return '';
  const slice = h2hElo[a] && h2hElo[a][b];
  const rec = slice ? slice[eIdx] : null;
  if (rec == null) {
    return '<div class="rounded border border-stone-700/30 bg-parchment p-4">'
      + '<p class="text-sm italic text-stone-700">' + h2hLabels.noData + '</p></div>';
  }
  const wr = Array.isArray(rec) ? rec[0] : rec;
  const games = Array.isArray(rec) ? rec[1] : null;
  const fav = wr >= 52 ? displayNameSSR(a) : wr <= 48 ? displayNameSSR(b) : null;
  const favHtml = fav
    ? '<span class="font-semibold" style="color:var(--color-fav)">' + escSSR(fav) + '</span> ' + h2hLabels.favored
    : '<span class="font-semibold">' + h2hLabels.even + '</span>';
  const iconA = civIcons[a], iconB = civIcons[b];
  const fill = Math.max(4, Math.min(96, wr));
  const aCrown = wr >= 52 ? "gold" : "silver";
  const bCrown = wr <= 48 ? "gold" : "silver";
  return ''
    + '<div class="rounded border border-stone-700/30 bg-parchment p-4">'
    + '<div class="flex items-center justify-center gap-5">'
    + civHeadSSR(iconA, aCrown, 48)
    + '<div class="text-center">'
    + '<div class="font-display text-3xl text-ink">' + wr.toFixed(1) + '%'
    + ' <span class="text-lg text-stone-700/60">vs ' + (100 - wr).toFixed(1) + '%</span></div>'
    + '<div class="mt-1 text-sm text-stone-700">' + favHtml + (games != null ? ' · ' + games.toLocaleString() + ' ' + h2hLabels.games : '') + '</div>'
    + '</div>'
    + civHeadSSR(iconB, bCrown, 48)
    + '</div>'
    + '<div class="mt-3 flex h-2.5 overflow-hidden rounded-full border border-stone-700/20">'
    + '<div style="width:' + fill + '%;background:var(--color-wr-bad)"></div>'
    + '<div style="width:' + (100 - fill) + '%;background:var(--color-wr-good)"></div>'
    + '</div>'
    + (eIdx === 0 ? perMapHtmlSSR(a, b) : '')
    + '</div>';
};

const initialA = byslugSSR["britons"] ? "britons" : (civs[0]?.slug ?? "");
const initialB = byslugSSR["franks"] ? "franks" : (civs[1]?.slug ?? civs[0]?.slug ?? "");
const defaultH2hHtml = h2hBannerSSR(initialA, initialB, 0);
const defaultComparatorHtml = panelSSR(initialA) + panelSSR(initialB);
---
<BaseLayout title={t(lang, "matchups.title")} description={t(lang, "meta.matchups")} canonicalPath="/matchups">
  <section class="mx-auto max-w-7xl px-4 py-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h1 class="font-display text-2xl text-ink sm:text-3xl">{t(lang, "matchups.title")}</h1>
      <select id="h2h-elo" aria-label="elo" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 font-mono text-xs text-ink">
        {ELO_BUCKETS.map((b, i) => <option value={i}>{b === "all" ? (lang === "tr" ? "Tüm Elo" : "All Elo") : b}</option>)}
      </select>
    </div>
    <p class="mt-1 max-w-prose text-xs text-stone-700">{t(lang, "matchups.intro")}</p>

    <form class="mt-4 grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="text-xs text-stone-700">{t(lang, "matchups.pickA")}</span>
        <select id="civ-a" class="mt-1 w-full rounded border border-stone-700/40 bg-parchment p-2 text-ink">
          {civs.map((c) => <option value={c.slug} selected={c.slug === initialA}>{displayNames[c.slug]}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-xs text-stone-700">{t(lang, "matchups.pickB")}</span>
        <select id="civ-b" class="mt-1 w-full rounded border border-stone-700/40 bg-parchment p-2 text-ink">
          {civs.map((c) => <option value={c.slug} selected={c.slug === initialB}>{displayNames[c.slug]}</option>)}
        </select>
      </label>
    </form>

    <div id="h2h" class="mt-4" set:html={defaultH2hHtml}></div>

    <div id="comparator" class="mt-6 grid gap-6 sm:grid-cols-2" set:html={defaultComparatorHtml}>
      <!-- Server-rendered default pair; JS replaces this on load / selection. -->
    </div>

    <script is:inline data-astro-rerun define:vars={{ civs, civIcons, unitIcons, labels, h2hElo, civMetaLite, h2hLabels, pm, mapNames, displayNames, TIER_COLORS }}>
      // Build a slug -> civ lookup
      const byslug = Object.fromEntries(civs.map((c) => [c.slug, c]));

      // Escape data-derived strings before inserting into innerHTML — defense-in-depth.
      // Civ data is authored today, but community contributions are planned; this prevents
      // any HTML/script in a data field from executing.
      // mirror of src/scripts/html.ts (is:inline can't import — keep in sync)
      function esc(s) {
        return String(s).replace(/[&<>"']/g, (ch) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch],
        );
      }

      const params = new URLSearchParams(location.search);
      const initialA = byslug[params.get("a")] ? params.get("a") : "britons";
      const initialB = byslug[params.get("b")] ? params.get("b") : "franks";

      const selA = document.getElementById("civ-a");
      const selB = document.getElementById("civ-b");
      selA.value = initialA;
      selB.value = initialB;

      // Names are precomputed server-side with the canonical prettifier
      // (src/lib/display.ts) and passed in via define:vars.
      const displayName = (slug) => displayNames[slug] ?? slug;

      function fmt(n, suffix) {
        return (typeof n === "number" ? n.toFixed(1) + suffix : "—");
      }

      function tierBadge(tier) {
        if (!tier) return '<span class="text-stone-700">—</span>';
        // TIER_COLORS comes from src/lib/tiers.ts via define:vars.
        return '<span class="inline-flex h-6 w-6 items-center justify-center rounded font-display text-sm font-bold text-parchment" style="background:'
          + (TIER_COLORS[tier] || TIER_COLORS.D) + '">' + esc(tier) + '</span>';
      }

      function panel(slug) {
        const c = byslug[slug];
        if (!c) return '<div class="rounded border border-royal/40 p-4 text-royal">' + h2hLabels.unknownCiv + esc(slug) + '</div>';

        const icon = civIcons[slug];
        const meta = civMetaLite[slug] || {};

        const bonusesHtml = (c.civBonuses || []).map((b) => '<li>' + esc(b) + '</li>').join('');

        const uniqueUnitsHtml = (c.uniqueUnits || []).map((uslug) => {
          const uIcon = unitIcons[uslug];
          return '<li class="flex items-center gap-2">'
               + (uIcon ? '<img src="' + esc(uIcon) + '" alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6"/>' : '')
               + '<span>' + esc(displayName(uslug)) + '</span></li>';
        }).join('');

        const techsHtml = c.uniqueTechs
          ? '<li><strong>' + esc(c.uniqueTechs.castle?.name || '—') + '</strong> (' + labels.castleAge + ') — '
              + esc(c.uniqueTechs.castle?.effect || '—') + '</li>'
          + '<li><strong>' + esc(c.uniqueTechs.imperial?.name || '—') + '</strong> (' + labels.imperialAge + ') — '
              + esc(c.uniqueTechs.imperial?.effect || '—') + '</li>'
          : '<li>—</li>';

        const metaRow = (key, tier, wr) =>
          '<div class="flex items-center gap-3 text-sm">'
          + '<span class="w-10 font-mono text-[11px] uppercase tracking-wide text-stone-700">' + key + '</span>'
          + tierBadge(tier)
          + '<span class="font-mono text-ink">' + fmt(wr, '%') + '</span></div>';
        const metaHtml = (meta && meta.tier)
          ? '<div class="mt-3 space-y-1">'
            + metaRow("1v1", meta.tier, meta.winRate)
            + metaRow(h2hLabels.team, meta.teamTier, meta.teamWinRate)
          + '</div>'
          : '<p class="mt-3 text-sm italic text-stone-700">' + labels.noMeta + '</p>';

        return ''
          + '<article class="rounded border border-stone-700/40 bg-parchment p-3">'
          + '  <header class="flex items-center gap-3">'
          + (icon ? '    <img src="' + esc(icon) + '" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-12 w-12 rounded border border-stone-700/40"/>' : '')
          + '    <div>'
          + '      <h2 class="font-display text-xl text-ink">' + esc(displayName(slug)) + '</h2>'
          + '      <p class="text-sm text-stone-700">' + esc(c.region || '') + ' · ' + esc(c.specialty || '') + '</p>'
          + '    </div>'
          + '  </header>'
          + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.meta + '</h3>' + metaHtml + '</section>'
          + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.civBonuses + '</h3><ul class="mt-1 list-inside list-disc space-y-1 text-sm text-ink">' + bonusesHtml + '</ul></section>'
          + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.teamBonus + '</h3><p class="mt-1 text-sm text-ink">' + esc(c.teamBonus || '—') + '</p></section>'
          + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueUnits + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + uniqueUnitsHtml + '</ul></section>'
          + '  <section class="mt-3"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueTechs + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + techsHtml + '</ul></section>'
          + '</article>';
      }

      function crown(kind) {
        const color = kind === "gold" ? "#d9a93a" : "#b9bcc4";
        return '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="display:block">'
          + '<path fill="' + color + '" d="M5 17 3 7l5.5 4L12 5l3.5 6L21 7l-2 10z"/>'
          + '<rect x="5" y="18" width="14" height="2" fill="' + color + '"/></svg>';
      }
      function civHead(icon, kind, size) {
        return '<div class="flex flex-col items-center gap-1">' + crown(kind)
          + (icon ? '<img src="' + esc(icon) + '" alt="" width="' + size + '" height="' + size + '" class="rounded border border-stone-700/30"/>' : '')
          + '</div>';
      }

      function h2hBanner(a, b, eloIdx) {
        if (a === b) return '';
        const slice = h2hElo[a] && h2hElo[a][b];
        const rec = slice ? slice[eloIdx] : null;
        if (rec == null) {
          return '<div class="rounded border border-stone-700/30 bg-parchment p-4">'
            + '<p class="text-sm italic text-stone-700">' + h2hLabels.noData + '</p></div>';
        }
        const wr = Array.isArray(rec) ? rec[0] : rec;
        const games = Array.isArray(rec) ? rec[1] : null;
        const fav = wr >= 52 ? displayName(a) : wr <= 48 ? displayName(b) : null;
        const favHtml = fav
          ? '<span class="font-semibold" style="color:var(--color-fav)">' + esc(fav) + '</span> ' + h2hLabels.favored
          : '<span class="font-semibold">' + h2hLabels.even + '</span>';
        const iconA = civIcons[a], iconB = civIcons[b];
        const fill = Math.max(4, Math.min(96, wr));
        const aCrown = wr >= 52 ? "gold" : "silver";
        const bCrown = wr <= 48 ? "gold" : "silver";
        return ''
          + '<div class="rounded border border-stone-700/30 bg-parchment p-4">'
          + '<div class="flex items-center justify-center gap-5">'
          + civHead(iconA, aCrown, 48)
          + '<div class="text-center">'
          + '<div class="font-display text-3xl text-ink">' + wr.toFixed(1) + '%'
          + ' <span class="text-lg text-stone-700/60">vs ' + (100 - wr).toFixed(1) + '%</span></div>'
          + '<div class="mt-1 text-sm text-stone-700">' + favHtml + (games != null ? ' · ' + games.toLocaleString() + ' ' + h2hLabels.games : '') + '</div>'
          + '</div>'
          + civHead(iconB, bCrown, 48)
          + '</div>'
          + '<div class="mt-3 flex h-2.5 overflow-hidden rounded-full border border-stone-700/20">'
          + '<div style="width:' + fill + '%;background:var(--color-wr-bad)"></div>'
          + '<div style="width:' + (100 - fill) + '%;background:var(--color-wr-good)"></div>'
          + '</div>'
          + (eloIdx === 0 ? perMapHtml(a, b) : '')
          + '</div>';
      }

      function perMapHtml(a, b) {
        const data = (pm[a] && pm[a][b]) || null;
        if (!data) return '';
        const entries = Object.keys(data)
          .map((i) => [mapNames[i], data[i]])
          .sort((x, y) => y[1] - x[1]);
        if (!entries.length) return '';
        return '<div class="mt-4 border-t border-stone-700/15 pt-3">'
          + '<h3 class="mb-2 font-mono text-[10px] uppercase tracking-wide text-stone-700">' + h2hLabels.byMap + '</h3>'
          + '<div class="grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">'
          + entries.map((e) =>
              '<div class="flex items-center justify-between gap-2 text-sm">'
              + '<span class="truncate text-ink">' + esc(e[0]) + '</span>'
              + '<span class="font-mono font-medium" style="color:' + (e[1] >= 50 ? 'var(--color-fav)' : 'var(--color-wr-bad)') + '">' + e[1] + '%</span>'
              + '</div>',
            ).join('')
          + '</div></div>';
      }

      const eloSel = document.getElementById("h2h-elo");

      function render() {
        const a = selA.value;
        const b = selB.value;
        document.getElementById("h2h").innerHTML = h2hBanner(a, b, +eloSel.value);
        document.getElementById("comparator").innerHTML = panel(a) + panel(b);
        const url = new URL(location.href);
        url.searchParams.set("a", a);
        url.searchParams.set("b", b);
        history.replaceState(null, "", url.toString());
      }

      selA.addEventListener("change", render);
      selB.addEventListener("change", render);
      eloSel.addEventListener("change", render);
      render();
    </script>
  </section>
</BaseLayout>
