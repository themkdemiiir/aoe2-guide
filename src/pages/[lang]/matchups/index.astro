---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug } from "@/lib/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const matchups = await getLocalizedEntries("matchups", lang);
---
<BaseLayout title={t(lang, "nav.matchups")} canonicalPath="/matchups">
  <section class="mx-auto max-w-7xl px-4 py-12">
    <h1 class="font-display text-4xl text-ink">{t(lang, "nav.matchups")}</h1>
    {matchups.length === 0 ? (
      <p class="mt-6 text-stone-700">No matchups yet — coming soon.</p>
    ) : (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {matchups.map((m) => (
          <li>
            <a href={localizedPath(`/matchups/${canonicalSlug(m.id)}`, lang)}
               class="block rounded border border-stone-700/40 bg-parchment p-4 hover:border-gold-500">
              <div class="font-display text-lg text-ink">{m.data.civA} vs {m.data.civB}</div>
              <div class="mt-1 text-xs text-stone-700">{m.data.difficulty}</div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
