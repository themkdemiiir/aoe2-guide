---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getCollection } from "astro:content";
import iconMap from "@data/icon-map.json";
import matchupsData from "@data/civ-matchups.json";
import civMeta from "@data/civ-meta.json";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;

// Sort civs alphabetically by slug for the dropdowns.
const civs = (await getCollection("civ-data"))
  .map((e) => e.data)
  .sort((a, b) => a.slug.localeCompare(b.slug));

const civIcons = (iconMap as any).civs ?? {};
const unitIcons = (iconMap as any).units ?? {};

// Localized UI labels — passed to client JS via define:vars.
const labels = {
  civBonuses:  t(lang, "matchups.civBonuses"),
  teamBonus:   t(lang, "matchups.teamBonus"),
  uniqueUnits: t(lang, "matchups.uniqueUnits"),
  uniqueTechs: t(lang, "matchups.uniqueTechs"),
  meta:        t(lang, "matchups.meta"),
  winRate:     t(lang, "matchups.winRate"),
  playRate:    t(lang, "matchups.playRate"),
  tier:        t(lang, "matchups.tier"),
  noMeta:      t(lang, "matchups.noMeta"),
  castleAge:   t(lang, "matchups.castleAge"),
  imperialAge: t(lang, "matchups.imperialAge"),
};

function displayName(slug: string): string {
  return slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, " ");
}

// Compact head-to-head matrix (a's 1v1 win rate vs b) + real per-civ meta, both
// passed to the client so the comparator can show a verdict and true tiers.
type MM = { opp: string; games: number; winRate: number };
const h2h: Record<string, Record<string, [number, number]>> = {};
for (const [civ, arr] of Object.entries(matchupsData.civs as Record<string, MM[]>)) {
  h2h[civ] = {};
  for (const m of arr) h2h[civ][m.opp] = [m.winRate, m.games];
}
type Ladder = { tier: string; winRate: number; playRate: number } | null;
const civMetaLite: Record<string, { tier: string | null; winRate: number | null; playRate: number | null; teamTier: string | null; teamWinRate: number | null }> = {};
for (const [slug, m] of Object.entries(civMeta.civs as Record<string, { "1v1": Ladder; team: Ladder }>)) {
  civMetaLite[slug] = {
    tier: m["1v1"]?.tier ?? null,
    winRate: m["1v1"]?.winRate ?? null,
    playRate: m["1v1"]?.playRate ?? null,
    teamTier: m.team?.tier ?? null,
    teamWinRate: m.team?.winRate ?? null,
  };
}
const h2hLabels = {
  heading: lang === "tr" ? "Karşılıklı (1v1)" : "Head-to-head (1v1)",
  favored: lang === "tr" ? "favori" : "favored",
  even: lang === "tr" ? "başa baş" : "even",
  games: lang === "tr" ? "maç" : "games",
  noData: lang === "tr" ? "Bu eşleşme için yeterli veri yok." : "Not enough data for this matchup.",
  team: lang === "tr" ? "Takım" : "Team",
  perMap: lang === "tr" ? "Harita bazlı eşleşmeler her civ'in sayfasında." : "Per-map matchups are on each civ's page.",
};
---
<BaseLayout title={t(lang, "matchups.title")} canonicalPath="/matchups">
  <section class="mx-auto max-w-7xl px-4 py-12">
    <h1 class="font-display text-4xl text-ink">{t(lang, "matchups.title")}</h1>
    <p class="mt-3 max-w-prose text-stone-700">{t(lang, "matchups.intro")}</p>

    <form class="mt-8 grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm text-stone-700">{t(lang, "matchups.pickA")}</span>
        <select id="civ-a" class="mt-1 w-full rounded border border-stone-700/40 bg-parchment p-2 text-ink">
          {civs.map((c) => <option value={c.slug}>{displayName(c.slug)}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-sm text-stone-700">{t(lang, "matchups.pickB")}</span>
        <select id="civ-b" class="mt-1 w-full rounded border border-stone-700/40 bg-parchment p-2 text-ink">
          {civs.map((c) => <option value={c.slug}>{displayName(c.slug)}</option>)}
        </select>
      </label>
    </form>

    <div id="h2h" class="mt-8"></div>

    <div id="comparator" class="mt-6 grid gap-6 sm:grid-cols-2">
      <!-- JS will populate this with two civ panels -->
    </div>

    <script is:inline define:vars={{ civs, civIcons, unitIcons, labels, h2h, civMetaLite, h2hLabels }}>
      // Build a slug -> civ lookup
      const byslug = Object.fromEntries(civs.map((c) => [c.slug, c]));

      // Escape data-derived strings before inserting into innerHTML — defense-in-depth.
      // Civ data is authored today, but community contributions are planned; this prevents
      // any HTML/script in a data field from executing.
      function esc(s) {
        return String(s).replace(/[&<>"']/g, (ch) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch],
        );
      }

      const params = new URLSearchParams(location.search);
      const initialA = byslug[params.get("a")] ? params.get("a") : "britons";
      const initialB = byslug[params.get("b")] ? params.get("b") : "franks";

      const selA = document.getElementById("civ-a");
      const selB = document.getElementById("civ-b");
      selA.value = initialA;
      selB.value = initialB;

      function displayName(slug) {
        return slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, " ");
      }

      function fmt(n, suffix) {
        return (typeof n === "number" ? n.toFixed(1) + suffix : "—");
      }

      function panel(slug) {
        const c = byslug[slug];
        if (!c) return '<div class="rounded border border-royal/40 p-4 text-royal">Unknown civ: ' + esc(slug) + '</div>';

        const icon = civIcons[slug];
        const meta = civMetaLite[slug] || {};

        const bonusesHtml = (c.civBonuses || []).map((b) => '<li>' + esc(b) + '</li>').join('');

        const uniqueUnitsHtml = (c.uniqueUnits || []).map((uslug) => {
          const uIcon = unitIcons[uslug];
          return '<li class="flex items-center gap-2">'
               + (uIcon ? '<img src="' + esc(uIcon) + '" alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6"/>' : '')
               + '<span>' + esc(displayName(uslug)) + '</span></li>';
        }).join('');

        const techsHtml = c.uniqueTechs
          ? '<li><strong>' + esc(c.uniqueTechs.castle?.name || '—') + '</strong> (' + labels.castleAge + ') — '
              + esc(c.uniqueTechs.castle?.effect || '—') + '</li>'
          + '<li><strong>' + esc(c.uniqueTechs.imperial?.name || '—') + '</strong> (' + labels.imperialAge + ') — '
              + esc(c.uniqueTechs.imperial?.effect || '—') + '</li>'
          : '<li>—</li>';

        const metaHtml = (meta && meta.tier)
          ? '<dl class="mt-3 grid grid-cols-3 gap-2 text-sm">'
            + '<div><dt class="text-stone-700">' + labels.tier + '</dt><dd class="text-gold-700 font-bold">' + esc(meta.tier) + '</dd></div>'
            + '<div><dt class="text-stone-700">' + labels.winRate + '</dt><dd class="text-ink">' + fmt(meta.winRate, '%') + '</dd></div>'
            + '<div><dt class="text-stone-700">' + h2hLabels.team + '</dt><dd class="text-ink">' + esc(meta.teamTier || '—') + ' ' + fmt(meta.teamWinRate, '%') + '</dd></div>'
          + '</dl>'
          : '<p class="mt-3 text-sm italic text-stone-700">' + labels.noMeta + '</p>';

        return ''
          + '<article class="rounded border border-stone-700/40 bg-parchment p-4">'
          + '  <header class="flex items-center gap-3">'
          + (icon ? '    <img src="' + esc(icon) + '" alt="" width="56" height="56" loading="lazy" decoding="async" class="h-14 w-14 rounded border border-stone-700/40"/>' : '')
          + '    <div>'
          + '      <h2 class="font-display text-2xl text-ink">' + esc(displayName(slug)) + '</h2>'
          + '      <p class="text-sm text-stone-700">' + esc(c.region || '') + ' · ' + esc(c.specialty || '') + '</p>'
          + '    </div>'
          + '  </header>'
          + '  <section class="mt-4"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.meta + '</h3>' + metaHtml + '</section>'
          + '  <section class="mt-4"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.civBonuses + '</h3><ul class="mt-1 list-inside list-disc space-y-1 text-sm text-ink">' + bonusesHtml + '</ul></section>'
          + '  <section class="mt-4"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.teamBonus + '</h3><p class="mt-1 text-sm text-ink">' + esc(c.teamBonus || '—') + '</p></section>'
          + '  <section class="mt-4"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueUnits + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + uniqueUnitsHtml + '</ul></section>'
          + '  <section class="mt-4"><h3 class="font-display text-sm uppercase text-stone-700">' + labels.uniqueTechs + '</h3><ul class="mt-1 space-y-1 text-sm text-ink">' + techsHtml + '</ul></section>'
          + '</article>';
      }

      function h2hBanner(a, b) {
        const head = '<h2 class="font-display text-sm uppercase tracking-wide text-stone-700">' + h2hLabels.heading + '</h2>';
        if (a === b) return '';
        const rec = (h2h[a] && h2h[a][b]) || null;
        if (!rec) {
          return '<div class="rounded border border-stone-700/30 bg-parchment p-4">' + head
            + '<p class="mt-2 text-sm italic text-stone-700">' + h2hLabels.noData + '</p></div>';
        }
        const wr = rec[0], games = rec[1];
        const fav = wr >= 52 ? displayName(a) : wr <= 48 ? displayName(b) : null;
        const favHtml = fav
          ? '<span class="font-semibold" style="color:#3f6b34">' + esc(fav) + '</span> ' + h2hLabels.favored
          : '<span class="font-semibold">' + h2hLabels.even + '</span>';
        const iconA = civIcons[a], iconB = civIcons[b];
        const fill = Math.max(4, Math.min(96, wr));
        return ''
          + '<div class="rounded border border-stone-700/30 bg-parchment p-4">'
          + head
          + '<div class="mt-3 flex items-center justify-center gap-4">'
          + (iconA ? '<img src="' + esc(iconA) + '" alt="" width="40" height="40" class="h-10 w-10"/>' : '')
          + '<div class="text-center">'
          + '<div class="font-display text-3xl text-ink">' + wr.toFixed(1) + '%'
          + ' <span class="text-lg text-stone-700/60">vs ' + (100 - wr).toFixed(1) + '%</span></div>'
          + '<div class="mt-1 text-sm text-stone-700">' + favHtml + ' · ' + games.toLocaleString() + ' ' + h2hLabels.games + '</div>'
          + '</div>'
          + (iconB ? '<img src="' + esc(iconB) + '" alt="" width="40" height="40" class="h-10 w-10"/>' : '')
          + '</div>'
          + '<div class="mt-3 flex h-2.5 overflow-hidden rounded-full border border-stone-700/20">'
          + '<div style="width:' + fill + '%;background:#8a2d22"></div>'
          + '<div style="width:' + (100 - fill) + '%;background:#c79a3c"></div>'
          + '</div>'
          + '<p class="mt-3 text-center font-mono text-[10px] text-stone-700/60">' + h2hLabels.perMap + '</p>'
          + '</div>';
      }

      function render() {
        const a = selA.value;
        const b = selB.value;
        document.getElementById("h2h").innerHTML = h2hBanner(a, b);
        document.getElementById("comparator").innerHTML = panel(a) + panel(b);
        const url = new URL(location.href);
        url.searchParams.set("a", a);
        url.searchParams.set("b", b);
        history.replaceState(null, "", url.toString());
      }

      selA.addEventListener("change", render);
      selB.addEventListener("change", render);
      render();
    </script>
  </section>
</BaseLayout>
