---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import UniqueUnitBlock from "@/components/content/UniqueUnitBlock.astro";
import CivStats from "@/components/content/CivStats.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { marked } from "marked";

export async function getStaticPaths() {
  const civs = await getCollection("civilizations");
  return locales.flatMap((lang) =>
    civs.map((c) => ({ params: { lang, civ: c.id } }))
  );
}

const lang = Astro.params.lang as Locale;
const civSlug = Astro.params.civ as string;
const civs = await getCollection("civilizations");
const entry = civs.find((c) => c.id === civSlug);
if (!entry) return Astro.redirect("/404");

const civDataEntry = await getEntry("civ-data", civSlug);
const meta = civDataEntry?.data;
const name = entry.data.name[lang];
const tagline = entry.data.tagline[lang];
const description = `${name} civilization guide for Age of Empires II — ${tagline}`;
const strategyHtml = entry.data.strategy?.[lang] ? (marked.parse(entry.data.strategy[lang]) as string) : "";
---
<BaseLayout title={name} description={description} canonicalPath={`/civs/${civSlug}`}>
  <article class="mx-auto max-w-prose px-4 py-12">
    <header class="flex items-center gap-4">
      <Icon slug={civSlug} kind="civ" size={104} />
      <div>
        <h1 class="font-display text-4xl text-ink">{name}</h1>
        <p class="text-stone-700">{tagline}</p>
      </div>
    </header>

    {meta && (
      <dl class="mt-6 grid grid-cols-2 gap-2 text-sm sm:grid-cols-3">
        <div><dt class="text-stone-700">Specialty</dt><dd class="text-ink">{meta.specialty}</dd></div>
        <div><dt class="text-stone-700">Region</dt><dd class="text-ink">{meta.region}</dd></div>
      </dl>
    )}

    <CivStats slug={civSlug} lang={lang} />

    <section class="mt-8">
      <h2 class="font-display text-2xl text-ink">Bonuses</h2>
      <ul class="mt-2 list-inside list-disc space-y-1 text-ink">
        {entry.data.bonuses[lang].map((b: string) => <li>{b}</li>)}
      </ul>
      <p class="mt-3 text-sm text-stone-700"><strong>Team:</strong> {entry.data.teamBonus[lang]}</p>
    </section>

    {meta && meta.uniqueUnits.length > 0 && (
      <section class="mt-8">
        <h2 class="font-display text-2xl text-ink">Unique Units</h2>
        <div class="mt-3">
          <UniqueUnitBlock slugs={meta.uniqueUnits} locale={lang} />
        </div>
      </section>
    )}

    <section class="mt-8">
      <h2 class="font-display text-2xl text-ink">Unique Techs</h2>
      <ul class="mt-2 space-y-2 text-ink">
        <li><strong>{entry.data.uniqueTechs.castle.name[lang]}</strong> — {entry.data.uniqueTechs.castle.effect[lang]}</li>
        <li><strong>{entry.data.uniqueTechs.imperial.name[lang]}</strong> — {entry.data.uniqueTechs.imperial.effect[lang]}</li>
      </ul>
    </section>

    {strategyHtml && (
      <section class="prose prose-stone mt-10 max-w-none rounded border border-stone-700/30 bg-parchment px-5 py-6" set:html={strategyHtml} />
    )}
  </article>
</BaseLayout>
