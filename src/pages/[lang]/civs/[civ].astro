---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import UniqueUnitBlock from "@/components/content/UniqueUnitBlock.astro";
import CivStats from "@/components/content/CivStats.astro";
import CivMatchups from "@/components/content/CivMatchups.astro";
import Icon from "@/components/ui/Icon.astro";
import { getCollection, getEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import civMeta from "@data/civ-meta.json";
import matchupsData from "@data/civ-matchups.json";
import { marked } from "marked";

export async function getStaticPaths() {
  const civs = await getCollection("civilizations");
  return locales.flatMap((lang) =>
    civs.map((c) => ({ params: { lang, civ: c.id } }))
  );
}

const lang = Astro.params.lang as Locale;
const civSlug = Astro.params.civ as string;
const civs = await getCollection("civilizations");
const entry = civs.find((c) => c.id === civSlug);
if (!entry) return Astro.redirect("/404");

const civDataEntry = await getEntry("civ-data", civSlug);
const meta = civDataEntry?.data;
const name = entry.data.name[lang];
const tagline = entry.data.tagline[lang];
const description = lang === "tr"
  ? `${name} uygarlık rehberi (Age of Empires II) — ${tagline}`
  : `${name} civilization guide for Age of Empires II — ${tagline}`;
const strategyHtml = entry.data.strategy?.[lang] ? (marked.parse(entry.data.strategy[lang]) as string) : "";

// When both the ranked-stats block (CivStats) and the matchup block (CivMatchups)
// render nothing, the page would silently drop straight from the header to the
// bonuses. Detect that and show a localized placeholder instead.
const has1v1Stats = !!(civMeta.civs as Record<string, { "1v1": unknown } | undefined>)[civSlug]?.["1v1"];
const hasMatchupRows = ((matchupsData.civs as Record<string, { winRate: number }[]>)[civSlug] ?? []).some((m) => m.winRate !== 50);
---
<BaseLayout title={`${name} — ${t(lang, "civs.seoTitle")}`} breadcrumbName={name} description={description} canonicalPath={`/civs/${civSlug}`}>
  <article class="mx-auto max-w-3xl px-4 py-6 sm:py-8">
    <header class="flex items-center gap-4">
      <Icon slug={civSlug} kind="civ" size={80} />
      <div>
        <h1 class="font-display text-3xl text-ink">{name}</h1>
        <p class="text-stone-700">{tagline}</p>
        {meta && <p class="mt-1 font-mono text-xs text-stone-700">{meta.specialty} · {meta.region}</p>}
      </div>
    </header>

    <CivStats slug={civSlug} lang={lang} />

    <CivMatchups slug={civSlug} lang={lang} />

    {!has1v1Stats && !hasMatchupRows && (
      <p class="mt-6 rounded border border-stone-700/20 bg-parchment/60 px-4 py-3 text-sm italic text-stone-700">
        {t(lang, "ui.civStatsPending")}
      </p>
    )}

    <section class="mt-6">
      <h2 class="font-display text-xl text-ink">{t(lang, "matchups.civBonuses")}</h2>
      <ul class="mt-2 list-inside list-disc space-y-1 text-ink">
        {entry.data.bonuses[lang].map((b: string) => <li>{b}</li>)}
      </ul>
      <p class="mt-3 text-sm text-stone-700"><strong>{t(lang, "matchups.teamBonus")}:</strong> {entry.data.teamBonus[lang]}</p>
    </section>

    {meta && meta.uniqueUnits.length > 0 && (
      <section class="mt-6">
        <h2 class="font-display text-xl text-ink">{t(lang, "matchups.uniqueUnits")}</h2>
        <div class="mt-3">
          <UniqueUnitBlock slugs={meta.uniqueUnits} locale={lang} />
        </div>
      </section>
    )}

    <section class="mt-6">
      <h2 class="font-display text-xl text-ink">{t(lang, "matchups.uniqueTechs")}</h2>
      <ul class="mt-2 space-y-2 text-ink">
        <li><strong>{entry.data.uniqueTechs.castle.name[lang]}</strong> — {entry.data.uniqueTechs.castle.effect[lang]}</li>
        <li><strong>{entry.data.uniqueTechs.imperial.name[lang]}</strong> — {entry.data.uniqueTechs.imperial.effect[lang]}</li>
      </ul>
    </section>

    {strategyHtml && (
      <section class="prose prose-stone mt-6 max-w-none rounded border border-stone-700/30 bg-parchment px-5 py-5" set:html={strategyHtml} />
    )}
  </article>
</BaseLayout>
