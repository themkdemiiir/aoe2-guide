---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import iconMap from "@data/icon-map.json";
import civMeta from "@data/civ-meta.json";
import cubeDims from "@data/civ-cube-dims.json";
import { getCollection } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { localizedPath, t } from "@/i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const tr = lang === "tr";
const allCivs = await getCollection("civilizations");
const civIcons = (iconMap as { civs?: Record<string, string> }).civs ?? {};

type Ladder = { winRate: number; games: number } | null;
const meta = civMeta.civs as unknown as Record<string, { "1v1": Ladder }>;

// Slim per-civ payload embedded in the page: name/icon/initial + the OVERALL
// win rate (for the default view + the no-JS fallback). All the sliced stats
// (elo × map × patch) live in the fetched cube, not here.
const civData = allCivs.map((c) => {
  const m = meta[c.id]?.["1v1"] ?? null;
  return {
    slug: c.id,
    name: c.data.name[lang],
    initial: c.data.name.en.charAt(0),
    icon: civIcons[c.id] ?? "",
    overall: m ? [m.winRate, m.games] : null,
  };
});

// Honest headline: floor, and fall back to thousands below 1M — never round
// 600k matches up to "1M+".
const matches1v1 = (civMeta.appearances?.["1v1"] ?? 0) / 2;
const games1v1Label =
  matches1v1 >= 1e6 ? `${Math.floor(matches1v1 / 1e6)}M+` : `${Math.floor(matches1v1 / 1e3)}k+`;
const patches = (civMeta.patches as { patch: string; label: string }[]) ?? [];
const latestPatch = patches[0]?.label ?? "";

// Filter dropdown options come from the cube's own dimensions, so they line up
// exactly with what the fetched cube can answer.
const dims = cubeDims as { elos: string[]; maps: string[]; mapNames: string[]; months: { patch: string; label: string }[] };
const mapOptions = dims.maps.map((key, i) => ({ key, name: dims.mapNames[i] }));

const SHIELD = "polygon(0 0,100% 0,100% 68%,50% 100%,0 68%)";
const MIN = 30; // games below this in the chosen slice → low-sample
const tierOf = (wr: number) => (wr >= 53 ? "S" : wr >= 51 ? "A" : wr >= 49 ? "B" : wr >= 47 ? "C" : "D");

const labels = {
  civBase: localizedPath("/civs/", lang),
  civs: tr ? "UYG." : "CIVS",
  nr: tr ? "YENİ / YETERSİZ VERİ" : "NEW / LOW SAMPLE",
  loading: tr ? "veri yükleniyor…" : "loading data…",
  rated: tr ? "değerlendirildi" : "rated",
  reset: tr ? "Sıfırla" : "Reset",
  tiers: [
    ["S", tr ? "EN İYİ" : "TOP TIER", "#8a2d22"],
    ["A", tr ? "GÜÇLÜ" : "STRONG", "#9a6a1e"],
    ["B", tr ? "SAĞLAM" : "SOLID", "#6b5b41"],
    ["C", tr ? "DURUMA GÖRE" : "SITUATIONAL", "#7a6a4a"],
    ["D", tr ? "ZAYIF" : "WEAK", "#8a7a5a"],
  ] as const,
};

// --- Server-rendered DEFAULT view (Overall) so the tier list is in the static
// HTML and works with JS off. The client re-renders only when a filter changes. ---
const ratedCivs = civData
  .filter((c) => c.overall && (c.overall[1] as number) >= MIN)
  .map((c) => ({ ...c, wr: c.overall![0] as number }));
const serverTiers = labels.tiers
  .map(([letter, label, color]) => ({
    letter, label, color,
    civs: ratedCivs.filter((c) => tierOf(c.wr) === letter).sort((a, b) => b.wr - a.wr),
  }))
  .filter((g) => g.civs.length);
---
<BaseLayout title={t(lang, "nav.civs")} canonicalPath="/civs">
  <section class="mx-auto max-w-7xl px-4 py-6 sm:py-8">
    <div class="font-mono text-xs uppercase tracking-[0.14em] text-gold-700">
      <a href={localizedPath("/", lang)} class="hover:text-gold-500">{tr ? "Ana Sayfa" : "Home"}</a> / {t(lang, "nav.civs")}
    </div>
    <h1 class="mt-2 font-display text-2xl text-ink sm:text-3xl">{t(lang, "nav.civs")}</h1>
    <p class="mt-1 font-mono text-xs text-stone-700">
      {tr
        ? `53 uygarlık · ${games1v1Label} ranked 1v1 maç · patch ${latestPatch}`
        : `53 civs · ${games1v1Label} ranked 1v1 games · patch ${latestPatch}`}
    </p>

    {/* --- Combinable filters: Map × Elo × Patch. All three intersect (e.g.
         current patch + 1200 elo + Arabia). Hidden until JS reveals it — the
         filtering fetches a static cube and runs in the browser (no server); the
         Overall tier list below is server-rendered so the page works without JS. --- */}
    <div data-filter hidden class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-wide text-stone-700">
      <label class="flex items-center gap-1.5">{tr ? "Harita" : "Map"}
        <select data-f="map" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 text-xs normal-case text-ink">
          <option value="">{tr ? "Tüm haritalar" : "Any map"}</option>
          {mapOptions.map((m) => <option value={m.key}>{m.name}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-1.5">Elo
        <select data-f="elo" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 text-xs normal-case text-ink">
          <option value="">{tr ? "Tüm elo" : "Any elo"}</option>
          {dims.elos.map((b) => <option value={b}>{b}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-1.5">{tr ? "Yama" : "Patch"}
        <select data-f="patch" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 text-xs normal-case text-ink">
          <option value="">{tr ? "Tüm zamanlar" : "All-time"}</option>
          {patches.map((p, i) => <option value={p.patch}>{i === 0 ? (tr ? `Güncel · ${p.label}` : `Current · ${p.label}`) : p.label}</option>)}
        </select>
      </label>
      <button type="button" data-reset hidden class="rounded border border-stone-700/30 px-2 py-1 text-[10px] text-stone-700 hover:border-gold-500 hover:text-gold-500">{labels.reset}</button>
      <span data-slice-note class="normal-case text-stone-700/60"></span>
    </div>

    <div data-tierlist class="mt-4 space-y-2.5">
      {serverTiers.map((g) => (
        <div class="flex overflow-hidden rounded border border-stone-700/25">
          <div class="flex w-28 flex-none flex-col items-center justify-center px-2.5 py-4 text-center text-parchment" style={`background:${g.color}`}>
            <span class="font-display text-4xl font-extrabold leading-none">{g.letter}</span>
            <span class="mt-2 font-mono text-[9px] tracking-[0.12em] opacity-90">{g.label}</span>
            <span class="mt-1 font-mono text-[9px] tracking-[0.06em] opacity-60">{String(g.civs.length).padStart(2, "0")} {labels.civs}</span>
          </div>
          <div class="flex flex-1 flex-wrap content-start gap-2.5 bg-parchment/60 p-2.5">
            {g.civs.map((c) => (
              <a href={`${labels.civBase}${c.slug}`} class="flex w-52 items-center gap-2.5 rounded border border-stone-700/20 bg-parchment py-1.5 pl-2.5 pr-3.5 transition-colors hover:border-gold-500" style={`border-left:3px solid ${g.color}`}>
                <div class="flex h-9 w-7 flex-none items-center justify-center" style={`background:${g.color};clip-path:${SHIELD}`}><span class="-mt-1 font-display text-xs font-extrabold text-ember">{c.initial}</span></div>
                <div class="min-w-0 flex-1">
                  <div class="truncate font-display text-[15px] font-bold leading-tight text-ink">{c.name}</div>
                  <div class="font-mono text-[10px] tracking-wide text-gold-700">{c.wr != null ? `${c.wr}%` : "—"}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-4 font-mono text-[11px] tracking-wide text-stone-700/80">
      {t(lang, "data.source")} · {games1v1Label} {tr ? "maç" : "games"} · patch {latestPatch}
    </p>
  </section>

  <script is:inline define:vars={{ civData, labels, SHIELD, MIN }}>
    (() => {
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
      const tierOf = (wr) => (wr >= 53 ? "S" : wr >= 51 ? "A" : wr >= 49 ? "B" : wr >= 47 ? "C" : "D");

      const root = document.querySelector("[data-filter]");
      const list = document.querySelector("[data-tierlist]");
      const note = document.querySelector("[data-slice-note]");
      const resetBtn = root.querySelector("[data-reset]");
      const sel = { map: root.querySelector('[data-f="map"]'), elo: root.querySelector('[data-f="elo"]'), patch: root.querySelector('[data-f="patch"]') };

      let cube = null, cubeReq = null;
      function loadCube() {
        if (cube) return Promise.resolve(cube);
        if (!cubeReq) cubeReq = fetch("/civ-cube.json").then((r) => r.json()).then((c) => {
          c._ei = Object.fromEntries(c.elos.map((e, i) => [e, i]));
          c._mi = Object.fromEntries(c.maps.map((m, i) => [m, i]));
          c._pi = Object.fromEntries(c.months.map((p, i) => [p.patch, i]));
          cube = c; return c;
        });
        return cubeReq;
      }

      const isDefault = () => !sel.map.value && !sel.elo.value && !sel.patch.value;

      // slug -> [winRate, games] for the current filter intersection
      function sliceStats() {
        if (isDefault()) {
          const o = {};
          for (const c of civData) o[c.slug] = c.overall; // [wr, games]
          return o;
        }
        const eIdx = sel.elo.value ? cube._ei[sel.elo.value] : -1;
        const mIdx = sel.map.value ? (cube._mi[sel.map.value] ?? -2) : -1; // -2 = selected map absent from cube
        const pIdx = sel.patch.value ? (cube._pi[sel.patch.value] ?? -2) : -1; // -2 = month absent → NO data, never all-time
        const agg = {}; // civIndex -> [g, w]
        for (const r of cube.rows) {
          if (eIdx >= 0 && r[1] !== eIdx) continue;
          if (mIdx >= 0 && r[2] !== mIdx) continue;
          if (mIdx === -2 || pIdx === -2) { agg.length = 0; break; }
          if (pIdx >= 0 && r[3] !== pIdx) continue;
          const a = (agg[r[0]] ??= [0, 0]); a[0] += r[4]; a[1] += r[5];
        }
        const o = {};
        for (const ci in agg) {
          const slug = cube.civs[ci], g = agg[ci][0], w = agg[ci][1];
          o[slug] = g > 0 ? [+((w / g) * 100).toFixed(2), g] : null;
        }
        return o;
      }

      function chip(c, color) {
        return '<a href="' + esc(labels.civBase + c.slug) + '" class="flex w-52 items-center gap-2.5 rounded border border-stone-700/20 bg-parchment py-1.5 pl-2.5 pr-3.5 transition-colors hover:border-gold-500" style="border-left:3px solid ' + color + '">'
          + '<div class="flex h-9 w-7 flex-none items-center justify-center" style="background:' + color + ';clip-path:' + SHIELD + '"><span class="-mt-1 font-display text-xs font-extrabold text-ember">' + esc(c.initial) + '</span></div>'
          + '<div class="min-w-0 flex-1"><div class="truncate font-display text-[15px] font-bold leading-tight text-ink">' + esc(c.name) + '</div>'
          + '<div class="font-mono text-[10px] tracking-wide text-gold-700">' + (c._wr != null ? c._wr + "%" : "—") + '</div></div></a>';
      }

      function row(letter, label, color, civs, dashed) {
        const block = '<div class="flex w-28 flex-none flex-col items-center justify-center px-2.5 py-4 text-center ' + (dashed ? "text-stone-700" : "text-parchment") + '"' + (dashed ? "" : ' style="background:' + color + '"') + '>'
          + (dashed
            ? '<span class="font-display text-2xl leading-none">' + letter + '</span><span class="mt-2 max-w-[6rem] font-mono text-[9px] tracking-[0.08em] opacity-70">' + label + '</span>'
            : '<span class="font-display text-4xl font-extrabold leading-none">' + letter + '</span><span class="mt-2 font-mono text-[9px] tracking-[0.12em] opacity-90">' + label + '</span><span class="mt-1 font-mono text-[9px] tracking-[0.06em] opacity-60">' + String(civs.length).padStart(2, "0") + " " + labels.civs + '</span>')
          + '</div>';
        const chips = '<div class="flex flex-1 flex-wrap content-start gap-2.5 bg-parchment/60 p-2.5">' + civs.map((c) => chip(c, dashed ? "#6b5b41" : color)).join("") + '</div>';
        return '<div class="flex overflow-hidden rounded border ' + (dashed ? "border-dashed border-stone-700/25" : "border-stone-700/25") + '">' + block + chips + '</div>';
      }

      function paint(stats) {
        const rated = [], low = [];
        for (const c of civData) {
          const s = stats[c.slug];
          if (s && s[1] >= MIN) { c._wr = s[0]; c._g = s[1]; rated.push(c); }
          else { c._wr = s ? s[0] : null; low.push(c); }
        }
        let html = "";
        for (const [letter, label, color] of labels.tiers) {
          const group = rated.filter((c) => tierOf(c._wr) === letter).sort((a, b) => b._wr - a._wr);
          if (group.length) html += row(letter, label, color, group, false);
        }
        if (low.length) html += row("NR", labels.nr, "#8a7a5a", low.sort((a, b) => a.name.localeCompare(b.name)), true);
        list.innerHTML = html;

        const parts = [];
        if (sel.map.value) parts.push(sel.map.options[sel.map.selectedIndex].text);
        if (sel.elo.value) parts.push(sel.elo.value);
        if (sel.patch.value) parts.push(sel.patch.options[sel.patch.selectedIndex].text.replace(/^Current · |^Güncel · /, ""));
        resetBtn.hidden = parts.length === 0;
        note.textContent = parts.length ? (rated.length + "/" + civData.length + " " + labels.rated + " · " + parts.join(" · ")) : "";
      }

      async function render() {
        if (isDefault()) { paint(sliceStats()); return; }
        note.textContent = labels.loading;
        await loadCube();
        paint(sliceStats());
      }

      for (const s of Object.values(sel)) s.addEventListener("change", render);
      resetBtn.addEventListener("click", () => { sel.map.value = ""; sel.elo.value = ""; sel.patch.value = ""; render(); });

      // Reveal the filter (needs JS); the server already rendered Overall.
      root.hidden = false;
    })();
  </script>
</BaseLayout>
