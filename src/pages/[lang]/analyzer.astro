---
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, type Locale } from "@/i18n/locales";
import { ui } from "@/i18n/ui";
import { t } from "@/i18n/utils";
import { displayName } from "@/lib/display";
import civIdMap from "@data/civ-id-map.json";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;

// game/replay civ_id -> { name, icon } for the client renderer (replay civ ids
// are the GAME id space — civ-id-map.json is correct here, unlike the Relic API).
const civs = Object.fromEntries(
  Object.entries(civIdMap as Record<string, string>).map(([id, slug]) => [
    id,
    { slug, name: displayName(slug) },
  ]),
);

// Every analyzer.* string, pre-localized — derived by prefix so adding a key to
// ui.ts can never silently miss the client payload.
const L = Object.fromEntries(
  (Object.keys(ui.en) as Array<keyof typeof ui.en>)
    .filter((k) => k.startsWith("analyzer."))
    .map((k) => [k, t(lang, k)]),
);

// Mirror of replay-rs metrics.rs WATCHED_TECHS (tech_id -> display name) — the
// set of eco upgrades the engine reports in eco_techs.
const ecoTechs: Record<string, string> = {
  "22": "Loom", "213": "Wheelbarrow", "249": "Hand Cart",
  "202": "Double-Bit Axe", "203": "Bow Saw", "14": "Horse Collar",
  "13": "Heavy Plow", "55": "Gold Mining", "182": "Gold Shaft Mining",
  "278": "Stone Mining",
};
---

<BaseLayout title={t(lang, "analyzer.title")} description={t(lang, "analyzer.tagline")} canonicalPath="/analyzer">
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="font-display text-4xl text-ink">{t(lang, "analyzer.title")}</h1>
    <p class="mt-3 max-w-3xl text-stone-700">{t(lang, "analyzer.tagline")}</p>

    <div id="az-drop" class="mt-8 cursor-pointer rounded border-2 border-dashed border-stone-700/40 bg-parchment/60 px-6 py-14 text-center transition-colors hover:border-gold-500 data-[over=true]:border-gold-500 data-[over=true]:bg-gold-500/10">
      <p class="hidden font-display text-xl text-ink sm:block">{t(lang, "analyzer.drop")}</p>
      <p class="font-display text-xl text-ink sm:hidden">{t(lang, "analyzer.dropTap")}</p>
      <p class="mt-2 text-sm text-stone-700">
        <label class="cursor-pointer text-gold-700 underline underline-offset-2 hover:text-gold-500">
          {t(lang, "analyzer.browse")}
          <input id="az-file" type="file" accept=".aoe2record" class="sr-only" />
        </label>
      </p>
      <p class="mt-4 font-mono text-[11px] uppercase tracking-wide text-stone-700/80">{t(lang, "analyzer.privacy")}</p>
    </div>

    <div class="mt-4 grid gap-2 text-sm text-stone-700 sm:grid-cols-2">
      <p>{t(lang, "analyzer.where")}</p>
      <p>{t(lang, "analyzer.version")}</p>
    </div>

    <p id="az-status" class="mt-6 hidden font-mono text-sm text-stone-700" aria-live="polite"></p>

    <div id="az-error" class="mt-6 hidden rounded border border-royal/40 bg-royal/10 p-4">
      <p class="font-display font-bold text-royal">{t(lang, "analyzer.error")}</p>
      <p id="az-error-msg" class="mt-1 font-mono text-sm text-stone-700"></p>
    </div>

    <div id="az-report" class="mt-10 hidden"></div>

    <p class="mt-12 border-t border-stone-700/20 pt-4 text-sm text-stone-700">
      {t(lang, "analyzer.cli")}
      <a href="https://github.com/themkdemiiir/aoe2-guide" class="text-gold-700 underline underline-offset-2 hover:text-gold-500">GitHub</a>
    </p>
  </section>

  <script is:inline type="application/json" id="az-data" set:html={JSON.stringify({ L, civs, ecoTechs })} />

  <script>
    import Chart from "chart.js/auto";
    import { esc } from "@/scripts/html";

    const { L, civs, ecoTechs } = JSON.parse(document.getElementById("az-data")!.textContent!);

    // Theme tokens resolve differently in light vs dark (they swap on
    // html[data-theme]); read them at render time so charts follow the theme.
    const cssVar = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    };

    // Chart defaults matching the site's stat components (CivStats.astro).
    Chart.defaults.font.family = "'JetBrains Mono', monospace";
    Chart.defaults.font.size = 10;
    Chart.defaults.color = cssVar("--color-stone-700", "#6b5b41");

    // AoE2 DE slot colors by replay color_id (1=Blue … 7=Gray, 0|8=Orange).
    const PLAYER_COLORS: Record<number, string> = {
      1: "#2f6bd8", 2: "#c2352b", 3: "#3f8f3f", 4: "#c7a23c",
      5: "#2fa8a8", 6: "#8e4f9f", 7: "#7a7a72", 0: "#d07a2d", 8: "#d07a2d",
    };
    const colorOf = (id: number) => PLAYER_COLORS[id] ?? "#6b5b41";
    const drop = document.getElementById("az-drop")!;
    const fileInput = document.getElementById("az-file") as HTMLInputElement;
    const statusEl = document.getElementById("az-status")!;
    const errBox = document.getElementById("az-error")!;
    const errMsg = document.getElementById("az-error-msg")!;
    const reportEl = document.getElementById("az-report")!;

    const mmss = (ms: number | null | undefined) =>
      ms == null ? "—" : `${Math.floor(ms / 60000)}:${String(Math.floor(ms / 1000) % 60).padStart(2, "0")}`;
    const secs = (ms: number) => `${Math.round(ms / 1000)}s`;

    let wasmMod: any = null;
    async function loadWasm() {
      if (wasmMod) return wasmMod;
      // Glue is bundled from src/wasm/pkg (lazy chunk); the 1.4MB wasm binary
      // stays in public/ and is fetched only when a file is actually dropped.
      const mod = await import("../../wasm/pkg/replay_wasm.js");
      await mod.default({ module_or_path: "/analyzer/pkg/replay_wasm_bg.wasm" });
      wasmMod = mod;
      return mod;
    }

    let report: any = null;
    let selectedPn: number | null = null;
    let charts: Chart[] = [];
    // Last-rendered chart inputs, so a theme switch can rebuild with new colors.
    let lastPlayers: any[] | null = null;
    let lastSelPn = 0;

    // Production + APM line charts (Chart.js — same library as the civ stats pages).
    function drawCharts(players: any[], selPn: number) {
      for (const c of charts) c.destroy();
      charts = [];
      lastPlayers = players;
      lastSelPn = selPn;
      // Re-read theme tokens each draw so light/dark swaps recolor axes + grid.
      const axisText = cssVar("--color-stone-700", "#6b5b41");
      Chart.defaults.color = axisText;
      const gridColor = `color-mix(in oklch, ${axisText} 15%, transparent)`;
      const mins = Math.max(...players.map((m: any) => Math.max(m.vils_series.length, m.apm_series.length)), 1);
      const labels = Array.from({ length: mins }, (_, i) => i);
      const line = (data: number[], color: string, you: boolean, dashed = false) => ({
        data,
        borderColor: color,
        backgroundColor: "transparent",
        borderWidth: you ? 2.5 : 1.2,
        borderDash: dashed ? [5, 4] : undefined,
        pointRadius: 0,
        tension: 0.25,
      });
      const base = {
        responsive: true,
        maintainAspectRatio: false,
        animation: false as const,
        plugins: { legend: { display: false }, tooltip: { mode: "index" as const, intersect: false } },
        scales: {
          x: { grid: { display: false }, ticks: { maxTicksLimit: 12 } },
          y: { grid: { color: gridColor }, beginAtZero: true },
        },
      };
      const prodEl = document.getElementById("az-chart-prod") as HTMLCanvasElement | null;
      if (prodEl) {
        charts.push(new Chart(prodEl, {
          type: "line",
          data: {
            labels,
            datasets: players.flatMap((m: any) => {
              const you = m.info.player_number === selPn;
              const c = colorOf(m.info.color_id);
              return [
                { label: `${m.info.name} · vils`, ...line(m.vils_series, c, you) },
                { label: `${m.info.name} · mil`, ...line(m.mil_series, c, you, true) },
              ];
            }),
          },
          options: base,
        }));
      }
      const apmEl = document.getElementById("az-chart-apm") as HTMLCanvasElement | null;
      if (apmEl) {
        charts.push(new Chart(apmEl, {
          type: "line",
          data: {
            labels,
            datasets: players.map((m: any) => ({
              label: m.info.name,
              ...line(m.apm_series, colorOf(m.info.color_id), m.info.player_number === selPn),
            })),
          },
          options: base,
        }));
      }
    }

    const civOf = (id: number) => civs[String(id)] ?? { slug: null, name: `?${id}` };
    const civCell = (id: number, size: number) => {
      const c = civOf(id);
      const icon = c.slug
        ? `<img src="/images/aoe2/Civs/${c.slug}-${size}.webp" alt="" width="${size / 2}" height="${size / 2}" class="inline-block h-[1.1em] w-auto align-[-0.15em]" loading="lazy" onerror="this.remove()" /> `
        : "";
      return `${icon}${esc(c.name)}`;
    };
    const resultOf = (won: boolean | null) =>
      won === true ? L["analyzer.result.win"] : won === false ? L["analyzer.result.loss"] : L["analyzer.result.unknown"];

    function tile(label: string, value: string, note?: string) {
      return `<div class="rounded border border-stone-700/25 bg-parchment/60 p-2.5">
        <div class="font-mono text-[10px] uppercase tracking-wide text-stone-700">${esc(label)}</div>
        <div class="mt-1 font-display text-lg font-bold text-ink">${value}</div>
        ${note ? `<div class="font-mono text-[10px] text-stone-700/80">${esc(note)}</div>` : ""}
      </div>`;
    }

    function scorecard(m: any) {
      const tiles: string[] = [];
      tiles.push(tile(L["analyzer.tile.feudal"], esc(mmss(m.feudal_ms))));
      tiles.push(tile(L["analyzer.tile.castle"], esc(mmss(m.castle_ms))));
      tiles.push(tile(L["analyzer.tile.imperial"], esc(mmss(m.imperial_ms))));
      tiles.push(tile(L["analyzer.tile.vils"], m.castle_ms != null ? esc(String(m.vils_castle)) : "—"));
      tiles.push(tile(L["analyzer.tile.idleDark"], esc(secs(m.idle_dark_ms)), L["analyzer.estimate"]));
      tiles.push(tile(L["analyzer.tile.idleFeudal"], esc(secs(m.idle_feudal_ms)), L["analyzer.estimate"]));
      tiles.push(tile(L["analyzer.tile.military"], esc(mmss(m.first_military_ms))));
      tiles.push(tile(L["analyzer.tile.apm"], esc(String(Math.round(m.apm)))));
      tiles.push(tile(L["analyzer.tile.ecoApm"], esc(String(Math.round(m.eco_apm)))));
      tiles.push(tile(L["analyzer.tile.milApm"], esc(String(Math.round(m.mil_apm)))));
      if (m.market_buys + m.market_sells > 0) {
        tiles.push(tile(L["analyzer.tile.market"], `${m.market_buys} / ${m.market_sells}`, L["analyzer.market.detail"]));
      }
      const elo = m.elo_team ?? m.elo_1v1;
      tiles.push(tile(L["analyzer.tile.elo"], elo != null ? esc(String(elo)) : "—"));
      if (m.role) tiles.push(tile(L["analyzer.tile.role"], esc(L[`analyzer.role.${m.role}`] ?? m.role)));
      if (m.float_banked > 0) {
        const w = m.float_window ? ` @ ${mmss(m.float_window[0])}–${mmss(m.float_window[1])}` : "";
        tiles.push(tile(L["analyzer.tile.float"], `~${esc(String(Math.round(m.float_banked)))}${esc(w)}`, L["analyzer.estimate"]));
      }
      if (m.find_enemy_ms != null || m.nearest_enemy_dist != null) {
        const v = m.find_enemy_ms != null ? mmss(m.find_enemy_ms) : "—";
        const d = m.nearest_enemy_dist != null ? ` · ~${Math.round(m.nearest_enemy_dist)} tiles` : "";
        tiles.push(tile(L["analyzer.tile.scouting"], `${esc(v)}${esc(d)}`));
      }
      return `<div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-4">${tiles.join("")}</div>`;
    }

    // ---- Head-to-head comparison matrix: You | Opponent | Reference ----------
    // Reference = the RESOLVED benchmark slice the engine attached per player
    // (m.reference: winners' medians + honesty labels) + winner-refs.json
    // (openings / eco-tech shares). Rows without a fair reference SAY so.
    let refsDoc: any | undefined;
    async function loadRefs() {
      if (refsDoc !== undefined) return refsDoc;
      try {
        refsDoc = await (await fetch("/winner-refs.json")).json();
      } catch {
        refsDoc = null;
      }
      return refsDoc;
    }

    // Opponent for the matrix: 1v1 = the other player (team ids can be equal in
    // unteamed 1v1s); team = mean of enemy team.
    function opponentOf(sel: any, players: any[]) {
      if (players.length === 2) {
        const other = players.find((p) => p.info.player_number !== sel.info.player_number);
        return other ? { m: other, label: other.info.name } : null;
      }
      const enemies = players.filter((p) => p.info.team_id !== sel.info.team_id);
      if (!enemies.length) return null;
      if (enemies.length === 1) return { m: enemies[0], label: enemies[0].info.name };
      const avg = (f: (m: any) => number | null) => {
        const vs = enemies.map(f).filter((v): v is number => v != null);
        return vs.length ? vs.reduce((a, b) => a + b, 0) / vs.length : null;
      };
      return {
        label: `${L["analyzer.matrix.enemyAvg"]} (${enemies.length})`,
        m: {
          info: { name: L["analyzer.matrix.enemyAvg"] },
          feudal_ms: avg((m) => m.feudal_ms), castle_ms: avg((m) => m.castle_ms),
          imperial_ms: avg((m) => m.imperial_ms),
          vils_castle: avg((m) => (m.castle_ms != null ? m.vils_castle : null)),
          idle_dark_ms: avg((m) => m.idle_dark_ms), idle_feudal_ms: avg((m) => m.idle_feudal_ms),
          first_military_ms: avg((m) => m.first_military_ms),
          apm: avg((m) => m.apm), eco_apm: avg((m) => m.eco_apm), mil_apm: avg((m) => m.mil_apm),
          float_banked: avg((m) => m.float_banked),
          market_buys: avg((m) => m.market_buys), market_sells: avg((m) => m.market_sells),
          eco_techs: [], opening: null, find_enemy_ms: avg((m) => m.find_enemy_ms),
          nearest_enemy_dist: avg((m) => m.nearest_enemy_dist), reference: null,
        },
      };
    }

    type Row = {
      label: string; you: string; opp: string; ref: string; refBasis?: string;
      // signed gaps in the metric's unit; sign convention: positive = YOU ahead
      dOpp?: number | null; dRef?: number | null;
      // colored deltas only for direction-unambiguous exact comparisons
      colored: boolean; est?: boolean; fmtDelta?: (d: number) => string;
      kind?: "time" | "count" | "score"; help?: string;
    };

    function matrixRows(sel: any, opp: any, refs: any): { group: string; rows: Row[] }[] {
      const r = sel.reference;
      const exact = r?.kind === "exact";
      const basis = r ? (L[`analyzer.matrix.basis.${r.kind}`] ?? r.kind) : "";
      const noRef = L["analyzer.matrix.noRef"];
      const dSecs = (d: number) => `${Math.abs(Math.round(d))}s`;
      const dN = (d: number) => `${Math.abs(Math.round(d))}`;
      const S = (ms: number | null | undefined, res: number) => (ms == null ? null : ms / 1000 + res);

      const age = (label: string, youMs: number | null, oppMs: number | null, refS: number | null | undefined, res: number, help?: string): Row => {
        const y = S(youMs, res);
        const o = S(oppMs, res);
        return {
          label,
          you: y != null ? mmss((y - res) * 1000 + res * 1000) : "—",
          opp: o != null ? mmss((o - res) * 1000 + res * 1000) : "—",
          ref: refS != null ? mmss(refS * 1000) : noRef,
          refBasis: refS != null ? basis : undefined,
          dOpp: y != null && o != null ? o - y : null, // positive = you faster = ahead
          dRef: exact && y != null && refS != null ? refS - y : null,
          colored: true, fmtDelta: dSecs, kind: "time", help,
        };
      };

      const eco: Row[] = [
        age(L["analyzer.tile.feudal"], sel.feudal_ms, opp?.feudal_ms, r?.feudal_s, r?.age_res_s?.[0] ?? 130, L["analyzer.help.feudal"]),
        age(L["analyzer.tile.castle"], sel.castle_ms, opp?.castle_ms, r?.castle_s, r?.age_res_s?.[1] ?? 160, L["analyzer.help.castle"]),
        age(L["analyzer.tile.imperial"], sel.imperial_ms, opp?.imperial_ms, r?.imperial_s, r?.age_res_s?.[2] ?? 190, L["analyzer.help.imperial"]),
        {
          label: L["analyzer.tile.vils"],
          you: sel.castle_ms != null ? String(sel.vils_castle) : "—",
          opp: opp?.castle_ms != null ? String(Math.round(opp.vils_castle)) : "—",
          ref: r?.vils_castle != null ? `${r.vils_castle}` : noRef,
          refBasis: r?.vils_castle != null ? basis : undefined,
          dOpp: sel.castle_ms != null && opp?.castle_ms != null ? sel.vils_castle - opp.vils_castle : null,
          dRef: exact && sel.castle_ms != null && r?.vils_castle != null ? sel.vils_castle - r.vils_castle : null,
          colored: true, fmtDelta: dN, kind: "count", help: L["analyzer.help.vils"],
        },
        {
          label: L["analyzer.tile.idleDark"], est: true,
          you: secs(sel.idle_dark_ms), opp: opp ? secs(Math.round(opp.idle_dark_ms)) : "—", ref: noRef,
          dOpp: opp ? (opp.idle_dark_ms - sel.idle_dark_ms) / 1000 : null, colored: true, fmtDelta: dSecs,
          kind: "time", help: L["analyzer.help.idleDark"],
        },
        {
          label: L["analyzer.tile.idleFeudal"], est: true,
          you: secs(sel.idle_feudal_ms), opp: opp ? secs(Math.round(opp.idle_feudal_ms)) : "—", ref: noRef,
          dOpp: opp ? (opp.idle_feudal_ms - sel.idle_feudal_ms) / 1000 : null, colored: true, fmtDelta: dSecs,
          kind: "time", help: L["analyzer.help.idleFeudal"],
        },
        {
          label: L["analyzer.tile.float"], est: true,
          you: `~${Math.round(sel.float_banked)}`, opp: opp ? `~${Math.round(opp.float_banked)}` : "—", ref: noRef,
          dOpp: opp ? opp.float_banked - sel.float_banked : null, colored: true, fmtDelta: dN,
          kind: "score", help: L["analyzer.help.float"],
        },
        {
          label: L["analyzer.tile.market"],
          you: `${sel.market_buys}/${sel.market_sells}`,
          opp: opp ? `${Math.round(opp.market_buys)}/${Math.round(opp.market_sells)}` : "—",
          ref: noRef, colored: false, help: L["analyzer.help.market"],
        },
      ];

      const wbTime = (m: any) => m?.eco_techs?.find?.((e: [number, number]) => e[0] === 213)?.[1] ?? null;
      const byCastle = (m: any) =>
        m?.eco_techs && m?.castle_ms != null
          ? m.eco_techs.filter((e: [number, number]) => e[1] <= m.castle_ms).length
          : null;
      const shares = r && refs?.ecoTechByCastle?.[r.bucket];
      const shareTxt = shares
        ? `${L["analyzer.row.winnersResearch"]}: Loom ${shares.loom}% · DBA ${shares.dba}% · WB ${shares.wheelbarrow}%`
        : noRef;
      const tech: Row[] = [
        {
          label: L["analyzer.row.ecoUpgrades"],
          you: byCastle(sel) != null ? `${byCastle(sel)}/10` : "—",
          opp: opp && byCastle(opp) != null ? `${byCastle(opp)}/10` : "—",
          ref: shareTxt, colored: false, help: L["analyzer.help.ecoUpgrades"],
        },
        {
          label: L["analyzer.row.wheelbarrow"],
          you: wbTime(sel) != null ? mmss(wbTime(sel)) : "—",
          opp: opp && wbTime(opp) != null ? mmss(wbTime(opp)) : "—",
          ref: shares ? `${shares.wheelbarrow}% ${L["analyzer.row.winnersResearch"]}` : noRef,
          colored: false, help: L["analyzer.help.wheelbarrow"],
        },
      ];

      const openRef = r && refs?.openings?.[civOf(sel.info.civ_id).slug]?.[r.bucket];
      const openTxt = openRef
        ? openRef.list.filter((o: any) => o.opening !== 'unknown').slice(0, 3).map((o: any) => `${displayUnit(o.opening.replace(/_/g, " "))} ${o.pct}%`).join(" · ")
        : noRef;
      const mil: Row[] = [
        {
          label: L["analyzer.opening"],
          you: sel.opening ?? "—", opp: opp?.opening ?? "—",
          ref: openTxt, refBasis: openRef ? L["analyzer.matrix.basis.exact"] : undefined,
          colored: false, help: L["analyzer.help.opening"],
        },
        {
          label: L["analyzer.tile.military"],
          you: mmss(sel.first_military_ms), opp: opp ? mmss(opp.first_military_ms) : "—",
          ref: noRef, colored: false, help: L["analyzer.help.military"],
        },
      ];

      const scout: Row[] = [];
      if (sel.find_enemy_ms != null || opp?.find_enemy_ms != null) {
        scout.push({
          label: L["analyzer.tile.scouting"],
          you: mmss(sel.find_enemy_ms), opp: opp ? mmss(opp.find_enemy_ms) : "—",
          ref: noRef, colored: false, help: L["analyzer.help.scouting"],
        });
      }

      const att: Row[] = [
        { label: L["analyzer.tile.apm"], you: String(Math.round(sel.apm)), opp: opp ? String(Math.round(opp.apm)) : "—", ref: noRef, colored: false, help: L["analyzer.help.apm"] },
        { label: L["analyzer.tile.ecoApm"], you: String(Math.round(sel.eco_apm)), opp: opp ? String(Math.round(opp.eco_apm)) : "—", ref: noRef, colored: false, help: L["analyzer.help.ecoApm"] },
        { label: L["analyzer.tile.milApm"], you: String(Math.round(sel.mil_apm)), opp: opp ? String(Math.round(opp.mil_apm)) : "—", ref: noRef, colored: false, help: L["analyzer.help.milApm"] },
      ];

      return [
        { group: L["analyzer.group.economy"], rows: eco },
        { group: L["analyzer.group.technology"], rows: tech },
        { group: L["analyzer.group.military"], rows: mil },
        ...(scout.length ? [{ group: L["analyzer.group.scouting"], rows: scout }] : []),
        { group: L["analyzer.group.attention"], rows: att },
      ];
    }

    // A plain-language delta pill: "3:56 behind Alper" / "6 fewer than winners at your level".
    function phrasePill(d: number | null | undefined, colored: boolean, who: string, kind?: string) {
      if (d == null) return "";
      const even = Math.abs(d) < 0.5;
      const mag = kind === "time" ? fmtGapS(d) : String(Math.abs(Math.round(d)));
      const tpl = even
        ? L["analyzer.phrase.even"]
        : d > 0
          ? (kind === "count" ? L["analyzer.phrase.more"] : L["analyzer.phrase.ahead"])
          : (kind === "count" ? L["analyzer.phrase.fewer"] : L["analyzer.phrase.behind"]);
      const txt = fill(tpl, { d: mag, who });
      const cls = !colored || even
        ? "border-stone-700/30 text-stone-700"
        : d > 0
          ? "border-forest/40 bg-forest/10 text-forest"
          : "border-royal/40 bg-royal/10 text-royal";
      return `<span class="rounded border px-1.5 py-0.5 font-mono text-[10px] ${cls}">${esc(txt)}</span>`;
    }

    // Plain-language coach paragraph — every sentence assembled from real data,
    // sentences with no data behind them are simply omitted.
    function summaryHtml(sel: any, players: any[], refs: any, meta: any) {
      const oppInfo = opponentOf(sel, players);
      const oppShort = oppInfo ? String(oppInfo.label).split(" ")[0].slice(0, 14) : L["analyzer.matrix.opp"];
      const opp = oppInfo?.m ?? null;
      const r = sel.reference;
      const exact = r?.kind === "exact";
      const refName = L["analyzer.phrase.refName"];
      const sentences: string[] = [];

      // 1) the game
      const civName = civOf(sel.info.civ_id).name;
      const dur = mmss(meta.duration_ms);
      sentences.push(
        sel.info.won == null
          ? fill(L["analyzer.sum.gameUndecided"], { civ: civName, map: meta.map_name, dur })
          : fill(L["analyzer.sum.game"], { civ: civName, map: meta.map_name, dur, result: resultOf(sel.info.won).toLowerCase() }),
      );

      // 2) biggest age-up gap (comp-adjusted, same math as the matrix)
      const ages: Array<[string, number | null, number | null, number | null | undefined, number]> = [
        [L["analyzer.tile.feudal"], sel.feudal_ms, opp?.feudal_ms ?? null, r?.feudal_s, r?.age_res_s?.[0] ?? 130],
        [L["analyzer.tile.castle"], sel.castle_ms, opp?.castle_ms ?? null, r?.castle_s, r?.age_res_s?.[1] ?? 160],
        [L["analyzer.tile.imperial"], sel.imperial_ms, opp?.imperial_ms ?? null, r?.imperial_s, r?.age_res_s?.[2] ?? 190],
      ];
      let worst: { label: string; you: string; dOpp: number | null; dRef: number | null; score: number } | null = null;
      let best: { label: string; d: number; who: string } | null = null;
      for (const [label, youMs, oppMs, refS, res] of ages) {
        if (youMs == null) continue;
        const y = youMs / 1000 + res;
        const dOpp = oppMs != null ? oppMs / 1000 + res - y : null;
        const dRef = exact && refS != null ? refS - y : null;
        const score = Math.min(dOpp ?? 0, dRef ?? 0);
        if (score < -30 && (!worst || score < worst.score)) {
          worst = { label, you: mmss(y * 1000), dOpp, dRef, score };
        }
        const up = Math.max(dOpp ?? 0, dRef ?? 0);
        if (up > 30 && (!best || up > best.d)) {
          best = { label, d: up, who: (dOpp ?? 0) >= (dRef ?? 0) ? oppShort : refName };
        }
      }
      if (worst) {
        const parts: string[] = [];
        if (worst.dOpp != null && worst.dOpp < -30) parts.push(fill(L["analyzer.phrase.behind"], { d: fmtGapS(worst.dOpp), who: oppShort }));
        if (worst.dRef != null && worst.dRef < -30) parts.push(fill(L["analyzer.phrase.behind"], { d: fmtGapS(worst.dRef), who: refName }));
        if (parts.length) {
          sentences.push(fill(L["analyzer.sum.biggestGap"], { age: worst.label, you: worst.you, vsOpp: parts[0], vsRef: parts[1] ? `, ${parts[1]}` : "" }));
        }
      }

      // 3) TC idle cost (only when meaningful)
      const idle = sel.idle_dark_ms + sel.idle_feudal_ms;
      if (idle > 60_000) {
        sentences.push(fill(L["analyzer.sum.idle"], { total: fmtGapS(idle / 1000), n: String(Math.round(idle / 25_000)) }));
      }

      // 4) one genuine positive
      const openRef = r && refs?.openings?.[civOf(sel.info.civ_id).slug]?.[r.bucket];
      const topOpen = openRef?.list?.filter((o: any) => o.opening !== "unknown").slice(0, 2) ?? [];
      const openMatch = sel.opening && topOpen.some((o: any) =>
        sel.opening.toLowerCase().includes(o.opening.replace(/_/g, " ").split(" ")[0]));
      if (openMatch) {
        sentences.push(fill(L["analyzer.sum.positive"], { what: fill(L["analyzer.sum.openingGood"], { opening: sel.opening }) }));
      } else if (best) {
        sentences.push(fill(L["analyzer.sum.positive"], {
          what: fill(L["analyzer.sum.aheadBit"], { phrase: `${best.label}: ${fill(L["analyzer.phrase.ahead"], { d: fmtGapS(best.d), who: best.who })}` }),
        }));
      }

      return `<div class="mt-5 rounded border-l-4 border-gold-500 bg-gold-500/10 px-4 py-3">
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-gold-700">${esc(L["analyzer.summary"])}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink">${sentences.map(esc).join(" ")}</p>
        </div>`;
    }

    function matrixHtml(sel: any, players: any[], refs: any) {
      const oppInfo = opponentOf(sel, players);
      const oppShort = oppInfo ? String(oppInfo.label).split(" ")[0].slice(0, 14) : L["analyzer.matrix.opp"];
      const groups = matrixRows(sel, oppInfo?.m ?? null, refs);
      const sections = groups
        .map(({ group, rows }) => {
          const colored = rows.filter((x) => x.colored);
          const aheadO = colored.filter((x) => (x.dOpp ?? 0) > 0 && x.dOpp != null).length;
          const behindO = colored.filter((x) => x.dOpp != null && x.dOpp < 0).length;
          const aheadR = colored.filter((x) => x.dRef != null && x.dRef > 0).length;
          const behindR = colored.filter((x) => x.dRef != null && x.dRef < 0).length;
          const verdict = aheadO + behindO + aheadR + behindR
            ? `${L["analyzer.matrix.vsOpp"]}: ${aheadO} ${L["analyzer.matrix.ahead"]} / ${behindO} ${L["analyzer.matrix.behind"]}` +
              (aheadR + behindR ? ` · ${L["analyzer.matrix.vsRef"]}: ${aheadR} ${L["analyzer.matrix.ahead"]} / ${behindR} ${L["analyzer.matrix.behind"]}` : "")
            : "";
          const body = rows
            .map((x) => `<div class="border-b border-stone-700/10 py-1.5 last:border-b-0">
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  <span class="font-display text-[13px] font-bold text-ink${x.help ? " cursor-help border-b border-dotted border-stone-700/40" : ""}"${x.help ? ` title="${esc(x.help)}"` : ""}>${esc(x.label)}${x.est ? ' <span class="font-mono text-[9px] text-stone-700/70">~</span>' : ""}</span>
                  ${phrasePill(x.dOpp, x.colored, oppShort, x.kind)}
                  ${phrasePill(x.dRef, x.colored, L["analyzer.phrase.refName"], x.kind)}
                </div>
                <div class="mt-0.5 font-mono text-[11px] text-stone-700">
                  ${esc(L["analyzer.matrix.you"])} <span class="text-ink">${esc(x.you)}</span>
                  · ${esc(oppShort)} <span class="text-ink">${esc(x.opp)}</span>
                  · ${esc(L["analyzer.matrix.winnersShort"])} <span class="text-ink">${x.ref === L["analyzer.matrix.noRef"] ? "—" : esc(x.ref)}</span>${x.refBasis ? ` <span class="text-[9px] text-stone-700/70">[${esc(x.refBasis)}]</span>` : ""}
                </div>
              </div>`)
            .join("");
          return `<div class="rounded border border-stone-700/25 bg-parchment/60 px-3 py-2">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h4 class="font-display text-sm font-bold uppercase tracking-wide text-gold-700">${esc(group)}</h4>
                <span class="font-mono text-[10px] text-stone-700/80">${esc(verdict)}</span>
              </div>
              <div class="mt-1">${body}</div>
            </div>`;
        })
        .join("");
      const oppNote = oppInfo && players.length > 2 ? ` · ${esc(L["analyzer.matrix.opp"])}: ${esc(oppInfo.label)}` : "";
      return `<h3 class="mt-8 font-display text-xl text-ink">${esc(L["analyzer.matrix"])}</h3>
        <p class="mt-1 text-xs text-stone-700/80">${esc(L["analyzer.matrix.note"])}${oppNote}</p>
        <div class="mt-2 grid gap-2.5 lg:grid-cols-2">${sections}</div>`;
    }

    // "What winners build" — lazily fetched static benchmark (public/winner-comps.json,
    // derived from 60M match_ages rows: ranked 1v1 winners per civ × elo bucket).
    let compsDoc: any | undefined;
    async function loadComps() {
      if (compsDoc !== undefined) return compsDoc;
      try {
        compsDoc = await (await fetch("/winner-comps.json")).json();
      } catch {
        compsDoc = null; // file absent/offline — section simply doesn't render
      }
      return compsDoc;
    }
    // mirror of scripts/data-pipeline/lib/buckets.mjs eloBucket (client copy)
    const eloBucketOf = (r: number) =>
      r < 1000 ? "<1000" : r < 1200 ? "1000-1199" : r < 1400 ? "1200-1399" : r < 1650 ? "1400-1649"
      : r < 1800 ? "1650-1799" : r < 2000 ? "1800-1999" : r < 2200 ? "2000-2199" : r < 2500 ? "2200-2499" : "2500+";

    async function winnersBlock(sel: any, mode: string) {
      const elo = mode === "team" ? (sel.elo_team ?? sel.elo_1v1) : (sel.elo_1v1 ?? sel.elo_team);
      const slug = civOf(sel.info.civ_id).slug;
      if (elo == null || !slug) return "";
      const doc = await loadComps();
      const cell = doc?.civs?.[slug]?.[eloBucketOf(elo)];
      if (!cell?.units?.length) return "";
      const chips = cell.units
        .map(
          (u: any) => `<span class="inline-flex items-center gap-1.5 rounded border border-stone-700/25 bg-parchment px-2 py-1 text-xs text-ink">${esc(displayUnit(u.unit))} <span class="font-mono text-gold-700">${esc(String(u.pct))}%</span> <span class="font-mono text-[10px] text-stone-700/50">·</span> <span class="font-mono text-[10px] text-stone-700/80">~${esc(String(Math.round(u.med)))}</span></span>`,
        )
        .join("");
      return `<h3 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-stone-700">${esc(L["analyzer.winners"])}</h3>
        <p class="mt-1 text-xs text-stone-700/80">${esc(L["analyzer.winners.note"])}</p>
        <p class="mt-1 font-mono text-[10px] text-stone-700/70">${esc(L["analyzer.medianLegend"])}</p>
        <div class="mt-2 flex flex-wrap gap-2">${chips}</div>`;
    }
    const displayUnit = (u: string) => u.replace(/\b\w/g, (c) => c.toUpperCase());
    const fill = (tpl: string, vars: Record<string, string>) =>
      String(tpl ?? "").replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");
    const fmtGapS = (d: number) => (Math.abs(d) >= 90 ? mmss(Math.abs(d) * 1000) : `${Math.abs(Math.round(d))}s`);

    // Within-match superlatives — factual comparisons between THIS game's players
    // only (no invented thresholds). Strict winners; ties get no badge.
    function badges(players: any[]) {
      if (players.length < 2) return "";
      const award = (key: string, value: (m: any) => number | null, best: "min" | "max") => {
        const vals = players.map((m) => value(m)).map((v) => (v == null ? null : v));
        const cmp = best === "min" ? Math.min : Math.max;
        const present = vals.filter((v): v is number => v != null);
        if (!present.length) return null;
        const target = cmp(...present);
        const winners = vals.map((v, i) => (v === target ? i : -1)).filter((i) => i >= 0);
        if (winners.length !== 1) return null;
        return { key, who: players[winners[0]] };
      };
      const found = [
        award("analyzer.badge.fastestCastle", (m) => m.castle_ms, "min"),
        award("analyzer.badge.mostVils", (m) => (m.castle_ms != null ? m.vils_castle : null), "max"),
        award("analyzer.badge.highestApm", (m) => m.apm, "max"),
        award("analyzer.badge.cleanestTc", (m) => (m.feudal_ms != null && m.castle_ms != null ? m.idle_dark_ms + m.idle_feudal_ms : null), "min"),
        award("analyzer.badge.firstMilitary", (m) => m.first_military_ms, "min"),
        award("analyzer.badge.marketRegular", (m) => (m.market_buys + m.market_sells > 0 ? m.market_buys + m.market_sells : null), "max"),
      ].filter(Boolean) as Array<{ key: string; who: any }>;
      if (!found.length) return "";
      return `<h3 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-stone-700">${esc(L["analyzer.badges"])}</h3>
        <div class="mt-2 flex flex-wrap gap-2">${found
          .map(
            (b) => `<span class="inline-flex items-center gap-1.5 rounded border border-gold-500/40 bg-gold-500/10 px-2 py-1 text-xs text-ink">🏅 <strong class="font-display">${esc(L[b.key])}</strong><span class="text-stone-700">·</span><span class="flex items-center gap-1"><span class="inline-block h-2 w-2 rounded-sm" style="background:${colorOf(b.who.info.color_id)}"></span>${esc(b.who.info.name)}</span></span>`,
          )
          .join("")}</div>`;
    }

    // Watched eco upgrades: researched ones with their time, the rest greyed out.
    function ecoRow(m: any) {
      const done = new Map<number, number>(m.eco_techs.map((e: [number, number]) => [e[0], e[1]]));
      const ordered = Object.entries(ecoTechs).sort(([a], [b]) => {
        const ta = done.get(Number(a)), tb = done.get(Number(b));
        if (ta != null && tb != null) return ta - tb; // researched: by time
        if (ta != null) return -1;
        if (tb != null) return 1;
        return 0; // unresearched: keep stable order, after researched
      });
      const chips = ordered.map(([id, name]) => {
        const at = done.get(Number(id));
        return at != null
          ? `<span class="inline-flex items-center gap-1.5 rounded border border-stone-700/25 bg-parchment px-2 py-1 text-xs text-ink">${esc(name)} <span class="font-mono text-gold-700">${esc(mmss(at))}</span></span>`
          : `<span class="inline-flex items-center gap-1.5 rounded border border-dashed border-stone-700/25 px-2 py-1 text-xs text-stone-700/70">${esc(name)} <span class="font-mono text-[10px]">${esc(L["analyzer.eco.missing"])}</span></span>`;
      });
      return `<h3 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-stone-700">${esc(L["analyzer.eco"])}</h3>
        <div class="mt-2 flex flex-wrap gap-2">${chips.join("")}</div>`;
    }

    function findingsList(pn: number) {
      const sevStyle: Record<string, string> = {
        high: "bg-royal text-parchment",
        med: "bg-gold-500 text-ink",
        low: "bg-stone-700/30 text-ink",
      };
      const rows = report.findings
        .filter((f: any) => f.player_number === pn)
        .map((f: any) => {
          const basis = f.basis && f.basis !== "absolute" ? ` <span class="font-mono text-[10px] text-stone-700/80">[${esc(L[`analyzer.basis.${f.basis}`] ?? f.basis)}]</span>` : "";
          return `<li class="flex items-start gap-2.5 border-b border-stone-700/15 py-2 last:border-b-0">
            <span class="mt-0.5 inline-block rounded px-1.5 font-mono text-[10px] uppercase ${sevStyle[f.severity] ?? sevStyle.low}">${esc(L[`analyzer.sev.${f.severity}`] ?? f.severity)}</span>
            <span class="text-sm text-ink"><strong class="font-display">${esc(f.metric)}</strong> — ${esc(L["analyzer.you"])} <span class="font-mono">${esc(f.your)}</span> (${esc(L["analyzer.ref"])} <span class="font-mono">${esc(f.reference)}</span>)${basis}<br /><span class="text-stone-700">${esc(f.note)}</span></span>
          </li>`;
        });
      if (!rows.length) return `<p class="text-sm text-forest">${esc(L["analyzer.noFindings"])}</p>`;
      return `<ul>${rows.join("")}</ul>`;
    }

    function render(scrollToReport = false) {
      const meta = report.meta;
      const players = report.players;
      const sel = players.find((p: any) => p.info.player_number === selectedPn) ?? players[0];
      const selPn = sel.info.player_number;

      const options = players
        .map((p: any) => `<option value="${p.info.player_number}" ${p.info.player_number === selPn ? "selected" : ""}>${esc(p.info.name)}</option>`)
        .join("");

      const tableRows = players
        .map((m: any) => {
          const you = m.info.player_number === selPn;
          const elo = m.elo_team ?? m.elo_1v1;
          return `<tr data-pn="${m.info.player_number}" class="cursor-pointer border-b border-stone-700/15 last:border-b-0 ${you ? "bg-gold-500/15" : "hover:bg-gold-500/10"}">
            <td class="sticky left-0 bg-parchment px-2 py-1.5 font-display font-bold text-ink"><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm align-baseline" style="background:${colorOf(m.info.color_id)}"></span>${you ? "➤ " : ""}${esc(m.info.name)}</td>
            <td class="px-2 py-1.5">${civCell(m.info.civ_id, 24)}</td>
            <td class="px-2 py-1.5 text-xs">${m.opening ? esc(m.opening) : "—"}</td>
            <td class="px-2 py-1.5 font-mono">${esc(mmss(m.feudal_ms))}</td>
            <td class="px-2 py-1.5 font-mono">${esc(mmss(m.castle_ms))}</td>
            <td class="px-2 py-1.5 font-mono">${esc(mmss(m.imperial_ms))}</td>
            <td class="px-2 py-1.5 font-mono">${m.castle_ms != null ? esc(String(m.vils_castle)) : "—"}</td>
            <td class="px-2 py-1.5 font-mono">${esc(secs(m.idle_dark_ms))}</td>
            <td class="px-2 py-1.5 font-mono">${esc(String(Math.round(m.apm)))}</td>
            <td class="px-2 py-1.5 font-mono">${elo != null ? esc(String(elo)) : "—"}</td>
            <td class="px-2 py-1.5">${m.info.won === true ? `<span class="text-forest">${esc(L["analyzer.table.win"])}</span>` : m.info.won === false ? `<span class="text-royal">${esc(L["analyzer.table.loss"])}</span>` : "—"}</td>
          </tr>`;
        })
        .join("");

      reportEl.innerHTML = `
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b-2 border-gold-500/60 pb-3">
          <h2 class="font-display text-2xl text-ink">${esc(meta.map_name)}</h2>
          <span class="rounded border border-stone-700/30 px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-stone-700">${esc(meta.family)}</span>
          <span class="font-mono text-sm text-stone-700">${esc(meta.mode)} · ${players.length} ${esc(L["analyzer.players"])} · ${esc(L["analyzer.duration"])} ${esc(mmss(meta.duration_ms))}</span>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <label class="font-mono text-[11px] uppercase tracking-wide text-stone-700">${esc(L["analyzer.viewAs"])}
            <select id="az-viewas" class="ml-2 rounded border border-stone-700/40 bg-parchment px-2 py-1 font-body text-sm text-ink">${options}</select>
          </label>
          <span class="font-display text-lg font-bold ${sel.info.won === true ? "text-forest" : sel.info.won === false ? "text-royal" : "text-stone-700"}" ${sel.info.won == null ? `title="${esc(L["analyzer.result.note"])}"` : ""}>${esc(resultOf(sel.info.won))}</span>
          <span class="text-sm text-stone-700">${civCell(sel.info.civ_id, 24)}</span>
          ${sel.opening ? `<span class="rounded border border-gold-500/50 bg-gold-500/10 px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-gold-700">${esc(L["analyzer.opening"])}: ${esc(sel.opening)}</span>` : ""}
        </div>
        ${sel.info.won == null ? `<p class="mt-1 text-xs text-stone-700/80">${esc(L["analyzer.result.note"])}</p>` : ""}
        <div id="az-summary"></div>

        <div class="mt-4">${scorecard(sel)}</div>
        <div id="az-matrix"></div>
        ${ecoRow(sel)}
        <div id="az-winners"></div>
        ${badges(players)}

        <h3 class="mt-8 font-display text-xl text-ink">${esc(L["analyzer.charts.production"])}</h3>
        <p class="mt-1 text-xs text-stone-700/80">${esc(L["analyzer.charts.productionNote"])}</p>
        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          ${players.map((m: any) => `<span class="flex items-center gap-1.5 font-mono text-[11px] text-stone-700"><span class="inline-block h-2.5 w-2.5 rounded-sm" style="background:${colorOf(m.info.color_id)}"></span>${esc(m.info.name)}</span>`).join("")}
        </div>
        <div class="mt-2 h-64 rounded border border-stone-700/25 bg-parchment/60 p-3"><canvas id="az-chart-prod" role="img" aria-label="${esc(L["analyzer.chartProdLabel"])}"></canvas></div>
        <h3 class="mt-6 font-display text-xl text-ink">${esc(L["analyzer.charts.apm"])}</h3>
        <div class="mt-2 h-48 rounded border border-stone-700/25 bg-parchment/60 p-3"><canvas id="az-chart-apm" role="img" aria-label="${esc(L["analyzer.chartApmLabel"])}"></canvas></div>

        <h3 class="mt-8 font-display text-xl text-ink">${esc(L["analyzer.fixes"])}</h3>
        <div class="mt-2 rounded border border-stone-700/25 bg-parchment/60 px-4 py-2">${findingsList(selPn)}</div>

        <h3 class="mt-8 font-display text-xl text-ink">${esc(L["analyzer.table.title"])}</h3>
        <div class="mt-2 overflow-x-auto rounded border border-stone-700/25">
          <table class="w-full min-w-[860px] text-left text-sm">
            <thead><tr class="border-b border-stone-700/30 bg-parchment/80 font-mono text-[10px] uppercase tracking-wide text-stone-700">
              <th class="sticky left-0 bg-parchment/95 px-2 py-2">${esc(L["analyzer.table.player"])}</th><th class="px-2 py-2">${esc(L["analyzer.table.civ"])}</th>
              <th class="px-2 py-2">${esc(L["analyzer.opening"])}</th>
              <th class="px-2 py-2">${esc(L["analyzer.tile.feudal"])}</th><th class="px-2 py-2">${esc(L["analyzer.tile.castle"])}</th>
              <th class="px-2 py-2">${esc(L["analyzer.tile.imperial"])}</th><th class="px-2 py-2">${esc(L["analyzer.tile.vils"])}</th>
              <th class="px-2 py-2">${esc(L["analyzer.tile.idleDark"])}</th><th class="px-2 py-2">${esc(L["analyzer.tile.apm"])}</th>
              <th class="px-2 py-2">${esc(L["analyzer.tile.elo"])}</th><th class="px-2 py-2">${esc(L["analyzer.table.result"])}</th>
            </tr></thead>
            <tbody>${tableRows}</tbody>
          </table>
        </div>

        <h4 class="mt-6 font-display text-sm font-bold uppercase tracking-wide text-stone-700">${esc(L["analyzer.notes"])}</h4>
        <ul class="mt-1 list-disc pl-5 text-xs text-stone-700">
          ${report.caveats.map((c: string) => `<li>${esc(c)}</li>`).join("")}
        </ul>
      `;
      reportEl.classList.remove("hidden");

      reportEl.querySelector("#az-viewas")!.addEventListener("change", (e) => {
        selectedPn = Number((e.target as HTMLSelectElement).value);
        render();
      });
      for (const tr of reportEl.querySelectorAll("tbody tr[data-pn]")) {
        tr.addEventListener("click", () => {
          selectedPn = Number((tr as HTMLElement).dataset.pn);
          render();
        });
      }
      drawCharts(players, selPn);
      // async fills: head-to-head matrix (needs winner-refs) + winners benchmark
      loadRefs().then((refs) => {
        const sHolder = reportEl.querySelector("#az-summary");
        if (sHolder) sHolder.innerHTML = summaryHtml(sel, players, refs, meta);
        const holder = reportEl.querySelector("#az-matrix");
        if (holder) holder.innerHTML = matrixHtml(sel, players, refs);
      });
      winnersBlock(sel, meta.mode).then((html) => {
        const holder = reportEl.querySelector("#az-winners");
        if (holder && html) holder.innerHTML = html;
      });
      if (scrollToReport) reportEl.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    async function analyze(file: File) {
      errBox.classList.add("hidden");
      reportEl.classList.add("hidden");
      statusEl.classList.remove("hidden");
      statusEl.textContent = L["analyzer.parsing"];
      try {
        const mod = await loadWasm();
        const bytes = new Uint8Array(await file.arrayBuffer());
        const json = mod.analyze_replay(bytes, "");
        report = JSON.parse(json);
        selectedPn = report.meta.you;
        statusEl.classList.add("hidden");
        render(true);
      } catch (e: any) {
        statusEl.classList.add("hidden");
        // raw parser errors carry backtraces/ANSI — log them, show a friendly line
        console.error("analyze failed:", e);
        errMsg.textContent = L["analyzer.error.parse"];
        errBox.classList.remove("hidden");
      }
    }

    drop.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("label")) return; // native input click
      fileInput.click();
    });
    fileInput.addEventListener("change", () => {
      const f = fileInput.files?.[0];
      fileInput.value = ""; // allow re-selecting the same file
      if (f) analyze(f);
    });
    for (const ev of ["dragover", "dragenter"]) {
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.dataset.over = "true";
      });
    }
    for (const ev of ["dragleave", "drop"]) {
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        delete drop.dataset.over;
      });
    }
    drop.addEventListener("drop", (e) => {
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) analyze(f);
    });

    // Rebuild already-rendered charts with theme-appropriate colors when the
    // site's light/dark toggle flips html[data-theme].
    new MutationObserver(() => {
      if (lastPlayers) drawCharts(lastPlayers, lastSelPn);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  </script>
</BaseLayout>
