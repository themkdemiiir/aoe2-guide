---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import BuildOrderSteps from "@/components/content/BuildOrderSteps.astro";
import Badge from "@/components/ui/Badge.astro";
import Icon from "@/components/ui/Icon.astro";
import Stat from "@/components/ui/Stat.astro";
import civDataJson from "@data/civilizations.json";
import { getCollection } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";

export async function getStaticPaths() {
  const builds = await getCollection("build-orders");
  return locales.flatMap((lang) => builds.map((b) => ({ params: { lang, build: b.id } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.build as string;
const entry = (await getCollection("build-orders")).find((b) => b.id === slug);
if (!entry) return Astro.redirect("/404");

const civs = (civDataJson as { civs: Array<{ slug: string; specialty?: string; meta?: { tier?: string | null } }> }).civs;
const civBySlug = new Map(civs.map((civ) => [civ.slug, civ]));
const recommendedCivs = entry.data.civsRecommended.map((civSlug) => ({
  slug: civSlug,
  meta: civBySlug.get(civSlug),
}));

const difficultyVariant = entry.data.difficulty === "beginner" ? "success" : entry.data.difficulty === "advanced" ? "destructive" : "default";
const civName = (s: string) => s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const minutes = t(lang, "home.minutes");
const popValues = entry.data.steps.map((s) => s.villagers).filter((v): v is number => v != null);
const firstPop = popValues[0] ?? "-";
const finalPop = popValues.at(-1) ?? "-";

const ageLabel: Record<string, string> = { feudal: "Feudal Age", castle: "Castle Age", imperial: "Imperial Age" };
const difficultyLabel: Record<string, string> = { beginner: "Beginner", intermediate: "Intermediate", advanced: "Advanced" };
const description = `${entry.data.name[lang]} — ${difficultyLabel[entry.data.difficulty]} AoE2 build order targeting ${ageLabel[entry.data.targetAge]} in ~${entry.data.durationMin} minutes. Step-by-step villager assignments.`;

const howToLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: entry.data.name[lang],
  description,
  totalTime: `PT${entry.data.durationMin}M`,
  step: entry.data.steps.map((step, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    name: step.assign[lang],
    text: step.note?.[lang] ? `${step.assign[lang]} — ${step.note[lang]}` : step.assign[lang],
  })),
};
---
<BaseLayout title={entry.data.name[lang]} description={description} canonicalPath={`/builds/${slug}`}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howToLd).replace(/</g, "\\u003c")} />
  </Fragment>
  <article class="mx-auto max-w-6xl px-4 py-10">
    <header class="rounded border border-stone-700/40 bg-parchment p-5 shadow-sm">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div>
          <div class="flex flex-wrap gap-2">
            <Badge variant={difficultyVariant}>{t(lang, `difficulty.${entry.data.difficulty}`)}</Badge>
            <Badge variant="outline">{t(lang, `age.${entry.data.targetAge}`)} {t(lang, "builds.targetBadge")}</Badge>
            <Badge variant="secondary">~{entry.data.durationMin} {minutes}</Badge>
          </div>
          <h1 class="mt-4 font-display text-4xl text-ink sm:text-5xl">{entry.data.name[lang]}</h1>
          {entry.data.source && (
            <p class="mt-3 text-sm text-stone-700">
              {t(lang, "builds.source")}: {entry.data.source.url
                ? <a href={entry.data.source.url} class="font-medium underline hover:text-gold-500">{entry.data.source.author}</a>
                : <span class="font-medium text-ink">{entry.data.source.author}</span>}
            </p>
          )}
        </div>

        <dl class="grid grid-cols-3 gap-3 rounded border border-stone-700/30 bg-stone-700/5 p-3 lg:grid-cols-1">
          <Stat label={t(lang, "filter.difficulty")} tone="highlight">{t(lang, `difficulty.${entry.data.difficulty}`)}</Stat>
          <Stat label={t(lang, "filter.age")}>{t(lang, `age.${entry.data.targetAge}`)}</Stat>
          <Stat label={t(lang, "builds.duration")}>~{entry.data.durationMin} {minutes}</Stat>
        </dl>
      </div>

      {recommendedCivs.length > 0 && (
        <div class="mt-5 border-t border-stone-700/20 pt-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-700">{t(lang, "maps.recommendedCivs")}</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {recommendedCivs.map(({ slug: civSlug, meta }) => (
              <a
                href={localizedPath(`/civs/${civSlug}`, lang)}
                class="inline-flex items-center gap-2 rounded border border-stone-700/30 bg-parchment/70 px-2 py-1 text-sm text-ink hover:border-gold-500 hover:text-gold-500"
              >
                <Icon slug={civSlug} kind="civ" size={28} />
                <span>{civName(civSlug)}</span>
                {meta?.meta?.tier && <span class="text-xs text-stone-700">{t(lang, "matchups.tier")} {meta.meta.tier}</span>}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <section>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-3xl text-ink">{t(lang, "builds.stepTimeline")}</h2>
            <p class="mt-1 text-sm text-stone-700">{t(lang, "builds.stepTimelineSub")}</p>
          </div>
        </div>
        <div class="mt-4"><BuildOrderSteps steps={entry.data.steps} lang={lang} slug={slug} /></div>
      </section>

      <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
        <section class="rounded border border-stone-700/40 bg-parchment p-4">
          <h2 class="font-display text-xl text-ink">{t(lang, "builds.atGlance")}</h2>
          <dl class="mt-3 space-y-3">
            <Stat label={t(lang, "builds.steps")}>{entry.data.steps.length}</Stat>
            <Stat label={t(lang, "builds.firstPop")}>{firstPop}</Stat>
            <Stat label={t(lang, "builds.finalPop")}>{finalPop}</Stat>
          </dl>
        </section>
      </aside>
    </div>

    <section class="prose prose-stone mt-10 max-w-none rounded border border-stone-700/30 bg-parchment px-5 py-6">
      <h2 class="font-display text-3xl text-ink">{t(lang, "builds.strategyNotes")}</h2>
      {entry.data.intro?.[lang] && (
        <p class="mt-2 text-stone-700">{entry.data.intro[lang]}</p>
      )}
      {entry.data.strategy?.[lang] && (
        <ul class="mt-4 list-inside list-disc space-y-2 text-ink">
          {entry.data.strategy[lang].map((point) => <li>{point}</li>)}
        </ul>
      )}
    </section>
  </article>
</BaseLayout>
