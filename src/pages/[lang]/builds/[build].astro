---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import BuildOrderSteps from "@/components/content/BuildOrderSteps.astro";
import Badge from "@/components/ui/Badge.astro";
import Icon from "@/components/ui/Icon.astro";
import JsonLd from "@/components/ui/JsonLd.astro";
import civMeta from "@data/civ-meta.json";
import { getCollection } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { displayName } from "@/lib/display";
import { marked } from "marked";

export async function getStaticPaths() {
  const builds = await getCollection("build-orders");
  return locales.flatMap((lang) => builds.map((b) => ({ params: { lang, build: b.id } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.build as string;
const entry = (await getCollection("build-orders")).find((b) => b.id === slug);
if (!entry) return Astro.redirect("/404");

const civTier = (s: string): string | null =>
  (civMeta.civs as Record<string, { "1v1"?: { tier?: string } | null }>)[s]?.["1v1"]?.tier ?? null;
const recommendedCivs = entry.data.civsRecommended.map((civSlug) => ({
  slug: civSlug,
  tier: civTier(civSlug),
}));

const difficultyVariant = entry.data.difficulty === "beginner" ? "success" : entry.data.difficulty === "advanced" ? "destructive" : "default";
const minutes = t(lang, "home.minutes");
const popValues = entry.data.steps.map((s) => s.villagers).filter((v): v is number => v != null);
const firstPop = popValues[0] ?? "-";
const finalPop = popValues.at(-1) ?? "-";

const diff = t(lang, `difficulty.${entry.data.difficulty}`);
const age = t(lang, `age.${entry.data.targetAge}`);
const description = lang === "tr"
  ? `${entry.data.name.tr} — ${diff} seviye AoE2 build order'ı; ~${entry.data.durationMin} dakikada ${age} hedefler. Adım adım köylü görevlendirmeleri.`
  : `${entry.data.name.en} — ${diff} AoE2 build order targeting ${age} in ~${entry.data.durationMin} minutes. Step-by-step villager assignments.`;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://aoe2guide.com";
// HowTo: the semantically exact type for a step-by-step build order. Google
// retired the HowTo rich result in 2023, but it remains valid schema.org and is
// the clearest signal for AI/LLM crawlers reading the villager assignments.
const howToLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: entry.data.name[lang],
  description,
  inLanguage: lang,
  url: `${site}/${lang}/builds/${slug}/`,
  ...(entry.data.durationMin ? { totalTime: `PT${entry.data.durationMin}M` } : {}),
  step: entry.data.steps.map((s, i) => ({
    "@type": "HowToStep",
    position: i + 1,
    text: [s.assign[lang], s.note?.[lang]].filter(Boolean).join(" — "),
    ...(s.villagers != null ? { name: `${s.villagers} pop` } : {}),
  })),
};
---
<BaseLayout title={`${entry.data.name[lang]} — AoE2 Build Order`} breadcrumbName={entry.data.name[lang]} description={description} canonicalPath={`/builds/${slug}`}>
  <JsonLd slot="head" data={howToLd} />
  <article class="mx-auto max-w-6xl px-4 py-6">
    <header class="rounded border border-stone-700/40 bg-parchment p-4 shadow-sm">
      <div class="flex flex-wrap gap-2">
        <Badge variant={difficultyVariant}>{t(lang, `difficulty.${entry.data.difficulty}`)}</Badge>
        <Badge variant="outline">{`${t(lang, `age.${entry.data.targetAge}`)} ${t(lang, "builds.targetBadge")}`}</Badge>
        <Badge variant="secondary">~{entry.data.durationMin} {minutes}</Badge>
      </div>
      <h1 class="mt-4 font-display text-3xl text-ink sm:text-4xl">{entry.data.name[lang]}</h1>
      <p class="mt-2 text-sm font-medium text-stone-700">
        {t(lang, "builds.steps")} {entry.data.steps.length}
        <span class="mx-1.5 text-stone-700/50">·</span>
        {firstPop} → {finalPop} {t(lang, "builds.pop")}
        <span class="mx-1.5 text-stone-700/50">·</span>
        ~{entry.data.durationMin} {minutes}
      </p>
      {entry.data.source && (
        <p class="mt-3 text-sm text-stone-700">
          {t(lang, "builds.source")}: {entry.data.source.url
            ? <a href={entry.data.source.url} class="font-medium underline hover:text-gold-500">{entry.data.source.author}</a>
            : <span class="font-medium text-ink">{entry.data.source.author}</span>}
        </p>
      )}

      {recommendedCivs.length > 0 && (
        <div class="mt-5 border-t border-stone-700/20 pt-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-700">{t(lang, "maps.recommendedCivs")}</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {recommendedCivs.map(({ slug: civSlug, tier }) => (
              <a
                href={localizedPath(`/civs/${civSlug}`, lang)}
                class="inline-flex items-center gap-2 rounded border border-stone-700/30 bg-parchment/70 px-2 py-1 text-sm text-ink hover:border-gold-500 hover:text-gold-500"
              >
                <Icon slug={civSlug} kind="civ" size={28} />
                <span>{displayName(civSlug)}</span>
                {tier && <span class="text-xs text-stone-700">{t(lang, "matchups.tier")} {tier}</span>}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    {entry.data.intro?.[lang] && (
      <div class="prose prose-stone mt-6 max-w-none text-stone-700" set:html={marked.parse(entry.data.intro[lang]) as string} />
    )}

    <section class="mt-6">
      <h2 class="font-display text-2xl text-ink">{t(lang, "builds.stepTimeline")}</h2>
      <p class="mt-1 text-sm text-stone-700">{t(lang, "builds.stepTimelineSub")}</p>
      <div class="mt-4"><BuildOrderSteps steps={entry.data.steps} lang={lang} slug={slug} /></div>
    </section>

    {entry.data.strategy?.[lang] && (
      <section class="prose prose-stone mt-6 max-w-none rounded border border-stone-700/30 bg-parchment px-4 py-4">
        <h2 class="font-display text-2xl text-ink">{t(lang, "builds.strategyNotes")}</h2>
        <ul class="mt-4 list-inside list-disc space-y-2 text-ink">
          {entry.data.strategy[lang].map((point) => <li set:html={marked.parseInline(point) as string} />)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
