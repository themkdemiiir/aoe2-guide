---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import BuildOrderSteps from "@/components/content/BuildOrderSteps.astro";
import Badge from "@/components/ui/Badge.astro";
import Icon from "@/components/ui/Icon.astro";
import Stat from "@/components/ui/Stat.astro";
import civDataJson from "@data/civilizations.json";
import { render } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug, getLocalizedEntry } from "@/lib/content";

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; build: string } }> = [];
  for (const lang of locales) {
    const builds = await getLocalizedEntries("build-orders", lang);
    for (const b of builds) paths.push({ params: { lang, build: canonicalSlug(b.id) } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.build as string;
const found = await getLocalizedEntry("build-orders", slug, lang);
if (!found) return Astro.redirect("/404");
const { entry, fallback } = found;
const { Content } = await render(entry);

const civs = (civDataJson as { civs: Array<{ slug: string; specialty?: string; meta?: { tier?: string | null } }> }).civs;
const civBySlug = new Map(civs.map((civ) => [civ.slug, civ]));
const recommendedCivs = entry.data.civsRecommended.map((civSlug) => ({
  slug: civSlug,
  meta: civBySlug.get(civSlug),
}));

const difficultyVariant = entry.data.difficulty === "beginner" ? "success" : entry.data.difficulty === "advanced" ? "destructive" : "default";
---
<BaseLayout title={entry.data.name} canonicalPath={`/builds/${slug}`}>
  <article class="mx-auto max-w-6xl px-4 py-10">
    {fallback && (
      <div class="mb-6 rounded border border-royal/40 bg-royal/10 px-3 py-2 text-sm text-royal">
        {t(lang, "ui.translation.missing")}
      </div>
    )}
    <header class="rounded border border-stone-700/40 bg-parchment p-5 shadow-sm">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div>
          <div class="flex flex-wrap gap-2">
            <Badge variant={difficultyVariant}>{entry.data.difficulty}</Badge>
            <Badge variant="outline">{entry.data.targetAge} target</Badge>
            <Badge variant="secondary">~{entry.data.durationMin} min</Badge>
          </div>
          <h1 class="mt-4 font-display text-4xl text-ink sm:text-5xl">{entry.data.name}</h1>
          {entry.data.source && (
            <p class="mt-3 text-sm text-stone-700">
              Source: {entry.data.source.url
                ? <a href={entry.data.source.url} class="font-medium underline hover:text-gold-500">{entry.data.source.author}</a>
                : <span class="font-medium text-ink">{entry.data.source.author}</span>}
            </p>
          )}
        </div>

        <dl class="grid grid-cols-3 gap-3 rounded border border-stone-700/30 bg-stone-700/5 p-3 lg:grid-cols-1">
          <Stat label="Difficulty" tone="highlight">{entry.data.difficulty}</Stat>
          <Stat label="Target">{entry.data.targetAge}</Stat>
          <Stat label="Duration">~{entry.data.durationMin} min</Stat>
        </dl>
      </div>

      {recommendedCivs.length > 0 && (
        <div class="mt-5 border-t border-stone-700/20 pt-4">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-stone-700">Recommended civilizations</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {recommendedCivs.map(({ slug: civSlug, meta }) => (
              <a
                href={localizedPath(`/civs/${civSlug}`, lang)}
                class="inline-flex items-center gap-2 rounded border border-stone-700/30 bg-parchment/70 px-2 py-1 text-sm text-ink hover:border-gold-500 hover:text-gold-500"
              >
                <Icon slug={civSlug} kind="civ" size={28} />
                <span>{civSlug.replace(/-/g, " ")}</span>
                {meta?.meta?.tier && <span class="text-xs text-stone-700">Tier {meta.meta.tier}</span>}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <section>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-3xl text-ink">Step Timeline</h2>
            <p class="mt-1 text-sm text-stone-700">Follow the population rail and phase breaks while you play.</p>
          </div>
        </div>
        <div class="mt-4"><BuildOrderSteps steps={entry.data.steps} /></div>
      </section>

      <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
        <section class="rounded border border-stone-700/40 bg-parchment p-4">
          <h2 class="font-display text-xl text-ink">At a glance</h2>
          <dl class="mt-3 space-y-3">
            <Stat label="Steps">{entry.data.steps.length}</Stat>
            <Stat label="First pop">{entry.data.steps[0]?.villagers ?? "-"}</Stat>
            <Stat label="Final pop">{entry.data.steps.at(-1)?.villagers ?? "-"}</Stat>
          </dl>
        </section>
      </aside>
    </div>

    <section class="prose prose-stone mt-10 max-w-none rounded border border-stone-700/30 bg-parchment px-5 py-6 [&_h1:first-child]:hidden">
      <h2 class="font-display text-3xl text-ink">Strategy Notes</h2>
      <Content />
    </section>
  </article>
</BaseLayout>
