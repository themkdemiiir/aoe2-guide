---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import Icon from "@/components/ui/Icon.astro";
import { Icon as UIIcon } from "astro-icon/components";
import { getCollection } from "astro:content";
import civMeta from "@data/civ-meta.json";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { type CollectionEntry } from "astro:content";
import { type CollectionEntry as _CE } from "astro:content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;

// --- Live content (drives the action-tile counts, the top-civ strip, and the
// featured build/map rows). ---
const civs = await getCollection("civilizations");
const builds: CollectionEntry<"build-orders">[] = await getCollection("build-orders");
const maps: CollectionEntry<"maps">[] = await getCollection("maps");

// --- Top civilizations: rank by live meta win rate, then join back to the
// localized civ entry for name/tagline/bonuses. civ-data carries the meta but
// NOT the localized text; the `civilizations` collection carries the text but
// no meta. Join the two, filter to slugs present in BOTH collections so CivCard
// never receives an undefined name, and carry the FULL meta through so the
// caption can show win/play rate (answers "why these six?"). ---
const civBySlug = new Map(civs.map((c) => [c.id, c]));
const civData = await getCollection("civ-data");
const specialtyBySlug = new Map(civData.map((c) => [c.data.slug, c.data.specialty]));

// Top civilizations ranked by REAL ranked-1v1 win rate (aoestats archive, via
// src/data/civ-meta.json). Rendered as the dark shield strip with live tier.
// Brightened for legibility on the dark band (the strip sits on bg-stone-bg).
const TIER_COLOR: Record<string, string> = { S: "#e0654f", A: "#e6bd5e", B: "#bda983", C: "#a3926e", D: "#8f7f60" };
const oneBySlug = civMeta.civs as Record<string, { "1v1": { winRate: number; tier: string } | null }>;
const topCivs = Object.keys(oneBySlug)
  .map((slug) => ({ slug, one: oneBySlug[slug]?.["1v1"] }))
  .filter((x) => x.one && civBySlug.has(x.slug))
  .sort((a, b) => (b.one as { winRate: number }).winRate - (a.one as { winRate: number }).winRate)
  .slice(0, 8)
  .map((x) => ({
    entry: civBySlug.get(x.slug)!,
    tier: (x.one as { tier: string }).tier,
    winRate: (x.one as { winRate: number }).winRate,
    spec: specialtyBySlug.get(x.slug) ?? "",
  }));
const civCount = civs.length;
const buildCount = builds.length;
const mapCount = maps.length;

// --- Featured build orders: easiest content leads (beginner-first), capped at 3. ---
const featuredBuilds = [...builds]
  .sort((a, b) => {
    const rank = (d: string) => (d === "beginner" ? 0 : d === "intermediate" ? 1 : 2);
    return rank(a.data.difficulty) - rank(b.data.difficulty);
  })
  .slice(0, 3);

// --- Featured maps: a quick taste of the map library, capped at 4. ---
const featuredMaps = maps.slice(0, 4);

function difficultyVariant(difficulty: string) {
  if (difficulty === "beginner") return "success";
  if (difficulty === "advanced") return "destructive";
  return "default";
}

// --- Primary actions: the four highest-intent journeys, verb-phrased so
// comprehension is instant, each carrying a live count. This is the page's
// "easy to understand" core and sits directly under the hero so the page
// answers "what do you want to do?" before any meta jargon. Matchups has no
// collection, so its count is null (shows a sub-label instead). ---
const actions = [
  {
    href: "/civs",
    icon: "lucide:castle",
    title: "home.action.civs.title",
    desc: "home.civs.desc",
    count: civs.length,
    countLabel: "home.count.civs",
  },
  {
    href: "/builds",
    icon: "lucide:list-ordered",
    title: "home.action.builds.title",
    desc: "home.builds.desc",
    count: builds.length,
    countLabel: "home.count.builds",
  },
  {
    href: "/maps",
    icon: "lucide:map",
    title: "home.action.maps.title",
    desc: "home.maps.desc",
    count: maps.length,
    countLabel: "home.count.maps",
  },
  {
    href: "/matchups",
    icon: "lucide:scale",
    title: "home.action.matchups.title",
    desc: "home.matchups.desc",
    count: null,
    countLabel: "home.action.matchups.sub",
  },
] as const;

// --- Remaining destinations: compact link row keeps every section one click
// away (complete internal linking) without a redundant full nav grid. ---
const more = [
  { href: "/units", key: "nav.units", icon: "lucide:swords" },
  { href: "/counters", key: "nav.counters", icon: "lucide:shield" },
  { href: "/learn", key: "nav.learn", icon: "lucide:graduation-cap" },
  { href: "/blog", key: "nav.blog", icon: "lucide:newspaper" },
  { href: "/glossary", key: "nav.glossary", icon: "lucide:book-open" },
] as const;
---
<BaseLayout title="AOE2 Guide" canonicalPath="/">
  {/* === Cinematic hero: full-bleed dark band ===
       On bg-stone-bg use ONLY gold/ember text tokens — they stay light in both
       themes; text-ink / text-stone-700 swap with the theme and would vanish on
       a permanently-dark band. The border-y is load-bearing: --color-stone-bg is
       byte-identical to dark-mode --color-parchment, so in dark mode the band
       blends into the page background — the gold rules keep its extent visible. */}
  <section class="border-y border-gold-500/40 bg-stone-bg">
    <div class="mx-auto max-w-5xl px-4 py-20 text-center sm:py-24">
      <img src="/favicon.svg" alt="" width="88" height="88" class="mx-auto drop-shadow-lg" />
      <div class="mx-auto my-6 flex max-w-xs items-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 bg-gradient-to-r from-transparent to-gold-500/60"></span>
        <UIIcon name="lucide:diamond" class="h-3 w-3 text-gold-500" />
        <span class="h-px flex-1 bg-gradient-to-l from-transparent to-gold-500/60"></span>
      </div>
      <p class="font-display text-sm uppercase tracking-[0.35em] text-gold-400">
        {t(lang, "home.eyebrow")}
      </p>
      <h1 class="mt-3 font-display text-5xl text-gold-500 sm:text-6xl">AOE2 Guide</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ember/90">{t(lang, "home.tagline")}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localizedPath("/civs", lang)}
          class="inline-flex items-center gap-2 rounded border border-gold-500 bg-gold-500/20 px-6 py-3 font-medium text-gold-400 transition-colors hover:bg-gold-500/35"
        >
          <UIIcon name="lucide:castle" class="h-5 w-5" />
          {t(lang, "home.ctaPrimary")}
        </a>
        <a
          href={localizedPath("/builds", lang)}
          class="inline-flex items-center gap-2 rounded border border-gold-500/40 px-6 py-3 font-medium text-ember transition-colors hover:border-gold-500 hover:text-gold-400"
        >
          <UIIcon name="lucide:list-ordered" class="h-5 w-5" />
          {t(lang, "home.ctaSecondary")}
        </a>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 font-mono text-xs tracking-wide text-ember/80">
        <span><span class="font-medium text-gold-400">{civCount}</span> {t(lang, "home.count.civs")}</span>
        <span class="text-gold-500/50" aria-hidden="true">·</span>
        <span><span class="font-medium text-gold-400">{buildCount}</span> {t(lang, "home.count.builds")}</span>
        <span class="text-gold-500/50" aria-hidden="true">·</span>
        <span><span class="font-medium text-gold-400">{mapCount}</span> {t(lang, "home.count.maps")}</span>
      </div>
    </div>
  </section>

  {/* === Primary actions: verb-phrased entry points with live counts ===
       Directly under the hero — clarity before the meta-driven Top Civs strip. */}
  <section class="mx-auto max-w-5xl px-4 pt-14">
    <h2 class="mb-5 font-display text-2xl text-ink">{t(lang, "home.heading")}</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {actions.map((a) => (
        <li class="h-full">
          <a
            href={localizedPath(a.href, lang)}
            class="group flex h-full items-start gap-4 rounded border border-stone-700/40 bg-parchment p-5 transition-colors hover:border-gold-500"
          >
            <span class="shrink-0 rounded bg-gold-500/15 p-3 text-gold-500">
              <UIIcon name={a.icon} class="h-7 w-7" />
            </span>
            <span class="flex-1">
              <span class="flex items-center justify-between gap-2">
                <span class="font-display text-xl text-ink group-hover:text-gold-500">
                  {t(lang, a.title)}
                </span>
                <UIIcon
                  name="lucide:arrow-right"
                  class="h-5 w-5 shrink-0 text-stone-700 transition-transform group-hover:translate-x-0.5 group-hover:text-gold-500"
                />
              </span>
              <span class="mt-1 block text-sm text-stone-700">{t(lang, a.desc)}</span>
              <span class="mt-3 block text-sm font-medium text-stone-700">
                {a.count !== null ? (
                  <>
                    <span class="font-mono text-gold-700">{a.count}</span> {t(lang, a.countLabel)}
                  </>
                ) : (
                  t(lang, a.countLabel)
                )}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* === Top civilizations: dark shield strip, ranked by REAL ranked-1v1 win
       rate (civ-meta.json). On bg-stone-bg use only gold/ember text tokens. === */}
  {topCivs.length > 0 && (
    <section class="mt-14 border-y border-gold-500/40 bg-stone-bg">
      <div class="mx-auto max-w-6xl px-4 py-14">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
          <div>
            <div class="flex items-center gap-3">
              <span class="h-px w-6 bg-gold-500/60" aria-hidden="true"></span>
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-gold-400">{t(lang, "home.topCivs.subtitle")}</span>
            </div>
            <h2 class="mt-3 font-display text-3xl text-gold-400">{civCount} {t(lang, "nav.civs")}</h2>
          </div>
          <a
            href={localizedPath("/civs", lang)}
            class="inline-flex items-center gap-1 font-display text-xs uppercase tracking-wide text-gold-500 transition-colors hover:text-gold-400"
          >
            {t(lang, "home.viewAll")}
            <UIIcon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-4">
          {topCivs.map((c) => (
            <li>
              <a
                href={localizedPath(`/civs/${c.entry.id}`, lang)}
                class="flex items-center gap-3.5 border-t border-gold-500/15 px-3 py-3.5 transition-colors hover:bg-gold-500/10"
              >
                <span
                  class="flex h-10 w-8 flex-none items-center justify-center bg-royal"
                  style="clip-path:polygon(0 0,100% 0,100% 68%,50% 100%,0 68%)"
                >
                  <span class="-mt-1 font-display text-sm font-extrabold text-gold-400">{c.entry.data.name.en.charAt(0)}</span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-display text-base font-bold text-gold-400">{c.entry.data.name[lang]}</span>
                  <span class="mt-0.5 block truncate font-mono text-[9px] uppercase tracking-wide text-ember/70">{c.spec}</span>
                </span>
                <span class="font-display text-sm font-bold" style={`color:${TIER_COLOR[c.tier] ?? "#8f7f60"}`}>{c.tier}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* === Featured build orders: easiest content leads. All badge labels go
       through t() (no raw English enums leaking onto /tr). === */}
  {featuredBuilds.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pt-14">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gold-500/30 pb-3">
        <div>
          <h2 class="font-display text-2xl text-ink">{t(lang, "home.featuredBuilds.title")}</h2>
          <p class="mt-1 text-sm text-stone-700">{t(lang, "home.featuredBuilds.subtitle")}</p>
        </div>
        <a
          href={localizedPath("/builds", lang)}
          class="inline-flex items-center gap-1 text-sm font-medium text-gold-700 hover:underline"
        >
          {t(lang, "home.viewAll")}
          <UIIcon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <ul class="mt-6 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredBuilds.map((b) => (
          <li class="h-full">
            <a
              href={localizedPath(`/builds/${b.id}`, lang)}
              class="flex h-full flex-col rounded border border-stone-700/40 bg-parchment p-4 transition hover:border-gold-500"
            >
              <div class="flex flex-wrap gap-2">
                <Badge variant={difficultyVariant(b.data.difficulty)}>
                  {t(lang, `difficulty.${b.data.difficulty}`)}
                </Badge>
                <Badge variant="outline">{t(lang, `age.${b.data.targetAge}`)}</Badge>
                <Badge variant="secondary">
                  ~{b.data.durationMin} {t(lang, "home.minutes")}
                </Badge>
              </div>
              <h3 class="mt-3 font-display text-xl text-ink">{b.data.name[lang]}</h3>
              {b.data.civsRecommended.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {b.data.civsRecommended.slice(0, 5).map((civSlug) => (
                    <span class="inline-flex items-center gap-1 rounded border border-stone-700/30 bg-stone-700/5 px-1.5 py-1 text-xs text-stone-700">
                      <Icon slug={civSlug} kind="civ" size={20} />
                      {civSlug.replace(/-/g, " ")}
                    </span>
                  ))}
                </div>
              )}
              <p class="mt-auto pt-4 font-mono text-xs text-stone-700">
                {b.data.steps.length} {t(lang, "home.steps")} · ~{b.data.steps.at(-1)?.villagers ?? "?"} {t(lang, "home.pop")}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* === Featured maps: type label routed through t() (all 5 enum members). === */}
  {featuredMaps.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pt-14">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gold-500/30 pb-3">
        <div>
          <h2 class="font-display text-2xl text-ink">{t(lang, "home.maps.title")}</h2>
          <p class="mt-1 text-sm text-stone-700">{t(lang, "home.maps.subtitle")}</p>
        </div>
        <a
          href={localizedPath("/maps", lang)}
          class="inline-flex items-center gap-1 text-sm font-medium text-gold-700 hover:underline"
        >
          {t(lang, "home.viewAll")}
          <UIIcon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <ul class="mt-6 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featuredMaps.map((m) => (
          <li class="h-full">
            <Card href={localizedPath(`/maps/${m.id}`, lang)} interactive class="group">
              <div class="flex items-center gap-3">
                <span class="rounded bg-gold-500/15 p-2 text-gold-500">
                  <UIIcon name="lucide:map" class="h-6 w-6" />
                </span>
                <div>
                  <h3 class="font-display text-lg text-ink group-hover:text-gold-500">{m.data.name[lang]}</h3>
                  <p class="mt-0.5 text-sm text-stone-700">{t(lang, `mapType.${m.data.type}`)}</p>
                </div>
              </div>
            </Card>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* === More to explore: keeps every remaining section one click away. === */}
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-20">
    <h2 class="mb-4 flex items-center gap-3 font-display text-sm uppercase tracking-wide text-stone-700">
      <span class="h-px flex-1 bg-stone-700/30" aria-hidden="true"></span>
      {t(lang, "home.more")}
      <span class="h-px flex-1 bg-stone-700/30" aria-hidden="true"></span>
    </h2>
    <ul class="flex flex-wrap justify-center gap-3">
      {more.map((m) => (
        <li>
          <a
            href={localizedPath(m.href, lang)}
            class="group inline-flex items-center gap-2 rounded border border-stone-700/40 bg-parchment px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-gold-500 hover:text-gold-500"
          >
            <UIIcon name={m.icon} class="h-4 w-4 text-stone-700 group-hover:text-gold-500" />
            {t(lang, m.key)}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>