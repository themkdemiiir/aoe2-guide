---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import iconMap from "@data/icon-map.json";
import mapMeta from "@data/map-meta.json";
import MapCivRankings from "@/components/content/MapCivRankings.astro";
import { canon, dedupedMetaMaps, resolveMetaKey } from "@/lib/data-maps";
import { marked } from "marked";

const META_MAPS = (mapMeta as { maps: Record<string, { games: { "1v1": number; team: number } }> }).maps;

export async function getStaticPaths() {
  const curated = (await getCollection("maps")).map((m) => m.id);
  const curatedCanon = new Set(curated.map(canon));
  // archived maps with no curated page (compared canonically so golden_pit data
  // doesn't spawn a /goldenpit page alongside the curated /golden-pit)
  const dataOnly = dedupedMetaMaps().map((m) => m.slug).filter((s) => !curatedCanon.has(canon(s)));
  return locales.flatMap((lang) => [...curated, ...dataOnly].map((map) => ({ params: { lang, map } })));
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.map as string;
const entry = ((await getCollection("maps")) as CollectionEntry<"maps">[]).find((m) => m.id === slug);
const metaKey = resolveMetaKey(slug);
const md = metaKey ? META_MAPS[metaKey] : undefined;
if (!entry && !md) return Astro.redirect("/404");

const prettify = (s: string) => s.split(/[-_]/).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const name = entry ? entry.data.name[lang] : prettify(slug);
const totalGames = md ? md.games["1v1"] + md.games.team : 0;
const numFmt = new Intl.NumberFormat(lang === "tr" ? "tr-TR" : "en-US");

const bodyHtml = entry?.data.body?.[lang] ? (marked.parse(entry.data.body[lang]) as string) : "";
const civIcons = (iconMap as { civs?: Record<string, string> }).civs ?? {};

function displayName(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1).replace(/-/g, " ");
}
---
<BaseLayout title={name} canonicalPath={`/maps/${slug}`}>
  <article class="mx-auto max-w-3xl px-4 py-8">
    <header class="mb-4">
      <h1 class="font-display text-3xl text-ink">{name}</h1>
      {entry ? (
        <p class="mt-1 text-sm capitalize text-stone-700">
          {entry.data.type}{entry.data.size ? ` · ${entry.data.size}` : ""}
        </p>
      ) : (
        <p class="mt-1 font-mono text-xs uppercase tracking-wide text-stone-700/80">
          {lang === "tr" ? "Veri kaynaklı sayfa" : "Data-derived page"}
          {totalGames ? ` · ${numFmt.format(totalGames)} ${lang === "tr" ? "ranked maç" : "ranked games"}` : ""}
        </p>
      )}
    </header>

    <MapCivRankings mapSlug={slug} lang={lang} />

    {entry && entry.data.recommendedCivs.length > 0 && (
      <section class="mb-6">
        <h2 class="mb-3 font-display text-lg text-ink">{t(lang, "maps.recommendedCivs")}</h2>
        <ul class="flex flex-wrap gap-2">
          {entry.data.recommendedCivs.map((civ) => (
            <li>
              <a
                href={`/${lang}/civs/${civ}`}
                class="flex items-center gap-2 rounded border border-stone-700/30 bg-parchment px-3 py-1.5 text-sm text-ink transition-colors hover:border-gold-500 hover:text-gold-500"
              >
                {civIcons[civ] && <img src={civIcons[civ]} alt="" class="h-5 w-5 object-contain" loading="lazy" />}
                {displayName(civ)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {entry && entry.data.teamComps && (
      <section class="mb-6">
        <h2 class="mb-2 font-display text-lg text-ink">{t(lang, "maps.teamComps")}</h2>
        {(["2v2", "4v4"] as const).map((format) => {
          const comp = entry.data.teamComps?.[format];
          if (!comp) return null;
          const slots = [
            { label: t(lang, "maps.flank"), data: comp.flank },
            { label: t(lang, "maps.pocket"), data: comp.pocket },
          ];
          return (
            <div class="mb-4">
              <h3 class="mb-2 text-lg font-semibold text-ink">{format}</h3>
              <div class="grid gap-4 sm:grid-cols-2">
                {slots.map(({ label, data }) =>
                  data ? (
                    <div class="rounded border border-stone-700/20 bg-parchment p-3">
                      <p class="mb-2 text-xs font-bold uppercase tracking-widest text-stone-700">{label}</p>
                      <ul class="mb-3 flex flex-wrap gap-2">
                        {data.civs.map((civ) => (
                          <li>
                            <a
                              href={`/${lang}/civs/${civ}`}
                              class="flex items-center gap-1.5 rounded border border-stone-700/20 bg-parchment px-2 py-1 text-xs text-ink transition-colors hover:border-gold-500 hover:text-gold-500"
                            >
                              {civIcons[civ] && <img src={civIcons[civ]} alt="" class="h-4 w-4 object-contain" loading="lazy" />}
                              {displayName(civ)}
                            </a>
                          </li>
                        ))}
                      </ul>
                      <p class="text-sm leading-relaxed text-stone-700">{data.strategy[lang]}</p>
                    </div>
                  ) : null,
                )}
              </div>
            </div>
          );
        })}
      </section>
    )}

    {bodyHtml && (
      <section class="prose prose-stone max-w-none" set:html={bodyHtml} />
    )}
  </article>
</BaseLayout>
