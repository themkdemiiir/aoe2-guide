---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { render } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug, getLocalizedEntry } from "@/lib/content";
import iconMap from "@data/icon-map.json";

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; map: string } }> = [];
  for (const lang of locales) {
    const maps = await getLocalizedEntries("maps", lang);
    for (const m of maps) paths.push({ params: { lang, map: canonicalSlug(m.id) } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.map as string;
const found = await getLocalizedEntry("maps", slug, lang);
if (!found) return Astro.redirect("/404");
const { entry, fallback } = found;
const { Content } = await render(entry);
const civIcons = (iconMap as { civs?: Record<string, string> }).civs ?? {};

function displayName(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1).replace(/-/g, " ");
}
---
<BaseLayout title={entry.data.name} canonicalPath={`/maps/${slug}`}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    {fallback && (
      <div class="mb-6 rounded border border-royal/40 bg-royal/10 px-3 py-2 text-sm text-royal">
        {t(lang, "ui.translation.missing")}
      </div>
    )}

    <header class="mb-8">
      <h1 class="font-display text-4xl text-ink">{entry.data.name}</h1>
      <p class="mt-1 text-sm capitalize text-stone-700">
        {entry.data.type}{entry.data.size ? ` · ${entry.data.size}` : ""}
      </p>
    </header>

    {entry.data.recommendedCivs.length > 0 && (
      <section class="mb-8">
        <h2 class="mb-3 font-display text-xl text-ink">{t(lang, "maps.recommendedCivs")}</h2>
        <ul class="flex flex-wrap gap-2">
          {entry.data.recommendedCivs.map((civ) => (
            <li>
              <a
                href={`/${lang}/civs/${civ}`}
                class="flex items-center gap-2 rounded border border-stone-700/30 bg-parchment px-3 py-1.5 text-sm text-ink transition-colors hover:border-gold-500 hover:text-gold-500"
              >
                {civIcons[civ] && <img src={civIcons[civ]} alt="" class="h-5 w-5 object-contain" loading="lazy" />}
                {displayName(civ)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {entry.data.teamComps && (
      <section class="mb-10">
        <h2 class="mb-4 font-display text-xl text-ink">{t(lang, "maps.teamComps")}</h2>
        {(["2v2", "4v4"] as const).map((format) => {
          const comp = entry.data.teamComps?.[format];
          if (!comp) return null;
          const slots = [
            { label: t(lang, "maps.flank"), data: comp.flank },
            { label: t(lang, "maps.pocket"), data: comp.pocket },
          ];
          return (
            <div class="mb-6">
              <h3 class="mb-3 text-lg font-semibold text-ink">{format}</h3>
              <div class="grid gap-4 sm:grid-cols-2">
                {slots.map(({ label, data }) =>
                  data ? (
                    <div class="rounded border border-stone-700/20 bg-parchment p-4">
                      <p class="mb-2 text-xs font-bold uppercase tracking-widest text-stone-700">{label}</p>
                      <ul class="mb-3 flex flex-wrap gap-2">
                        {data.civs.map((civ) => (
                          <li>
                            <a
                              href={`/${lang}/civs/${civ}`}
                              class="flex items-center gap-1.5 rounded border border-stone-700/20 bg-parchment px-2 py-1 text-xs text-ink transition-colors hover:border-gold-500 hover:text-gold-500"
                            >
                              {civIcons[civ] && <img src={civIcons[civ]} alt="" class="h-4 w-4 object-contain" loading="lazy" />}
                              {displayName(civ)}
                            </a>
                          </li>
                        ))}
                      </ul>
                      <p class="text-sm leading-relaxed text-stone-700">{data.strategy}</p>
                    </div>
                  ) : null,
                )}
              </div>
            </div>
          );
        })}
      </section>
    )}

    <section class="prose prose-stone max-w-none"><Content /></section>
  </article>
</BaseLayout>
