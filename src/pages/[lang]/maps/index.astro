---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import FilterBar from "@/components/ui/FilterBar.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const maps: CollectionEntry<"maps">[] = await getCollection("maps");

const mapTypes = ["open", "closed", "hybrid", "water", "nomad"] as const;
const facets = [
  {
    name: "type",
    label: t(lang, "filter.type"),
    options: mapTypes.map((v) => ({ value: v, label: t(lang, `mapType.${v}`) })),
  },
];
---
<BaseLayout title={t(lang, "nav.maps")} canonicalPath="/maps">
  <section class="mx-auto max-w-7xl px-4 py-12" data-filter-root>
    <h1 class="mb-6 font-display text-4xl text-ink">{t(lang, "nav.maps")}</h1>
    {maps.length === 0 ? (
      <p class="mt-6 text-stone-700">No maps yet — coming soon.</p>
    ) : (
      <>
        <FilterBar
          searchPlaceholder={`${t(lang, "filter.search")}…`}
          facets={facets}
          total={maps.length}
          resultsLabel={t(lang, "filter.results")}
          allLabel={t(lang, "filter.all")}
          resetLabel={t(lang, "filter.reset")}
        />
        <ul class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {maps.map((m) => (
            <li
              class="h-full"
              data-filter-item
              data-search={m.data.name[lang].toLowerCase()}
              data-type={m.data.type}
            >
              <a href={localizedPath(`/maps/${m.id}`, lang)}
                 class="flex h-full flex-col rounded border border-stone-700/40 bg-parchment p-4 hover:border-gold-500">
                <h3 class="font-display text-xl text-ink">{m.data.name[lang]}</h3>
                <p class="mt-auto pt-2 text-xs capitalize text-stone-700">
                  {t(lang, `mapType.${m.data.type}`)}{m.data.size ? ` · ${m.data.size}` : ""}
                </p>
              </a>
            </li>
          ))}
        </ul>
        <p data-filter-empty hidden class="mt-8 text-center text-stone-700">{t(lang, "filter.noResults")}</p>
      </>
    )}
  </section>
  <script>import "@/scripts/list-filter.ts";</script>
</BaseLayout>
