---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug } from "@/lib/content";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const maps = await getLocalizedEntries("maps", lang);
---
<BaseLayout title={t(lang, "nav.maps")} canonicalPath="/maps">
  <section class="mx-auto max-w-7xl px-4 py-12">
    <h1 class="font-display text-4xl text-ink">{t(lang, "nav.maps")}</h1>
    {maps.length === 0 ? (
      <p class="mt-6 text-stone-700">No maps yet — coming soon.</p>
    ) : (
      <ul class="mt-8 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {maps.map((m) => (
          <li class="h-full">
            <a href={localizedPath(`/maps/${canonicalSlug(m.id)}`, lang)}
               class="flex h-full flex-col rounded border border-stone-700/40 bg-parchment p-4 hover:border-gold-500">
              <h3 class="font-display text-xl text-ink">{m.data.name}</h3>
              <p class="mt-auto pt-2 text-xs text-stone-700">{m.data.type}{m.data.size ? ` · ${m.data.size}` : ""}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
