---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import FilterBar from "@/components/ui/FilterBar.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { canon, dedupedMetaMaps } from "@/lib/data-maps";
import { displayName } from "@/lib/display";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const tr = lang === "tr";
const maps: CollectionEntry<"maps">[] = await getCollection("maps");
const curatedCanon = new Set(maps.map((m) => canon(m.id)));
const numFmt = new Intl.NumberFormat(tr ? "tr-TR" : "en-US");
// maps with archive rankings but no curated page → a compact data-page list
const dataMaps = dedupedMetaMaps().filter((m) => !curatedCanon.has(canon(m.slug)));

const mapTypes = ["open", "closed", "hybrid", "water", "nomad"] as const;
const facets = [
  {
    name: "type",
    label: t(lang, "filter.type"),
    options: mapTypes.map((v) => ({ value: v, label: t(lang, `mapType.${v}`) })),
  },
];
---
<BaseLayout title={t(lang, "nav.maps")} description={t(lang, "meta.maps")} canonicalPath="/maps">
  <section class="mx-auto max-w-7xl px-4 py-12" data-filter-root>
    <h1 class="mb-6 font-display text-4xl text-ink">{t(lang, "nav.maps")}</h1>
    {maps.length === 0 ? (
      <p class="mt-6 text-stone-700">No maps yet — coming soon.</p>
    ) : (
      <>
        <FilterBar
          searchPlaceholder={`${t(lang, "filter.search")}…`}
          facets={facets}
          total={maps.length}
          resultsLabel={t(lang, "filter.results")}
          allLabel={t(lang, "filter.all")}
          resetLabel={t(lang, "filter.reset")}
        />
        <ul class="grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {maps.map((m) => (
            <li
              class="h-full"
              data-filter-item
              data-search={m.data.name[lang].toLowerCase()}
              data-type={m.data.type}
            >
              <a href={localizedPath(`/maps/${m.id}`, lang)}
                 class="flex h-full flex-col rounded border border-stone-700/40 bg-parchment p-4 hover:border-gold-500">
                <h3 class="font-display text-xl text-ink">{m.data.name[lang]}</h3>
                <p class="mt-auto pt-2 text-xs capitalize text-stone-700">
                  {t(lang, `mapType.${m.data.type}`)}{m.data.size ? ` · ${m.data.size}` : ""}
                </p>
              </a>
            </li>
          ))}
        </ul>
        <p data-filter-empty hidden class="mt-8 text-center text-stone-700">{t(lang, "filter.noResults")}</p>
      </>
    )}
  </section>

  {dataMaps.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-16">
      <div class="border-t border-stone-700/20 pt-8">
        <h2 class="font-display text-2xl text-ink">{tr ? "Tüm ranked haritalar" : "All ranked maps"}</h2>
        <p class="mt-1 mb-5 text-sm text-stone-700">
          {tr
            ? "Arşiv verisinden civ sıralamalı (küratörlü rehber henüz yok)."
            : "With archive civ rankings (no curated guide yet)."}
        </p>
        <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {dataMaps.map((m) => (
            <li>
              <a
                href={localizedPath(`/maps/${m.slug}`, lang)}
                class="flex items-center justify-between gap-3 rounded border border-stone-700/25 bg-parchment px-3 py-2.5 transition-colors hover:border-gold-500"
              >
                <span class="truncate font-display text-ink">{displayName(m.slug)}</span>
                <span class="flex-none font-mono text-[11px] text-stone-700/60">{numFmt.format(m.games)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <script>import "@/scripts/list-filter.ts";</script>
</BaseLayout>
