---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import SectionEyebrow from "@/components/ui/SectionEyebrow.astro";
import JsonLd from "@/components/ui/JsonLd.astro";
import { render } from "astro:content";
import { locales, type Locale } from "@/i18n/locales";
import { t, localizedPath } from "@/i18n/utils";
import { getLocalizedEntries, canonicalSlug, getLocalizedEntry } from "@/lib/content";

export async function getStaticPaths() {
  const paths: Array<{ params: { lang: string; chapter: string } }> = [];
  for (const lang of locales) {
    const chs = await getLocalizedEntries("beginner", lang);
    for (const c of chs) paths.push({ params: { lang, chapter: canonicalSlug(c.id) } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.chapter as string;
const found = await getLocalizedEntry("beginner", slug, lang);
if (!found) return Astro.redirect("/404");
const { entry, fallback } = found;
const { Content, headings } = await render(entry);

const all = (await getLocalizedEntries("beginner", lang)).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((e) => canonicalSlug(e.id) === slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Article — matches the blog pattern (HowTo/FAQ were retired by Google; Article
// is still a supported rich-result type). Beginner chapters carry no dates.
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: lang,
  author: { "@type": "Organization", name: "AOE2 Guide" },
  publisher: { "@type": "Organization", name: "AOE2 Guide", url: "https://aoe2guide.com" },
};
---
<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath={`/learn/${slug}`}>
  <JsonLd slot="head" data={articleLd} />
  <div class="mx-auto max-w-6xl px-4 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-10">
    <article class="min-w-0 max-w-prose">
      {fallback && (
        <div class="mb-6 rounded border border-royal/40 bg-royal/10 px-3 py-2 text-sm text-royal">
          {t(lang, "ui.translation.missing")}
        </div>
      )}
      {idx >= 0 && <SectionEyebrow label={`${t(lang, "learn.chapter")} ${idx + 1} / ${all.length}`} class="mb-3" />}
      <h1 class="font-display text-4xl text-ink">{entry.data.title}</h1>

      {tocItems.length >= 3 && (
        <details class="mt-6 rounded border border-stone-700/30 bg-parchment p-3 lg:hidden">
          <summary class="cursor-pointer font-display text-sm uppercase tracking-widest text-stone-700">
            {t(lang, "toc.title")}
          </summary>
          <div class="mt-3"><TableOfContents headings={headings} title={t(lang, "toc.title")} /></div>
        </details>
      )}

      <section class="prose prose-stone mt-8 max-w-none"><Content /></section>

      <nav class="mt-12 grid gap-3 border-t border-stone-700/30 pt-6 sm:grid-cols-2">
        {prev ? (
          <a href={localizedPath(`/learn/${canonicalSlug(prev.id)}`, lang)} class="group rounded border border-stone-700/30 bg-parchment p-3 transition-colors hover:border-gold-500">
            <span class="font-mono text-[10px] uppercase tracking-widest text-stone-700/70">← {t(lang, "learn.prev")}</span>
            <span class="mt-1 block font-display text-ink group-hover:text-gold-700">{prev.data.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {next ? (
          <a href={localizedPath(`/learn/${canonicalSlug(next.id)}`, lang)} class="group rounded border border-stone-700/30 bg-parchment p-3 text-right transition-colors hover:border-gold-500 sm:col-start-2">
            <span class="font-mono text-[10px] uppercase tracking-widest text-stone-700/70">{t(lang, "learn.next")} →</span>
            <span class="mt-1 block font-display text-ink group-hover:text-gold-700">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <TableOfContents headings={headings} title={t(lang, "toc.title")} />
      </div>
    </aside>
  </div>
  <script>
    // Scroll-spy: highlight the current section in the desktop TOC while reading.
    function initTocSpy() {
      const links = new Map(
        [...document.querySelectorAll<HTMLElement>("aside [data-toc-link]")].map((a) => [a.dataset.tocLink ?? "", a]),
      );
      if (!links.size) return;
      const heads = [...document.querySelectorAll<HTMLElement>("article :is(h2, h3)")].filter((h) => links.has(h.id));
      let current = "";
      const setActive = (id: string) => {
        if (id === current) return;
        links.get(current)?.removeAttribute("aria-current");
        current = id;
        links.get(id)?.setAttribute("aria-current", "true");
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top);
          if (vis.length) setActive(vis[0].target.id);
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
      );
      for (const h of heads) obs.observe(h);
    }
    document.addEventListener("astro:page-load", initTocSpy);
  </script>
</BaseLayout>
