---
import { defaultLocale } from "@/i18n/locales";
const home = `/${defaultLocale}/`;
---
<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={home} />
    <title>AOE2 Guide</title>
    <script is:inline>
      // Default entry is English; honor a returning visitor's saved choice.
      (() => {
        try {
          const stored = localStorage.getItem("preferredLang");
          const lang = stored === "en" || stored === "tr" ? stored : "en";
          location.replace("/" + lang + "/");
        } catch {
          location.replace("/en/");
        }
      })();
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${home}`} /></noscript>
  </head>
  <body>
    <p>Redirecting to <a href={home}>AOE2 Guide</a>…</p>
  </body>
</html>
