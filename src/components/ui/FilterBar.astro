---
// FilterBar — search input + facet dropdowns + reset + live result count.
// Pairs with src/scripts/list-filter.ts. Must be rendered INSIDE a
// [data-filter-root] element that also contains the [data-filter-item] list.
interface FacetOption {
  value: string;
  label: string;
}
interface Facet {
  name: string;
  label: string;
  options: FacetOption[];
}
interface Props {
  searchPlaceholder: string;
  facets?: Facet[];
  total: number;
  resultsLabel: string;
  allLabel: string;
  resetLabel: string;
}
const { searchPlaceholder, facets = [], total, resultsLabel, allLabel, resetLabel } = Astro.props;
---
<div class="mb-6 flex flex-wrap items-center gap-3">
  <input
    data-filter-search
    type="search"
    placeholder={searchPlaceholder}
    class="min-w-[12rem] flex-1 rounded border border-stone-700/40 bg-parchment px-3 py-2 text-sm text-ink placeholder:text-stone-700/60 focus:border-gold-500 focus:outline-none"
  />
  {facets.map((f) => (
    <select
      data-filter-facet={f.name}
      aria-label={f.label}
      class="select-field"
    >
      <option value="">{f.label}: {allLabel}</option>
      {f.options.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  ))}
  <button
    type="button"
    data-filter-reset
    class="rounded border border-stone-700/40 px-3 py-2 text-sm text-stone-700 transition-colors hover:border-gold-500 hover:text-gold-500"
  >
    {resetLabel}
  </button>
  <span class="ml-auto text-sm text-stone-700">
    <span data-filter-count class="font-mono text-ink">{total}</span>
    {resultsLabel}
  </span>
</div>
