---
interface Step {
  villagers: number;
  time: string;
  assign: string;
  note?: string;
}
interface Props { steps: Step[]; }
const { steps } = Astro.props;

/** Detect phase-transition rows (Feudal arrives, Castle arrives, etc.) so we can accent them. */
function isPhaseTransition(assign: string): boolean {
  return /\b(Feudal|Castle|Imperial)\s+(arrives?|click|hit)/i.test(assign);
}
---
<ol class="overflow-hidden rounded border border-stone-700/40">
  <li class="grid grid-cols-[6ch_5ch_1fr] gap-3 border-b-2 border-stone-700/40 bg-parchment/70 px-3 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-stone-700">
    <span>Time</span><span>Vil</span><span>Action</span>
  </li>
  {steps.map((s, i) => {
    const accent = isPhaseTransition(s.assign);
    const rowClass = accent
      ? "grid grid-cols-[6ch_5ch_1fr] gap-3 border-t border-gold-500/40 bg-gold-500/10 px-3 py-2"
      : `grid grid-cols-[6ch_5ch_1fr] gap-3 border-t border-stone-700/20 px-3 py-2 ${i % 2 ? "bg-parchment/40" : "bg-parchment"}`;
    return (
      <li class={rowClass}>
        <span class="font-mono text-sm text-stone-700">{s.time}</span>
        <span class="font-mono text-sm font-bold text-ink">{s.villagers}</span>
        <span class={`text-sm ${accent ? "font-semibold text-ink" : "text-ink"}`}>
          {s.assign}
          {s.note && <span class="ml-2 italic text-stone-700"> — {s.note}</span>}
        </span>
      </li>
    );
  })}
</ol>
