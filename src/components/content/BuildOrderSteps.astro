---
import iconMapJson from "@data/icon-map.json";
import type { Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";

interface Step {
  villagers?: number;
  phase?: "feudal" | "castle" | "imperial";
  time?: string;
  assign: string;
  note?: string;
  icons?: string[];
}
interface Props { steps: Step[]; lang: Locale; slug: string; }
const { steps, lang, slug } = Astro.props;

const iconMap = iconMapJson as Record<string, Record<string, string>>;

const RESOURCE_ICONS: Record<string, string> = {
  food:  "/images/aoe2/food.png",
  wood:  "/images/aoe2/wood.png",
  gold:  "/images/aoe2/gold.png",
  stone: "/images/aoe2/stone.png",
};

function resolveIcon(slug: string): string | null {
  if (RESOURCE_ICONS[slug]) return RESOURCE_ICONS[slug];
  for (const bucket of ["units", "techs", "civs", "buildings"]) {
    const path = iconMap[bucket]?.[slug];
    if (path) return path;
  }
  return null;
}

function titleCase(slug: string): string {
  return slug
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

// Prefer the structured `phase` field; fall back to a STRICT "<Age> click/arrives"
// pattern so prose like "wall before Castle" doesn't trigger a false section break.
function phaseFromAssign(assign: string): "feudal" | "castle" | "imperial" | null {
  if (/\b(Imperial|Emperyal|İmparatorluk)\b/i.test(assign)) return "imperial";
  if (/\b(Castle|Kale)\b/i.test(assign)) return "castle";
  if (/\b(Feudal|Feodal)\b/i.test(assign)) return "feudal";
  return null;
}
function isTransitionAssign(assign: string): boolean {
  return /\b(Feudal|Castle|Imperial|Kale|Feodal|Emperyal|İmparatorluk)\s+(arrives?|click|hit|reach|tıkla|geç|geçiş|ulaş)/i.test(assign);
}

interface PhaseSection {
  id: string;
  label: string;
  steps: Array<Step & { index: number; isTransition: boolean }>;
}

const sections: PhaseSection[] = [{ id: "opening", label: t(lang, "builds.opening"), steps: [] }];

for (const [index, step] of steps.entries()) {
  const phaseKey =
    step.phase ?? (isTransitionAssign(step.assign) ? phaseFromAssign(step.assign) : null);
  const isTransition = phaseKey != null;
  if (phaseKey) {
    const label = t(lang, `age.${phaseKey}`);
    if (sections[sections.length - 1]?.label !== label) {
      sections.push({ id: phaseKey, label, steps: [] });
    }
  }
  sections[sections.length - 1].steps.push({ ...step, index, isTransition });
}
---
<div data-trainer data-slug={slug} data-lang={lang} tabindex="-1" class="trainer focus:outline-none">
  <div class="mb-4 flex flex-wrap items-center gap-2 rounded border border-stone-700/30 bg-stone-700/5 px-3 py-2 text-sm print:hidden">
    <span class="font-mono text-stone-700"><span data-progress>0/0</span> {t(lang, "builds.doneLabel")}</span>
    <span class="ml-auto flex items-center gap-1.5">
      <button type="button" data-action="timer" data-start={t(lang, "builds.start")} data-pause={t(lang, "builds.pause")} class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.start")}</button>
      <span data-clock class="w-10 text-center font-mono text-stone-700">0:00</span>
      <select data-speed aria-label={t(lang, "builds.speed")} class="rounded border border-stone-700/30 bg-parchment px-1 py-1">
        <option value="1">1.0×</option><option value="1.5">1.5×</option><option value="1.7" selected>1.7×</option><option value="2">2.0×</option>
      </select>
      <button type="button" data-action="timer-reset" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.timerReset")}</button>
    </span>
    <span class="flex items-center gap-1.5">
      <button type="button" data-action="focus" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.focus")}</button>
      <button type="button" data-action="copy" data-copied={t(lang, "builds.copied")} class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.copy")}</button>
      <button type="button" data-action="print" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.print")}</button>
      <button type="button" data-action="reset-progress" class="rounded border border-stone-700/30 bg-parchment px-2 py-1 hover:border-gold-500">{t(lang, "builds.resetProgress")}</button>
    </span>
  </div>
  <div class="space-y-4">
  {sections.map((section) => {
    const first = section.steps[0];
    const pops = section.steps.map((s) => s.villagers).filter((v): v is number => v != null);
    const popRange = pops.length ? ` · ${t(lang, "home.pop")} ${pops[0]}-${pops[pops.length - 1]}` : "";
    return (
      <section class="overflow-hidden rounded border border-stone-700/40 bg-parchment shadow-sm">
        <header class="flex flex-wrap items-end justify-between gap-2 border-b border-stone-700/30 bg-stone-700/10 px-4 py-3">
          <div>
            <h3 class="font-display text-lg text-ink">{section.label}</h3>
            <p class="text-xs text-stone-700">
              {section.steps.length} {t(lang, "home.steps")}{popRange}
            </p>
          </div>
          {first?.time && <span class="font-mono text-xs text-stone-700">{first.time}</span>}
        </header>

        <ol class="divide-y divide-stone-700/20">
          {section.steps.map((s) => (
            <li
              id={`step-${s.index}`}
              data-step={s.index}
              data-time={s.time ?? ""}
              data-pop={s.villagers ?? ""}
              data-assign={s.assign}
              tabindex="0"
              class:list={[
              "group grid cursor-pointer gap-3 px-4 py-3 scroll-mt-24 sm:grid-cols-[5rem_1fr]",
              s.isTransition ? "bg-gold-500/10" : s.index % 2 ? "bg-parchment/70" : "bg-parchment",
            ]}>
              <div class="flex items-center gap-3 sm:block">
                {s.villagers != null ? (
                  <div class="inline-flex min-w-12 flex-col rounded border border-stone-700/30 bg-parchment/80 px-2 py-1 text-center">
                    <span class="text-[0.65rem] uppercase tracking-wide text-stone-700">{t(lang, "home.pop")}</span>
                    <span class="font-mono text-lg font-bold leading-none text-ink">{s.villagers}</span>
                  </div>
                ) : (
                  <div class="inline-flex min-w-12 items-center justify-center rounded border border-dashed border-stone-700/20 bg-parchment/50 px-2 py-2 text-center font-mono text-sm text-stone-700">
                    #{s.index + 1}
                  </div>
                )}
                <div class="font-mono text-xs text-stone-700 sm:mt-2 sm:text-center">
                  {s.time ?? `#${s.index + 1}`}
                </div>
              </div>

              <div class="min-w-0 space-y-2">
                {s.icons && s.icons.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {s.icons.map((slug) => {
                      const src = resolveIcon(slug);
                      return src ? (
                        <span class="inline-flex items-center gap-1 rounded border border-stone-700/30 bg-parchment/80 px-1.5 py-1 text-xs text-stone-700" title={titleCase(slug)}>
                          <img src={src} alt={slug} width="28" height="28" class="h-7 w-7 shrink-0 rounded-sm object-contain" />
                          <span class="sr-only">{titleCase(slug)}</span>
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded border border-dashed border-stone-700/30 bg-stone-700/5 px-2 py-1 text-xs text-stone-700">
                          {titleCase(slug)}
                        </span>
                      );
                    })}
                  </div>
                )}
                <p class:list={["text-sm leading-relaxed", s.isTransition ? "font-semibold text-ink" : "text-ink"]}>
                  {s.assign}
                </p>
                {s.note && (
                  <p class="rounded border-l-2 border-gold-500 bg-gold-500/10 px-3 py-2 text-xs text-stone-700">
                    {s.note}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    );
  })}
  </div>
</div>
<script>import "@/scripts/build-trainer.ts";</script>
