---
import iconMapJson from "@data/icon-map.json";

interface Step {
  villagers: number;
  time?: string;
  assign: string;
  note?: string;
  icons?: string[];
}
interface Props { steps: Step[]; }
const { steps } = Astro.props;

const iconMap = iconMapJson as Record<string, Record<string, string>>;

// Building slugs are tricky: aoe2techtree's Building/<id>.png uses an internal
// catalog numbering that does NOT match game IDs, and they don't publish that
// mapping. Until we identify it (or use a different asset source), only buildings
// whose file we've VISUALLY confirmed against the upstream rendering are listed.
// Missing slugs render no icon (cleaner than a wrong unit-image proxy).
const BUILDING_ICONS: Record<string, string> = {
  // VERIFIED via aoe2techtree's live tech-tree page rendering at the same IDs:
  "town-center":   "/images/aoe2/Building/109.png",
  "market":        "/images/aoe2/Building/84.png",
  "archery-range": "/images/aoe2/Building/87.png",
  "stable":        "/images/aoe2/Building/101.png",
  "blacksmith":    "/images/aoe2/Building/103.png",
  "monastery":     "/images/aoe2/Building/104.png",
  // Below are UNVERIFIED. If we surface a wrong icon for one of these, remove it
  // from this map so the slug renders no icon at all.
  // (currently empty pending verification)
};

const RESOURCE_ICONS: Record<string, string> = {
  food:  "/images/aoe2/food.png",
  wood:  "/images/aoe2/wood.png",
  gold:  "/images/aoe2/gold.png",
  stone: "/images/aoe2/stone.png",
};

function resolveIcon(slug: string): string | null {
  if (RESOURCE_ICONS[slug]) return RESOURCE_ICONS[slug];
  if (BUILDING_ICONS[slug]) return BUILDING_ICONS[slug];
  for (const bucket of ["units", "techs", "civs", "buildings"]) {
    const path = iconMap[bucket]?.[slug];
    if (path) return path;
  }
  return null;
}

function isPhase(assign: string): boolean {
  return /\b(Feudal|Castle|Imperial|Kale|Feodal|Emperyal)\s+(arrives?|click|hit|tıkla|geç|geçiş)/i.test(assign);
}
---
<ol class="overflow-hidden rounded border border-stone-700/40">
  <li class="grid grid-cols-[5ch_1fr] gap-3 border-b-2 border-stone-700/40 bg-parchment/70 px-3 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-stone-700">
    <span>Vil</span><span>Action</span>
  </li>
  {steps.map((s, i) => {
    const phase = isPhase(s.assign);
    const rowClass = phase
      ? "grid grid-cols-[5ch_1fr] gap-3 border-t border-gold-500/40 bg-gold-500/10 px-3 py-2"
      : `grid grid-cols-[5ch_1fr] gap-3 border-t border-stone-700/20 px-3 py-2 ${i % 2 ? "bg-parchment/40" : "bg-parchment"}`;
    return (
      <li class={rowClass}>
        <span class="font-mono text-base font-bold text-ink">{s.villagers}</span>
        <span class={`flex flex-wrap items-center gap-2 text-sm ${phase ? "font-semibold text-ink" : "text-ink"}`}>
          {s.icons?.map((slug) => {
            const src = resolveIcon(slug);
            return src ? <img src={src} alt={slug} width="24" height="24" class="inline-block h-6 w-6 shrink-0 rounded-sm border border-stone-700/30 bg-parchment/40" /> : null;
          })}
          <span>{s.assign}</span>
          {s.note && <span class="italic text-stone-700"> — {s.note}</span>}
        </span>
      </li>
    );
  })}
</ol>
