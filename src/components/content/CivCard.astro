---
import { getEntry } from "astro:content";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Locale } from "@/i18n/locales";
import { localizedPath } from "@/i18n/utils";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  bonuses: string[];
  locale: Locale;
}

const { slug, name, tagline, bonuses, locale } = Astro.props;
const meta = (await getEntry("civ-data", slug))?.data;
---
<Card href={localizedPath(`/civs/${slug}`, locale)} interactive>
  <div class="flex items-center gap-3">
    <Icon slug={slug} kind="civ" size={64} />
    <div>
      <h3 class="font-display text-xl text-ink transition-colors group-hover/card:text-gold-500" transition:name={`civ-name-${slug}`}>{name}</h3>
      <p class="text-sm text-stone-700">{tagline}</p>
    </div>
  </div>
  {meta && (
    <div class="mt-3 flex flex-wrap gap-1">
      {meta.specialty && <Badge variant="outline">{meta.specialty}</Badge>}
      {meta.meta?.tier && <Badge variant="success">Tier {meta.meta.tier}</Badge>}
    </div>
  )}
  {bonuses && bonuses.length > 0 && (
    <ul class="mt-auto list-inside list-disc space-y-1 pt-3 text-sm text-stone-700">
      {bonuses.slice(0, 3).map((b) => <li>{b}</li>)}
    </ul>
  )}
</Card>
