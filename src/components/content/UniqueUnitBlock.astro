---
// UniqueUnitBlock — renders a civ's unique units inline, pulling stats from the
// `unit-stats` content collection. If the slug exists in the `units` collection
// its name links to its dedicated page; otherwise it renders as plain text
// (humanized slug). This avoids broken links for units without a content entry.

import { getCollection } from "astro:content";
import Alert from "@/components/ui/Alert.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import Stat from "@/components/ui/Stat.astro";
import type { Locale } from "@/i18n/locales";
import { localizedPath, t } from "@/i18n/utils";

interface Props {
  slugs: string[];
  locale: Locale;
}

const { slugs, locale } = Astro.props;

// Units are single bilingual YAML entries (id === slug, name is { en, tr }).
// A unit present in the collection has a dedicated page to link to.
const allUnits = await getCollection("units");
const allStats = await getCollection("unit-stats");
const unitBySlug = new Map(allUnits.map((u) => [u.id, u.data]));
const statsBySlug = new Map(allStats.map((entry) => [entry.id, entry.data]));

function humanize(slug: string): string {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

const blocks = slugs.map((slug) => {
  const stats = statsBySlug.get(slug) ?? null;
  const unit = unitBySlug.get(slug);
  const name = unit ? (unit.name[locale] ?? unit.name.en) : humanize(slug);
  return {
    slug,
    name,
    href: unit ? localizedPath(`/units/${slug}`, locale) : null,
    stats,
  };
});
---
<div class="grid gap-3 sm:grid-cols-2">
  {blocks.map(({ slug, name, href, stats }) => (
    <Card>
      <div class="flex items-center gap-3">
        <Icon slug={slug} kind="unit" size={56} />
        <div class="flex-1 min-w-0">
          {href ? (
            <a href={href} class="font-display text-lg text-ink hover:text-gold-500 truncate block">
              {name}
            </a>
          ) : (
            <span class="font-display text-lg text-ink truncate block">{name}</span>
          )}
        </div>
      </div>

      {stats ? (
        <dl class="mt-3 grid grid-cols-3 gap-2">
          <Stat label={t(locale, "units.hp")}>{stats.hp}</Stat>
          <Stat label={t(locale, "units.attack")}>{stats.attack}</Stat>
          {stats.range > 0 ? (
            <Stat label={t(locale, "units.range")}>{stats.range}</Stat>
          ) : stats.armorMelee !== undefined ? (
            <Stat label={t(locale, "units.armor")}>{stats.armorMelee}/{stats.armorPiercing ?? 0}</Stat>
          ) : (
            <div />
          )}
        </dl>
      ) : (
        <Alert variant="info" class="mt-3">
          {`${t(locale, "units.statsUnavailable")} ${name}.`}
        </Alert>
      )}

      {stats && (
        <div class="mt-2 flex flex-wrap gap-2 text-xs">
          {stats.cost.food > 0 && <span class="text-res-food">{stats.cost.food}f</span>}
          {stats.cost.wood > 0 && <span class="text-res-wood">{stats.cost.wood}w</span>}
          {stats.cost.gold > 0 && <span class="text-res-gold">{stats.cost.gold}g</span>}
          {stats.cost.stone > 0 && <span class="text-res-stone">{stats.cost.stone}s</span>}
        </div>
      )}
    </Card>
  ))}
</div>
