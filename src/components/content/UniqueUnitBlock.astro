---
// UniqueUnitBlock — renders a civ's unique units inline, pulling stats from the
// `unit-stats` content collection. If a unit MD file exists in `units/<lang>/`
// for the slug, the unit name links to its dedicated page; otherwise it
// renders as plain text. This eliminates broken links to the 39 unique-unit
// pages that don't have MD files.

import { getCollection } from "astro:content";
import Alert from "@/components/ui/Alert.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import Stat from "@/components/ui/Stat.astro";
import type { Locale } from "@/i18n/locales";
import { localizedPath } from "@/i18n/utils";
import { canonicalSlug, localeFromEntryId } from "@/lib/content";

interface Props {
  slugs: string[];
  locale: Locale;
}

const { slugs, locale } = Astro.props;

// Build a lookup of unit MD files (per locale, fallback to en) — lets us know
// which unique units have a dedicated page to link to.
const allUnits = await getCollection("units");
const allStats = await getCollection("unit-stats");
const unitBySlug = new Map<string, { name: string; hasPageInLocale: boolean }>();
const statsBySlug = new Map(allStats.map((entry) => [entry.id, entry.data]));
for (const u of allUnits) {
  const slug = canonicalSlug(u.id);
  const entryLocale = localeFromEntryId(u.id);
  const prev = unitBySlug.get(slug);
  if (entryLocale === locale) {
    unitBySlug.set(slug, { name: u.data.name, hasPageInLocale: true });
  } else if (!prev) {
    unitBySlug.set(slug, { name: u.data.name, hasPageInLocale: false });
  }
}

function humanize(slug: string): string {
  return slug
    .split("-")
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

const blocks = await Promise.all(
  slugs.map(async (slug) => {
    const stats = statsBySlug.get(slug) ?? null;
    const unitFile = unitBySlug.get(slug);
    const name = unitFile?.name ?? humanize(slug);
    const hasFile = !!allUnits.find((u) => canonicalSlug(u.id) === slug);
    return {
      slug,
      name,
      href: hasFile ? localizedPath(`/units/${slug}`, locale) : null,
      stats,
    };
  }),
);
---
<div class="grid gap-3 sm:grid-cols-2">
  {blocks.map(({ slug, name, href, stats }) => (
    <Card>
      <div class="flex items-center gap-3">
        <Icon slug={slug} kind="unit" size={56} />
        <div class="flex-1 min-w-0">
          {href ? (
            <a href={href} class="font-display text-lg text-ink hover:text-gold-500 truncate block">
              {name}
            </a>
          ) : (
            <span class="font-display text-lg text-ink truncate block">{name}</span>
          )}
          {!stats && (
            <Badge variant="outline" class="mt-1">stats pending</Badge>
          )}
        </div>
      </div>

      {stats ? (
        <dl class="mt-3 grid grid-cols-3 gap-2">
          <Stat label="HP">{stats.hp}</Stat>
          <Stat label="Attack">{stats.attack}</Stat>
          {stats.range > 0 ? (
            <Stat label="Range">{stats.range}</Stat>
          ) : stats.armorMelee !== undefined ? (
            <Stat label="Armor">{stats.armorMelee}/{stats.armorPiercing ?? 0}</Stat>
          ) : (
            <div />
          )}
        </dl>
      ) : (
        <Alert variant="info" class="mt-3">
          Stats not yet available for <code>{slug}</code>.
        </Alert>
      )}

      {stats && (
        <div class="mt-2 flex flex-wrap gap-2 text-xs">
          {stats.cost.food > 0 && <span class="text-res-food">{stats.cost.food}f</span>}
          {stats.cost.wood > 0 && <span class="text-res-wood">{stats.cost.wood}w</span>}
          {stats.cost.gold > 0 && <span class="text-res-gold">{stats.cost.gold}g</span>}
          {stats.cost.stone > 0 && <span class="text-res-stone">{stats.cost.stone}s</span>}
        </div>
      )}
    </Card>
  ))}
</div>
