---
// CivMatchups — civ-vs-civ 1v1 win rates from the aoestats archive. Overall
// (civ-matchups.json) plus a per-map breakdown (civ-matchups-by-map.json) the
// reader can switch to via the map dropdown. Shows strongest/weakest matchups.
import matchups from "@data/civ-matchups.json";
import byMapData from "@data/civ-matchups-by-map.json";
import { getCollection } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import { localizedPath } from "@/i18n/utils";
import type { Locale } from "@/i18n/locales";

interface Props {
  slug: string;
  lang: Locale;
}
const { slug, lang } = Astro.props;
const tr = lang === "tr";

type M = { opp: string; games: number; winRate: number };
const overall = ((matchups.civs as Record<string, M[]>)[slug] ?? []).filter((m) => m.winRate !== 50);
const byMapRaw = (byMapData.civs as Record<string, Record<string, M[]>>)[slug] ?? {};
const civNames = new Map((await getCollection("civilizations")).map((c) => [c.id, c.data.name[lang]]));
const numFmt = new Intl.NumberFormat(tr ? "tr-TR" : "en-US");
const prettify = (s: string) => s.split(/[-_]/).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

// Most-played maps for this civ with enough opponents for a clean best/worst.
const mapViews = Object.entries(byMapRaw)
  .filter(([, arr]) => arr.length >= 14)
  .map(([map, arr]) => ({ id: map, label: prettify(map), rows: arr, games: arr.reduce((s, x) => s + x.games, 0) }))
  .sort((a, b) => b.games - a.games)
  .slice(0, 10);

type View = { id: string; label: string; rows: M[] };
const views: View[] = [
  { id: "all", label: tr ? "Tüm haritalar" : "All maps", rows: overall },
  ...mapViews.map((v) => ({ id: v.id, label: v.label, rows: v.rows })),
];
const splitView = (rows: M[]) => [
  { title: tr ? "En güçlü olduğu" : "Strongest against", rows: rows.slice(0, 6) },
  { title: tr ? "En çok zorlandığı" : "Weakest against", rows: [...rows].slice(-6).reverse() },
];
---
{overall.length > 0 && (
  <section class="mt-12" data-civ-matchups>
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-gold-500/30 pb-3">
      <h2 class="font-display text-2xl text-ink">{tr ? "Eşleşmeler" : "Matchups"}</h2>
      <div class="flex items-center gap-2">
        <span class="font-mono text-[11px] uppercase tracking-wide text-stone-700/80">1v1 RM</span>
        {mapViews.length > 0 && (
          <select
            data-mselect
            aria-label={tr ? "Harita seç" : "Select map"}
            class="rounded border border-stone-700/30 bg-parchment px-2 py-1 font-mono text-xs text-ink"
          >
            {views.map((v) => <option value={v.id}>{v.label}</option>)}
          </select>
        )}
      </div>
    </div>

    {views.map((v) => (
      <div data-mview={v.id} hidden={v.id !== "all"} class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {splitView(v.rows).map((col) => (
          <div>
            <h3 class="mb-2 font-mono text-[11px] uppercase tracking-wide text-stone-700">{col.title}</h3>
            <ul class="space-y-0.5">
              {col.rows.map((m) => (
                <li>
                  <a
                    href={localizedPath(`/civs/${m.opp}`, lang)}
                    class="group flex items-center gap-2.5 rounded px-2 py-1.5 transition-colors hover:bg-gold-500/10"
                    title={`${numFmt.format(m.games)} ${tr ? "maç" : "games"}`}
                  >
                    <Icon slug={m.opp} kind="civ" size={24} />
                    <span class="flex-1 truncate font-display text-[15px] text-ink group-hover:text-gold-700">
                      {civNames.get(m.opp) ?? m.opp}
                    </span>
                    <span class="font-mono text-sm font-medium" style={`color:${m.winRate >= 50 ? "#3f6b34" : "#8a2d22"}`}>
                      {m.winRate >= 50 ? "+" : ""}{(m.winRate - 50).toFixed(1)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}

    <p class="mt-3 font-mono text-[10px] tracking-wide text-stone-700/70">
      {tr
        ? "Rakibe karşı kazanma oranının 50%'den farkı (yön puanı). Harita seçince o haritadaki eşleşmeler. Kaynak: aoestats 1v1 RM."
        : "Win-rate edge vs each opponent (points above/below 50%); pick a map for that map's matchups. Source: aoestats 1v1 RM."}
    </p>

    <script>
      for (const root of document.querySelectorAll<HTMLElement>("[data-civ-matchups]")) {
        const sel = root.querySelector<HTMLSelectElement>("[data-mselect]");
        if (!sel) continue;
        sel.addEventListener("change", () => {
          for (const v of root.querySelectorAll<HTMLElement>("[data-mview]")) {
            v.hidden = v.dataset.mview !== sel.value;
          }
        });
      }
    </script>
  </section>
)}
