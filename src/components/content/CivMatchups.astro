---
// CivMatchups — civ-vs-civ win rates from the aoestats archive. 1v1 (overall +
// per-map breakdown) and team (overall only; confounded by the 3 other civs per
// side). Ladder toggle + map selector. Shows strongest/weakest matchups.
import matchups from "@data/civ-matchups.json";
import teamMatchups from "@data/civ-matchups-team.json";
import byMapData from "@data/civ-matchups-by-map.json";
import { getCollection } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import { localizedPath, t } from "@/i18n/utils";
import { displayName } from "@/lib/display";
import type { Locale } from "@/i18n/locales";

interface Props {
  slug: string;
  lang: Locale;
}
const { slug, lang } = Astro.props;
const tr = lang === "tr";

type M = { opp: string; games: number; winRate: number };
const oneOverall = ((matchups.civs as Record<string, M[]>)[slug] ?? []).filter((m) => m.winRate !== 50);
const teamOverall = ((teamMatchups.civs as Record<string, M[]>)[slug] ?? []).filter((m) => m.winRate !== 50);
const byMapRaw = (byMapData.civs as Record<string, Record<string, M[]>>)[slug] ?? {};
const civNames = new Map((await getCollection("civilizations")).map((c) => [c.id, c.data.name[lang]]));
const numFmt = new Intl.NumberFormat(tr ? "tr-TR" : "en-US");

const mapViews = Object.entries(byMapRaw)
  .filter(([, arr]) => arr.length >= 14)
  .map(([map, arr]) => ({ id: map, label: displayName(map), rows: arr, games: arr.reduce((s, x) => s + x.games, 0) }))
  .sort((a, b) => b.games - a.games)
  .slice(0, 10);

type View = { id: string; rows: M[] };
const views: View[] = [
  { id: "1v1-all", rows: oneOverall },
  ...mapViews.map((v) => ({ id: `1v1-${v.id}`, rows: v.rows })),
];
const hasTeam = teamOverall.length > 0;
if (hasTeam) views.push({ id: "team-all", rows: teamOverall });

// Split the (win-rate-descending) rows into strongest/weakest WITHOUT overlap:
// with < 12 rows a plain slice(0,6)/slice(-6) would show the same opponent — and
// its positive edge — under both columns. Strongest takes the first ceil(n/2)
// (capped at 6); weakest takes the remainder (capped at 6, weakest-first).
const split = (rows: M[]) => {
  const half = Math.min(6, Math.ceil(rows.length / 2));
  return [
    { title: tr ? "En güçlü olduğu" : "Strongest against", rows: rows.slice(0, half) },
    { title: tr ? "En çok zorlandığı" : "Weakest against", rows: rows.slice(half).slice(-6).reverse() },
  ];
};
---
{oneOverall.length > 0 && (
  <section class="mt-8" data-civ-matchups>
    <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-gold-500/30 pb-3">
      <h2 class="font-display text-2xl text-ink">{tr ? "Eşleşmeler" : "Matchups"}</h2>
      <div class="flex flex-wrap items-center gap-2">
        {hasTeam && (
          <div class="flex overflow-hidden rounded border border-stone-700/30 font-mono text-[11px] uppercase" data-ladder>
            <button type="button" data-val="1v1" class="px-3 py-1 text-ink data-[on]:bg-royal data-[on]:text-parchment">1v1</button>
            <button type="button" data-val="team" class="border-l border-stone-700/30 px-3 py-1 text-ink data-[on]:bg-royal data-[on]:text-parchment">{tr ? "Takım" : "Team"}</button>
          </div>
        )}
        {mapViews.length > 0 && (
          <select
            data-mselect
            data-team-hint={tr ? "Harita kırılımı sadece 1v1'de" : "Per-map breakdown is 1v1 only"}
            aria-label={tr ? "Harita seç" : "Select map"}
            class="select-field transition-opacity"
          >
            <option value="all">{tr ? "Tüm haritalar" : "All maps"}</option>
            {mapViews.map((v) => <option value={v.id}>{v.label}</option>)}
          </select>
        )}
      </div>
    </div>

    {views.map((v) => (
      <div data-view={v.id} hidden={v.id !== "1v1-all"} class="mt-4 grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {split(v.rows).filter((col) => col.rows.length > 0).map((col) => (
          <div>
            <h3 class="mb-1.5 font-mono text-[11px] uppercase tracking-wide text-stone-700">{col.title}</h3>
            <ul class="space-y-0.5">
              {col.rows.map((m) => (
                <li>
                  <a
                    href={localizedPath(`/civs/${m.opp}`, lang)}
                    class="group flex items-center gap-2.5 rounded px-2 py-1 transition-colors hover:bg-gold-500/10"
                    title={`${numFmt.format(m.games)} ${tr ? "maç" : "games"}`}
                  >
                    <Icon slug={m.opp} kind="civ" size={24} />
                    <span class="flex-1 truncate font-display text-[15px] text-ink group-hover:text-gold-700">
                      {civNames.get(m.opp) ?? m.opp}
                    </span>
                    <span class="w-10 flex-none text-right font-mono text-sm font-medium" style={`color:${m.winRate >= 50 ? "var(--color-fav)" : "var(--color-wr-bad)"}`}>
                      {m.winRate >= 50 ? "+" : ""}{(m.winRate - 50).toFixed(1)}
                    </span>
                    <span class="w-12 flex-none text-right font-mono text-[10px] text-stone-700/50">
                      {m.games >= 1000 ? `${Math.round(m.games / 1000)}k` : m.games}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}

    <p class="mt-3 font-mono text-[10px] tracking-wide text-stone-700/70">
      {tr
        ? "Rakibe karşı kazanma yön puanı (50% = ortalama). Takım = rakip takımdayken; 3 diğer civ ile confound'lu. "
        : "Win-rate edge vs each opponent (50% = average). Team = when the opponent is on the enemy side; confounded by the 3 other civs. "}
      {t(lang, "data.source")}
    </p>

    {/* is:inline (forced by data-astro-rerun) — plain JS ONLY, no TS generics:
        `querySelectorAll<HTMLElement>` would ship verbatim and throw at runtime
        (the `<T>` parses as comparison operators). */}
    <script is:inline data-astro-rerun>
      for (const root of document.querySelectorAll("[data-civ-matchups]")) {
        const ladderGroup = root.querySelector("[data-ladder]");
        const sel = root.querySelector("[data-mselect]");
        const state = { ladder: "1v1", map: "all" };
        const sync = () => {
          const want = state.ladder === "team" ? "team-all" : `1v1-${state.map}`;
          for (const v of root.querySelectorAll("[data-view]")) v.hidden = v.dataset.view !== want;
          if (sel) {
            // team has no per-map breakdown — disable (don't hide) the map picker
            sel.disabled = state.ladder === "team";
            sel.classList.toggle("opacity-40", state.ladder === "team");
            sel.title = state.ladder === "team" ? (sel.dataset.teamHint || "") : "";
          }
          if (ladderGroup) {
            for (const b of ladderGroup.querySelectorAll("button")) {
              if (b.dataset.val === state.ladder) b.setAttribute("data-on", "");
              else b.removeAttribute("data-on");
            }
          }
        };
        if (ladderGroup) {
          for (const b of ladderGroup.querySelectorAll("button")) {
            b.addEventListener("click", () => {
              state.ladder = b.dataset.val || "1v1";
              sync();
            });
          }
        }
        if (sel) sel.addEventListener("change", () => { state.map = sel.value; sync(); });
        sync();
      }
    </script>
  </section>
)}
