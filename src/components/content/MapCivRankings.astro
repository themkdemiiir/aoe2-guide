---
// MapCivRankings — "best civs on this map", inverted from the aoestats archive
// (src/data/map-meta.json). Per map: every civ ranked by win rate, with a
// ladder toggle (Team / 1v1) and an elo toggle (All / 1650+). Bilingual.
import mapMeta from "@data/map-meta.json";
import { getCollection } from "astro:content";
import Icon from "@/components/ui/Icon.astro";
import { localizedPath } from "@/i18n/utils";
import { resolveMetaKey } from "@/lib/data-maps";
import type { Locale } from "@/i18n/locales";

interface Props {
  mapSlug: string;
  lang: Locale;
}
const { mapSlug, lang } = Astro.props;
const tr = lang === "tr";

type Row = { civ: string; games: number; winRate: number };
type Tiers = { all: Row[]; high: Row[] } | null;
const key = resolveMetaKey(mapSlug);
const md = key ? (mapMeta.maps as Record<string, { games: { "1v1": number; team: number }; "1v1": Tiers; team: Tiers }>)[key] : null;

const civNames = new Map((await getCollection("civilizations")).map((c) => [c.id, c.data.name[lang]]));

// the four (ladder × tier) views; only those with data are emitted
const COMBOS = [
  { id: "team-all", ladder: "team" as const, tier: "all" as const },
  { id: "team-high", ladder: "team" as const, tier: "high" as const },
  { id: "1v1-all", ladder: "1v1" as const, tier: "all" as const },
  { id: "1v1-high", ladder: "1v1" as const, tier: "high" as const },
];
const views = md
  ? COMBOS.map((c) => ({ ...c, rows: md[c.ladder]?.[c.tier] ?? [] })).filter((v) => v.rows.length)
  : [];
const hasTeam = !!md?.team;
const defaultId = hasTeam ? "team-all" : "1v1-all";
const fill = (w: number) => Math.max(3, Math.min(100, ((w - 35) / 30) * 100));
const fmt = new Intl.NumberFormat(lang === "tr" ? "tr-TR" : "en-US");
---
{views.length > 0 && (
  <section class="mt-12" data-map-civs data-default={defaultId}>
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-gold-500/30 pb-3">
      <div>
        <h2 class="font-display text-2xl text-ink">{tr ? "Bu haritada en iyi uygarlıklar" : "Best civs on this map"}</h2>
        <p class="mt-1 text-sm text-stone-700">
          {tr ? "Ranked kazanma oranına göre — aoestats arşivi." : "Ranked by win rate — aoestats archive."}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 font-mono text-[11px] uppercase tracking-wide">
        <div class="flex overflow-hidden rounded border border-stone-700/30" role="group" data-toggle="ladder">
          <button type="button" data-val="team" class="px-3 py-1.5 text-ink data-[on]:bg-royal data-[on]:text-parchment">{tr ? "Takım" : "Team"}</button>
          <button type="button" data-val="1v1" class="border-l border-stone-700/30 px-3 py-1.5 text-ink data-[on]:bg-royal data-[on]:text-parchment">1v1</button>
        </div>
        <div class="flex overflow-hidden rounded border border-stone-700/30" role="group" data-toggle="tier">
          <button type="button" data-val="all" class="px-3 py-1.5 text-ink data-[on]:bg-gold-700 data-[on]:text-parchment">{tr ? "Tüm Elo" : "All Elo"}</button>
          <button type="button" data-val="high" class="border-l border-stone-700/30 px-3 py-1.5 text-ink data-[on]:bg-gold-700 data-[on]:text-parchment">1650+</button>
        </div>
      </div>
    </div>

    {views.map((v) => (
      <ol data-view={v.id} hidden={v.id !== defaultId} class="mt-5 space-y-1">
        {v.rows.map((r, i) => (
          <li class="flex items-center gap-3 rounded px-2 py-1.5 odd:bg-stone-700/[0.04]">
            <span class="w-6 flex-none text-right font-mono text-xs text-stone-700/70">{i + 1}</span>
            <Icon slug={r.civ} kind="civ" size={26} />
            <a
              href={localizedPath(`/civs/${r.civ}`, lang)}
              class="w-32 flex-none truncate font-display text-[15px] text-ink hover:text-gold-700"
            >
              {civNames.get(r.civ) ?? r.civ}
            </a>
            <span class="relative hidden h-2 flex-1 overflow-hidden rounded-full bg-stone-700/10 sm:block">
              <span class="absolute inset-y-0 left-0 rounded-full" style={`width:${fill(r.winRate)}%;background:${r.winRate >= 50 ? "#c79a3c" : "#8a2d22"}`}></span>
            </span>
            <span class="w-14 flex-none text-right font-mono text-sm font-medium" style={`color:${r.winRate >= 50 ? "#8a6a1f" : "#8a2d22"}`}>{r.winRate}%</span>
            <span class="w-16 flex-none text-right font-mono text-[11px] text-stone-700/60">{fmt.format(r.games)}</span>
          </li>
        ))}
      </ol>
    ))}
    <p class="mt-3 font-mono text-[10px] tracking-wide text-stone-700/70">
      {tr
        ? "Takım oyununda pozisyon (pocket/flank) winrate'i etkiler; 1650+ örneklemi daha incedir. 50% = ortalama."
        : "In team games, position (pocket/flank) skews win rate; the 1650+ sample is thinner. 50% = average."}
    </p>
  </section>
)}

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-map-civs]")) {
    const [defLadder, defTier] = (root.dataset.default ?? "team-all").split("-");
    const state = { ladder: defLadder, tier: defTier };
    const views = root.querySelectorAll<HTMLElement>("[data-view]");

    const sync = () => {
      const want = `${state.ladder}-${state.tier}`;
      let shown = false;
      for (const v of views) {
        const on = v.dataset.view === want;
        v.hidden = !on;
        if (on) shown = true;
      }
      // fall back to an existing view if the chosen combo has no data
      if (!shown && views.length) {
        views[0].hidden = false;
        const [l, t] = (views[0].dataset.view ?? "").split("-");
        state.ladder = l; state.tier = t;
      }
      for (const group of root.querySelectorAll<HTMLElement>("[data-toggle]")) {
        const kind = group.dataset.toggle as "ladder" | "tier";
        for (const btn of group.querySelectorAll<HTMLButtonElement>("button")) {
          if (btn.dataset.val === state[kind]) btn.setAttribute("data-on", "");
          else btn.removeAttribute("data-on");
        }
      }
    };

    for (const group of root.querySelectorAll<HTMLElement>("[data-toggle]")) {
      const kind = group.dataset.toggle as "ladder" | "tier";
      for (const btn of group.querySelectorAll<HTMLButtonElement>("button")) {
        btn.addEventListener("click", () => {
          state[kind] = btn.dataset.val ?? state[kind];
          sync();
        });
      }
    }
    sync();
  }
</script>
