---
// CivStats — real ranked stats for a civ from src/data/civ-meta.json, rendered as
// Chart.js charts (byElo win-rate, byPatch trend, byMap performance). Bilingual.
import civMeta from "@data/civ-meta.json";
import cubeDims from "@data/civ-cube-dims.json";
import { getCollection } from "astro:content";
import { localizedPath, t } from "@/i18n/utils";
import type { Locale } from "@/i18n/locales";

interface Props {
  slug: string;
  lang: Locale;
}
const { slug, lang } = Astro.props;

// Dropdown options for the combinable slice filter (Map × Elo × Patch). The
// intersection is computed in the browser from the fetched cube (civ-meta only
// has the separate marginals, which can't be combined).
const cdims = cubeDims as { elos: string[]; maps: string[]; mapNames: string[] };
const sliceMaps = cdims.maps.map((key, i) => ({ key, name: cdims.mapNames[i] }));
const slicePatches = (civMeta.patches as { patch: string; label: string }[]) ?? [];

type Slice = { games: number; winRate: number };
type Ladder = {
  games: number; winRate: number; ci95: [number, number]; playRate: number; tier: string;
  byElo: Record<string, Slice>; byPatch: Record<string, Slice>; byMap: Record<string, Slice>;
};
const civ = (civMeta.civs as unknown as Record<string, { "1v1": Ladder | null; team: Ladder | null }>)[slug];
const one = civ?.["1v1"] ?? null;
const team = civ?.team ?? null;
const latestPatch = (civMeta.patches?.[0] as { label?: string } | undefined)?.label ?? "";

const tr = lang === "tr";
const eloOrder = (civMeta.eloBuckets as string[]) ?? [];

// byElo (fixed bucket order; carry games so thin top buckets are honest)
const eloKeys = one ? eloOrder.filter((b) => one.byElo[b]) : [];
const elo = eloKeys.length
  ? { labels: eloKeys, values: eloKeys.map((b) => one!.byElo[b].winRate), games: eloKeys.map((b) => one!.byElo[b].games) }
  : null;
// byPatch (chronological)
const patchLabel = Object.fromEntries(((civMeta.patches as { patch: string; label: string }[]) ?? []).map((p) => [p.patch, p.label]));
const patchRows = one ? Object.entries(one.byPatch).map(([p, v]) => [p, v.winRate, v.games] as [string, number, number]).sort((a, b) => a[0].localeCompare(b[0])) : [];
const patch = patchRows.length
  ? { labels: patchRows.map((r) => patchLabel[r[0]] ?? r[0]), values: patchRows.map((r) => r[1]), games: patchRows.map((r) => r[2]) }
  : null;
// byMap — sorted by WIN RATE (best maps first), each linking to its map page
// when one exists. aoestats keys use underscores; map slugs use hyphens.
const pretty = (m: string) => m.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const mapSlugs = new Set((await getCollection("maps")).map((m) => m.id));
const mapList = one
  ? Object.entries(one.byMap)
      .sort((a, b) => b[1].winRate - a[1].winRate)
      .slice(0, 10)
      .map(([m, v]) => {
        const slug = m.replace(/_/g, "-");
        return {
          name: pretty(m),
          winRate: v.winRate,
          games: v.games,
          href: mapSlugs.has(slug) ? localizedPath(`/maps/${slug}`, lang) : null,
        };
      })
  : [];
---
{one && (
  <section class="mt-6" data-civ-stats>
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="font-display text-2xl text-ink">{tr ? "Ranked İstatistikler" : "Ranked Stats"}</h2>
      <span class="font-mono text-[11px] uppercase tracking-wide text-stone-700/80">1v1 RM · {latestPatch}</span>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded border border-stone-700/20 bg-parchment/60 p-2.5">
        <div class="font-mono text-[10px] uppercase tracking-wide text-stone-700">Tier</div>
        <div class="font-display text-2xl text-gold-700">{one.tier}</div>
      </div>
      <div class="rounded border border-stone-700/20 bg-parchment/60 p-2.5">
        <div class="font-mono text-[10px] uppercase tracking-wide text-stone-700">{tr ? "Kazanma" : "Win rate"}</div>
        <div class="font-display text-2xl text-ink">{one.winRate}%</div>
        <div class="font-mono text-[10px] text-stone-700/70">±{((one.ci95[1] - one.ci95[0]) / 2).toFixed(1)}</div>
      </div>
      <div class="rounded border border-stone-700/20 bg-parchment/60 p-2.5">
        <div class="font-mono text-[10px] uppercase tracking-wide text-stone-700">{tr ? "Oynanma" : "Play rate"}</div>
        <div class="font-display text-2xl text-ink">{one.playRate}%</div>
      </div>
      <div class="rounded border border-stone-700/20 bg-parchment/60 p-2.5">
        <div class="font-mono text-[10px] uppercase tracking-wide text-stone-700">{tr ? "Takım" : "Team"}</div>
        <div class="font-display text-2xl text-ink">{team ? `${team.winRate}%` : "—"}</div>
        {team && <div class="font-mono text-[10px] text-stone-700/70">{team.tier}</div>}
      </div>
    </div>

    {/* Combinable slice filter: this civ's win rate for any Map × Elo × Patch
        intersection, computed in-browser from the fetched cube. Hidden until JS;
        the tiles + charts above/below stay the overall view (no-JS friendly). */}
    <div data-civ-filter data-slug={slug} hidden class="mt-4 rounded border border-stone-700/20 bg-parchment/60 p-3">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] uppercase tracking-wide text-stone-700">
        <span class="text-stone-700/80">{tr ? "Dilim" : "Slice"}</span>
        <label class="flex items-center gap-1.5">{tr ? "Harita" : "Map"}
          <select data-cf="map" class="select-field normal-case">
            <option value="">{tr ? "Tüm haritalar" : "Any map"}</option>
            {sliceMaps.map((m) => <option value={m.key}>{m.name}</option>)}
          </select>
        </label>
        <label class="flex items-center gap-1.5">Elo
          <select data-cf="elo" class="select-field normal-case">
            <option value="">{tr ? "Tüm elo" : "Any elo"}</option>
            {cdims.elos.map((b) => <option value={b}>{b}</option>)}
            <option disabled>──</option>
            <option value="cum:1650">1650+</option>
            <option value="cum:1800">1800+</option>
            <option value="cum:2000">2000+</option>
          </select>
        </label>
        <label class="flex items-center gap-1.5">{tr ? "Yama" : "Patch"}
          <select data-cf="patch" class="select-field normal-case">
            <option value="">{tr ? "Tüm zamanlar" : "All-time"}</option>
            {slicePatches.map((p, i) => <option value={p.patch}>{i === 0 ? (tr ? `Güncel · ${p.label}` : `Current · ${p.label}`) : p.label}</option>)}
          </select>
        </label>
        <button type="button" data-cf-reset hidden class="rounded border border-stone-700/30 px-2 py-1 text-[10px] hover:border-gold-500 hover:text-gold-500">{tr ? "Sıfırla" : "Reset"}</button>
      </div>
      <div data-cf-load hidden class="mt-2 font-mono text-[11px] text-stone-700/60">{tr ? "veri yükleniyor…" : "loading data…"}</div>
      <div data-cf-out hidden class="mt-2.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span data-cf-label class="font-mono text-[11px] text-stone-700/80"></span>
        <span data-cf-wr class="font-display text-2xl leading-none">—</span>
        <span data-cf-tier class="font-display text-lg font-bold leading-none"></span>
        <span data-cf-games class="font-mono text-[11px] text-stone-700/60"></span>
      </div>
    </div>

    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      {elo && (
        <div class="rounded border border-stone-700/20 bg-parchment/60 p-3">
          <h3 class="font-mono text-[11px] uppercase tracking-wide text-stone-700">{tr ? "Elo'ya göre kazanma" : "Win rate by Elo"}</h3>
          <div class="mt-2 h-40"><div role="img" aria-label={t(lang, "ui.chartWinByElo")} data-chart="elo" data-labels={JSON.stringify(elo.labels)} data-values={JSON.stringify(elo.values)} data-games={JSON.stringify(elo.games)} class="h-full w-full"></div></div>
        </div>
      )}
      {mapList.length > 0 && (
        <div class="rounded border border-stone-700/20 bg-parchment/60 p-3">
          <h3 class="font-mono text-[11px] uppercase tracking-wide text-stone-700">{tr ? "Haritaya göre kazanma" : "Win rate by map"}</h3>
          <ul class="mt-3 space-y-1">
            {mapList.map((m) => {
              const Tag = m.href ? "a" : "div";
              const fill = Math.max(3, Math.min(100, ((m.winRate - 38) / 24) * 100));
              return (
                <li>
                  <Tag
                    {...(m.href ? { href: m.href } : {})}
                    title={`${m.games.toLocaleString(tr ? "tr-TR" : "en-US")} ${tr ? "maç" : "games"}`}
                    class:list={["group flex items-center gap-2.5 rounded px-1.5 py-1", m.href && "transition-colors hover:bg-gold-500/10"]}
                  >
                    <span class="flex w-28 flex-none items-center gap-1 truncate text-sm text-ink group-hover:text-gold-700">
                      {m.name}
                      {m.href && <span class="text-[10px] text-gold-700/60">↗</span>}
                    </span>
                    <span class="relative h-2 flex-1 overflow-hidden rounded-full bg-stone-700/10">
                      <span class="absolute inset-y-0 left-0 rounded-full" style={`width:${fill}%;background:${m.winRate >= 50 ? "var(--color-wr-good)" : "var(--color-wr-bad)"}`}></span>
                    </span>
                    <span class="w-11 flex-none text-right font-mono text-xs text-stone-700">{m.winRate}%</span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {patch && (
        <div class="rounded border border-stone-700/20 bg-parchment/60 p-3 lg:col-span-2">
          <h3 class="font-mono text-[11px] uppercase tracking-wide text-stone-700">{tr ? "Patch'e göre kazanma" : "Win rate by patch"}</h3>
          <div class="mt-2 h-40"><div role="img" aria-label={t(lang, "ui.chartWinByPatch")} data-chart="patch" data-labels={JSON.stringify(patch.labels)} data-values={JSON.stringify(patch.values)} data-games={JSON.stringify(patch.games)} class="h-full w-full"></div></div>
        </div>
      )}
    </div>
    <p class="mt-3 font-mono text-[10px] tracking-wide text-stone-700/70">
      {t(lang, "data.source")} · {tr ? "50% = ortalama" : "50% = average"}
    </p>
  </section>
)}

<script>
  import { BarChart, LineChart } from "echarts/charts";
  import { GridComponent, MarkLineComponent, TooltipComponent } from "echarts/components";
  import { type ECharts, echarts, mountChart, themeColors } from "@/lib/echarts";
  import { tierOf, TIER_COLORS } from "@/lib/tiers";

  echarts.use([BarChart, LineChart, GridComponent, TooltipComponent, MarkLineComponent]);

  const mono = "'JetBrains Mono', ui-monospace, monospace";
  const charts = new Map<HTMLElement, { chart: ECharts; dispose: () => void }>();

  // "<1000" -> "<1k", "1000-1199" -> "1k", "1650-1799" -> "1.65k", "2500+" -> "2.5k+"
  const abbrevElo = (s: string) => {
    const lead = s.match(/\d+/);
    if (!lead) return s;
    const n = +lead[0];
    const k = n % 1000 === 0 ? `${n / 1000}k` : `${(n / 1000).toFixed(2).replace(/0$/, "")}k`;
    return s.startsWith("<") ? `<${k}` : s.endsWith("+") ? `${k}+` : k;
  };

  // Wrapped in astro:page-load so charts + the slice filter re-initialise after
  // ClientRouter navigations. Colors read from theme tokens each run (light/dark).
  function initCivStats() {
    const numLocale = document.documentElement.lang === "tr" ? "tr-TR" : "en-US";
    const isTr = document.documentElement.lang === "tr";
    const gamesWord = isTr ? "maç" : "games";
    const wrWord = isTr ? "kazanma" : "win rate";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const num = (el: HTMLElement, k: string): unknown[] => JSON.parse(el.dataset[k] || "[]");

    for (const el of document.querySelectorAll<HTMLElement>("[data-civ-stats] [data-chart]")) {
      const kind = el.dataset.chart;
      const labels = num(el, "labels") as string[];
      const values = num(el, "values") as number[];
      const games = num(el, "games") as number[];
      if (!values.length) continue;

      // Win rates cluster near 50%, so a zero-based axis crushes the real spread.
      // byElo: diverging bars grown from the 50% line (matches the map leaderboard).
      // byPatch: a trend line on an honest, padded window. Both draw a 50% baseline.
      const paint = (chart: ECharts) => {
        const c = themeColors();
        const tooltip = {
          trigger: "axis" as const,
          backgroundColor: c.surface,
          borderColor: c.gold,
          borderWidth: 1,
          padding: [6, 10],
          textStyle: { color: c.ink, fontFamily: mono, fontSize: 11 },
          extraCssText: "border-radius:4px;box-shadow:0 3px 14px rgba(0,0,0,0.2);",
          formatter: (ps: { dataIndex: number }[]) => {
            const i = ps[0].dataIndex;
            const g = games[i] != null ? ` · ${games[i].toLocaleString(numLocale)} ${gamesWord}` : "";
            return `${labels[i]}<br/><b style="font-size:14px">${values[i].toFixed(1)}%</b> ${wrWord}${g}`;
          },
        };
        if (kind === "patch") {
          const lo = Math.floor(Math.min(48, ...values) - 1);
          const hi = Math.ceil(Math.max(52, ...values) + 1);
          chart.setOption(
            {
              animation: !reducedMotion,
              grid: { left: 4, right: 12, top: 12, bottom: 18, containLabel: true },
              tooltip,
              xAxis: {
                type: "category",
                data: labels,
                boundaryGap: false,
                axisLabel: { color: c.muted, fontFamily: mono, fontSize: 9, hideOverlap: true, rotate: labels.length > 6 ? 30 : 0 },
                axisLine: { lineStyle: { color: c.muted, opacity: 0.3 } },
                axisTick: { show: false },
              },
              yAxis: {
                type: "value",
                min: lo,
                max: hi,
                axisLabel: { formatter: (v: number) => `${v}%`, color: c.muted, fontFamily: mono, fontSize: 10 },
                splitLine: { lineStyle: { color: c.muted, opacity: 0.14 } },
              },
              series: [
                {
                  type: "line",
                  data: values,
                  smooth: 0.25,
                  symbol: "circle",
                  symbolSize: 5,
                  lineStyle: { color: c.gold, width: 2 },
                  itemStyle: { color: c.gold },
                  areaStyle: { color: `color-mix(in srgb, ${c.gold} 12%, transparent)` },
                  markLine: { silent: true, symbol: "none", label: { show: false }, lineStyle: { color: c.ink, opacity: 0.35, width: 1.5 }, data: [{ yAxis: 50 }] },
                },
              ],
            },
            { notMerge: true },
          );
        } else {
          const ext = Math.max(4, Math.ceil(Math.max(...values.map((v) => Math.abs(v - 50) + 1)) / 2) * 2);
          chart.setOption(
            {
              animation: !reducedMotion,
              grid: { left: 4, right: 8, top: 20, bottom: 22, containLabel: true },
              tooltip,
              xAxis: {
                type: "category",
                data: labels.map(abbrevElo),
                axisLabel: { color: c.muted, fontFamily: mono, fontSize: 10, interval: 0, rotate: labels.length > 6 ? 32 : 0 },
                axisLine: { lineStyle: { color: c.muted, opacity: 0.3 } },
                axisTick: { show: false },
              },
              yAxis: {
                type: "value",
                min: -ext,
                max: ext,
                interval: ext / 2,
                axisLabel: { formatter: (v: number) => `${v + 50}%`, color: c.muted, fontFamily: mono, fontSize: 10 },
                splitLine: { lineStyle: { color: c.muted, opacity: 0.14 } },
              },
              series: [
                {
                  type: "bar",
                  barWidth: "52%",
                  data: values.map((v) => {
                    const d = +(v - 50).toFixed(2);
                    return {
                      value: d,
                      itemStyle: { color: d >= 0 ? c.good : c.bad, borderRadius: d >= 0 ? [3, 3, 0, 0] : [0, 0, 3, 3] },
                      label: { position: (d >= 0 ? "top" : "bottom") as "top" | "bottom" },
                    };
                  }),
                  label: { show: true, color: c.ink, fontFamily: mono, fontSize: 10, formatter: (p: { dataIndex: number }) => `${values[p.dataIndex].toFixed(1)}%` },
                  markLine: { silent: true, symbol: "none", label: { show: false }, lineStyle: { color: c.ink, opacity: 0.4, width: 1.5 }, data: [{ yAxis: 0 }] },
                },
              ],
            },
            { notMerge: true },
          );
        }
      };

      charts.get(el)?.dispose();
      const mounted = mountChart(el, { onThemeChange: () => paint(mounted.chart) });
      charts.set(el, mounted);
      paint(mounted.chart);
    }

  // --- Per-civ slice filter: this civ's win rate for any Map × Elo × Patch
  // intersection, summed in-browser from the fetched cube. ---
  const cf = document.querySelector<HTMLElement>("[data-civ-filter]");
  if (cf) {
    const isTr = document.documentElement.lang === "tr";
    const gamesWord = isTr ? "maç" : "games";
    const lowWord = isTr ? "yetersiz veri" : "low sample";
    const slug = cf.dataset.slug!;
    const q = <T extends Element>(s: string) => cf.querySelector<T>(s)!;
    const sel = {
      map: q<HTMLSelectElement>('[data-cf="map"]'),
      elo: q<HTMLSelectElement>('[data-cf="elo"]'),
      patch: q<HTMLSelectElement>('[data-cf="patch"]'),
    };
    const out = q<HTMLElement>("[data-cf-out]");
    const loadEl = q<HTMLElement>("[data-cf-load]");
    const reset = q<HTMLButtonElement>("[data-cf-reset]");
    const elWr = q<HTMLElement>("[data-cf-wr]");
    const elTier = q<HTMLElement>("[data-cf-tier]");
    const elGames = q<HTMLElement>("[data-cf-games]");
    const elLabel = q<HTMLElement>("[data-cf-label]");
    type Cube = { civs: string[]; elos: string[]; maps: string[]; months: { patch: string }[]; rows: number[][]; _ci: number; _ei: Record<string, number>; _mi: Record<string, number>; _pi: Record<string, number> };
    let cube: Cube | null = null;
    let req: Promise<Cube> | null = null;
    const loadCube = () => {
      if (cube) return Promise.resolve(cube);
      if (!req) req = fetch("/civ-cube.json").then((r) => r.json()).then((c: Cube) => {
        c._ci = c.civs.indexOf(slug);
        c._ei = Object.fromEntries(c.elos.map((e, i) => [e, i]));
        c._mi = Object.fromEntries(c.maps.map((m, i) => [m, i]));
        c._pi = Object.fromEntries(c.months.map((p, i) => [p.patch, i]));
        cube = c; return c;
      });
      return req;
    };
    const isDefault = () => !sel.map.value && !sel.elo.value && !sel.patch.value;

    async function update() {
      reset.hidden = isDefault();
      if (isDefault()) { out.hidden = true; return; }
      loadEl.hidden = false;
      const c = await loadCube();
      loadEl.hidden = true;
      out.hidden = false;
      const parts: string[] = [];
      if (sel.map.value) parts.push(sel.map.options[sel.map.selectedIndex].text);
      if (sel.elo.value) parts.push(sel.elo.options[sel.elo.selectedIndex].text);
      if (sel.patch.value) parts.push(sel.patch.options[sel.patch.selectedIndex].text.replace(/^Current · |^Güncel · /, ""));
      elLabel.textContent = parts.join(" · ");
      // Elo: an exact band (eIdx), or a cumulative "X+" cut summing every band ≥ the
      // edge — thin high-elo bands pool into a stable, exact Σwins/Σgames win rate.
      const eloVal = sel.elo.value;
      const cumStart = eloVal.startsWith("cum:") ? c.elos.findIndex((b) => Number.parseInt(b, 10) >= +eloVal.slice(4)) : -1;
      const eIdx = eloVal && cumStart < 0 ? (c._ei[eloVal] ?? -1) : -1;
      const mIdx = sel.map.value ? (c._mi[sel.map.value] ?? -2) : -1;
      // -2 = selected month absent from the cube (metas can be regenerated
      // separately) → show "no data", never silently drop the filter.
      const pIdx = sel.patch.value ? (c._pi[sel.patch.value] ?? -2) : -1;
      let g = 0, w = 0;
      if (c._ci >= 0 && mIdx !== -2 && pIdx !== -2) {
        for (const r of c.rows) {
          if (r[0] !== c._ci) continue;
          if (cumStart >= 0 ? r[1] < cumStart : eIdx >= 0 && r[1] !== eIdx) continue;
          if (mIdx >= 0 && r[2] !== mIdx) continue;
          if (pIdx >= 0 && r[3] !== pIdx) continue;
          g += r[4]; w += r[5];
        }
      }
      if (g > 0) {
        const wr = +((w / g) * 100).toFixed(2);
        const t = tierOf(wr);
        elWr.textContent = `${wr}%`;
        elWr.style.color = wr >= 50 ? "var(--color-wr-good)" : "var(--color-wr-bad)";
        elTier.textContent = t;
        elTier.style.color = TIER_COLORS[t];
        elGames.textContent = `${g.toLocaleString(numLocale)} ${gamesWord}`;
      } else {
        elWr.textContent = "—";
        elWr.style.color = "";
        elTier.textContent = "";
        elGames.textContent = `(${lowWord})`;
      }
    }

    for (const s of Object.values(sel)) s.addEventListener("change", update);
    reset.addEventListener("click", () => { sel.map.value = ""; sel.elo.value = ""; sel.patch.value = ""; update(); });
    cf.hidden = false;
    }
  }

  document.addEventListener("astro:page-load", initCivStats);
  // Dispose ECharts instances on ClientRouter navigation so they don't leak.
  document.addEventListener("astro:before-swap", () => {
    for (const { dispose } of charts.values()) dispose();
    charts.clear();
  });
</script>
