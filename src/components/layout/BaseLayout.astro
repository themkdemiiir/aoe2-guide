---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { localeMeta } from "@/i18n/locales";
import { getLocaleFromUrl, allLocalePaths, t } from "@/i18n/utils";
import type { UIKey } from "@/i18n/ui";

interface Props {
  title: string;
  /** REQUIRED and page-specific: a shared fallback made 395 pages duplicate one description (Google ignores those). */
  description: string;
  /** Path WITHOUT locale prefix, used for hreflang and lang switcher. e.g. "/civs/britons" */
  canonicalPath?: string;
  /** Plain entry name for the breadcrumb leaf on detail pages (titles carry SEO tails); falls back to `title`. */
  breadcrumbName?: string;
  /** Pages that must stay out of the index (404, /search/): robots noindex, no canonical/hreflang/breadcrumb — on error pages those tags mint crawlable dead URLs. */
  noindex?: boolean;
}

const { title, description, canonicalPath = "/", breadcrumbName, noindex = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const dir = localeMeta[locale].dir;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const alternates = allLocalePaths(canonicalPath);
// Trailing slash matches the served URLs + sitemap (the slashless form 308s on
// CF Pages — canonicals must not point at redirects).
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const canonical = withSlash(`${site}/${locale}${canonicalPath}`);
// Per-page Open Graph card from scripts/build-og.mjs (/og/<seg>/<slug>.png);
// non-detail pages fall back to the default card. Language-agnostic (English title).
const ogMatch = canonicalPath.match(/^\/(civs|builds|units|maps)\/([^/]+)\/?$/);
const ogImage = `${site}/og${ogMatch ? `/${ogMatch[1]}/${ogMatch[2]}` : "/default"}.png`;

// Append brand suffix unless the title already identifies the site.
const fullTitle = title.includes("AOE2") ? title : `${title} | AOE2 Guide`;

// JSON-LD structured data — WebSite schema for rich results.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AOE2 Guide",
  url: site,
  description,
  inLanguage: locale,
  publisher: {
    "@type": "Organization",
    name: "AOE2 Guide",
    url: site,
    // 180×180 — favicon.png (32×32) is below Google's 112px logo floor.
    logo: { "@type": "ImageObject", url: `${site}/apple-touch-icon.png`, width: 180, height: 180 },
  },
};

// BreadcrumbList + visible trail — computed from canonicalPath; skipped on homepage.
// Section labels resolve through i18n so TR pages carry Turkish crumbs in both.
const sectionLabelKeys: Record<string, UIKey> = {
  civs: "nav.civs", builds: "nav.builds", maps: "nav.maps",
  units: "nav.units", counters: "nav.counters", glossary: "nav.glossary",
  learn: "nav.learn", matchups: "nav.matchups", analyzer: "analyzer.title",
  explorer: "nav.explorer", blog: "blog.title",
};
const pathParts = canonicalPath.split("/").filter(Boolean);
const sectionKey = sectionLabelKeys[pathParts[0]];
const sectionLabel = sectionKey ? t(locale, sectionKey) : null;
const leafName = breadcrumbName ?? title;
const breadcrumbLd = pathParts.length > 0 && !noindex ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "AOE2 Guide", item: `${site}/${locale}/` },
    ...(sectionLabel ? [
      { "@type": "ListItem", position: 2, name: sectionLabel, item: withSlash(`${site}/${locale}/${pathParts[0]}`) },
    ] : []),
    ...(pathParts[1] ? [
      { "@type": "ListItem", position: 3, name: leafName, item: withSlash(`${site}/${locale}${canonicalPath}`) },
    ] : []),
  ],
} : null;
// Visible trail mirrors the JSON-LD exactly; detail pages only (depth ≥ 2).
const crumbs: { label: string; href?: string }[] | null =
  !noindex && pathParts.length > 1 && sectionLabel
    ? [
        { label: "AOE2 Guide", href: `/${locale}/` },
        { label: sectionLabel, href: withSlash(`/${locale}/${pathParts[0]}`) },
        { label: leafName },
      ]
    : null;
---
<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <script is:inline>
      // Cloudflare keeps the project's *.pages.dev hostnames permanently (the bare
      // alias AND every per-deploy hash subdomain). Bounce ALL of them to the
      // canonical domain so the live site is only ever served from aoe2guide.com.
      if (location.hostname.endsWith(".pages.dev")) {
        location.replace("https://aoe2guide.com" + location.pathname + location.search + location.hash);
      }
    </script>
    {noindex && (
      <>
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="noindex, nofollow" />
      </>
    )}
    {!noindex && <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        optional: {
          description,
          locale,
          siteName: "AOE2 Guide",
        },
        image: {
          alt: "AOE2 Guide — Civilizations, Build Orders, Maps, Strategy",
          width: 1200,
          height: 630,
        },
      }}
      twitter={{ card: "summary_large_image" }}
    />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Preload the self-hosted critical faces (latin subset) for faster first paint. */}
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cinzel-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    {breadcrumbLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd).replace(/</g, "\\u003c")} />
    )}
    <slot name="head" />
    {!noindex && alternates.map(({ locale: l, path }) => (
      <link rel="alternate" hreflang={l} href={withSlash(`${site}${path}`)} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={withSlash(`${site}/en${canonicalPath}`)} />}
    <ClientRouter />
    <script is:inline>
      // Set theme before paint to avoid FOUC
      (() => {
        const stored = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const t = stored === "dark" || stored === "light" ? stored : sys;
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    {crumbs && (
      <nav aria-label="Breadcrumb" class="mx-auto w-full max-w-7xl px-4 pt-3">
        <ol class="flex flex-wrap items-center gap-1.5 font-mono text-[11px] uppercase tracking-wide text-stone-700/80">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <span aria-hidden="true">›</span>}
              {c.href ? (
                <a href={c.href} class="transition-colors hover:text-gold-500">{c.label}</a>
              ) : (
                <span class="text-ink/80">{c.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
