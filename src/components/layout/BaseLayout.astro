---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { localeMeta } from "@/i18n/locales";
import { getLocaleFromUrl, allLocalePaths } from "@/i18n/utils";

interface Props {
  title: string;
  description?: string;
  /** Path WITHOUT locale prefix, used for hreflang and lang switcher. e.g. "/civs/britons" */
  canonicalPath?: string;
}

const { title, description = "Age of Empires II — civilizations, build orders, maps and strategy guide.", canonicalPath = "/" } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const dir = localeMeta[locale].dir;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const alternates = allLocalePaths(canonicalPath);
const canonical = `${site}/${locale}${canonicalPath}`;
// Per-page Open Graph card from scripts/build-og.mjs (/og/<seg>/<slug>.png);
// non-detail pages fall back to the default card. Language-agnostic (English title).
const ogMatch = canonicalPath.match(/^\/(civs|builds|units|maps)\/([^/]+)\/?$/);
const ogImage = `${site}/og${ogMatch ? `/${ogMatch[1]}/${ogMatch[2]}` : "/default"}.png`;

// Append brand suffix unless the title already identifies the site.
const fullTitle = title.includes("AOE2") ? title : `${title} | AOE2 Guide`;

// JSON-LD structured data — WebSite schema for rich results.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AOE2 Guide",
  url: site,
  description,
  inLanguage: locale,
};

// BreadcrumbList — computed from canonicalPath; skipped on homepage.
const sectionLabels: Record<string, string> = {
  civs: "Civilizations", builds: "Build Orders", maps: "Maps",
  units: "Units", counters: "Counters", glossary: "Glossary",
  learn: "Learn", matchups: "Matchups", analyzer: "Analyzer",
};
const pathParts = canonicalPath.split("/").filter(Boolean);
const breadcrumbLd = pathParts.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "AOE2 Guide", item: `${site}/${locale}/` },
    ...(sectionLabels[pathParts[0]] ? [
      { "@type": "ListItem", position: 2, name: sectionLabels[pathParts[0]], item: `${site}/${locale}/${pathParts[0]}` },
    ] : []),
    ...(pathParts[1] ? [
      { "@type": "ListItem", position: 3, name: title, item: `${site}/${locale}${canonicalPath}` },
    ] : []),
  ],
} : null;
---
<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <script is:inline>
      // Cloudflare keeps the project's *.pages.dev hostnames permanently (the bare
      // alias AND every per-deploy hash subdomain). Bounce ALL of them to the
      // canonical domain so the live site is only ever served from aoe2guide.com.
      if (location.hostname.endsWith(".pages.dev")) {
        location.replace("https://aoe2guide.com" + location.pathname + location.search + location.hash);
      }
    </script>
    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        optional: {
          description,
          locale,
          siteName: "AOE2 Guide",
        },
        image: {
          alt: "AOE2 Guide — Civilizations, Build Orders, Maps, Strategy",
          width: 1200,
          height: 630,
        },
      }}
      twitter={{ card: "summary_large_image" }}
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Preload the self-hosted critical faces (latin subset) for faster first paint. */}
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/cinzel-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    {breadcrumbLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd).replace(/</g, "\\u003c")} />
    )}
    <slot name="head" />
    {alternates.map(({ locale: l, path }) => (
      <link rel="alternate" hreflang={l} href={`${site}${path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}/en${canonicalPath}`} />
    <ClientRouter />
    <script is:inline>
      // Set theme before paint to avoid FOUC
      (() => {
        const stored = localStorage.getItem("theme");
        const sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const t = stored === "dark" || stored === "light" ? stored : sys;
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
