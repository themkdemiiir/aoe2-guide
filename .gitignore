node_modules/
dist/
.astro/
# Generated build-time Open Graph cards (scripts/build-og.mjs) — regenerated each build.
public/og/
# Generated WebP variants of civ icons (scripts/optimize-images.mjs) — regenerated each build.
public/images/aoe2/Civs/*.webp
.env
.env.*
!.env.example
.DS_Store
.cache/
.pagefind/
test-results/
playwright-report/

# Self-collected World's Edge crawl output (NDJSON, large) — regenerated by
# scripts/data-pipeline/collect-relic.mjs on the box; merged into civ-meta.json.
data-cache/

# Vendored aoe2rec Rust replay parser (clone-on-build, never committed) and the
# Rust replay pipeline's compiled artifacts. See scripts/data-pipeline/replay-rs.
scripts/data-pipeline/replay-rs/vendor/
scripts/data-pipeline/replay-rs/target/
# Design tool exports (Claude Design zips) — working reference, not source.
*.zip

# Hera's strategy guide + video transcripts — local working reference only.
# His copyrighted/paid content; never commit or redistribute. We synthesize
# only the factual build data (timings, counters, openings) into our own prose.
guide-sources/reference/hera-*
# Defensive: ignore any Hera-named file dropped ANYWHERE in the repo (e.g. a PDF
# saved to the project root) so it can never be committed by accident.
hera-*
*hera-strategy-guide*

# WASM analyzer wrapper build artifacts (built via pnpm build:wasm; pkg output IS committed under public/analyzer/pkg).
scripts/data-pipeline/replay-wasm/target/
scripts/data-pipeline/replay-wasm/Cargo.lock
