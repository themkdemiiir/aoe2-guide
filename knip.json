{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "astro": true,
  "entry": ["src/pages/**/*.astro", "scripts/**/*.mjs"],
  "project": ["src/**/*.{ts,tsx,astro,mjs}", "scripts/**/*.mjs"],
  "ignore": [
    "src/components/ui/Dialog.astro",
    "src/components/ui/Separator.astro",
    "src/components/ui/Skeleton.astro",
    "src/components/ui/Tabs.astro",
    "src/components/ui/Tooltip.astro",
    "src/scripts/html.ts",
    "src/wasm/pkg/**"
  ],
  "ignoreDependencies": [
    "@iconify-json/lucide",
    "@iconify-json/heroicons",
    "@fontsource/cinzel",
    "@fontsource/inter",
    "@fontsource/jetbrains-mono",
    "@tailwindcss/typography",
    "pagefind",
    "tailwindcss"
  ],
  "ignoreBinaries": ["wasm-pack"],
  "ignoreExportsUsedInFile": true
}
